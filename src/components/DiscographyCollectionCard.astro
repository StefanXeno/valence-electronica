---
import type { DiscographyBlock } from '../lib/catalog-tracks';
import type { UiChrome } from '../lib/stage';
import { coverOrPlaceholder } from '../lib/url';
import DiscographyTrackRow from './DiscographyTrackRow.astro';
import HudIcon from './HudIcon.astro';

interface Props {
  chrome: UiChrome;
  block: Extract<DiscographyBlock, { type: 'collection' }>;
  defaultArtist: string;
  dateFmt: Intl.DateTimeFormat;
  year: number;
}

const { chrome, block, defaultArtist, dateFmt, year } = Astro.props;
const collectionId = `discog-collection-${year}-${block.label}`
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-');
const coverSrc = coverOrPlaceholder(block.coverUrl);
---

<article
  class="discog__collection-card"
  data-discog-collection
  aria-labelledby={collectionId}
>
  <div class="discog__collection-head">
    <div class="discog__collection-cover" aria-hidden={block.coverUrl ? undefined : 'true'}>
      <img
        class="discog__collection-cover-img"
        src={coverSrc}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="discog__head-text">
      <span class="discog__head-text__kind">{block.kindType}</span>
      <span class="discog__head-text__title" id={collectionId}>{block.collection}</span>
    </div>
    <div class="discog__play-slot">
      <button
        type="button"
        class="discog__play glitch-hit"
        data-discog-play
        aria-label={chrome.stageButtonLabel}
        data-hud-label={chrome.stageButtonLabel}
        data-hud-label-anchor="above"
      >
        <HudIcon token="play" />
      </button>
    </div>
  </div>
  <ul class="discog__collection-tracks">
    {
      block.entries.map((release) => (
        <DiscographyTrackRow
          chrome={chrome}
          release={release}
          artistName={release.artist ?? defaultArtist}
          typeDetail={block.kindType}
          dateFmt={dateFmt}
          variant="nested"
        />
      ))
    }
  </ul>
</article>

<style>
  .discog__collection-card {
    display: flex;
    flex-direction: column;
    gap: calc(0.55rem * var(--hud-scale));
    padding: calc(0.75rem * var(--hud-scale));
    border: 1px solid color-mix(in srgb, var(--color-border) 85%, transparent);
    border-radius: calc(0.6rem * var(--hud-scale));
    background: color-mix(in srgb, var(--color-bg) 22%, transparent);
    min-width: 0;
    transition:
      border-color 200ms ease,
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  .discog__collection-card.is-expanded {
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-text) 6%, transparent);
  }

  .discog__collection-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    column-gap: calc(0.75rem * var(--hud-scale));
    align-items: center;
  }

  .discog__collection-cover {
    --discog-cover-size: calc(5.5rem * var(--hud-scale));
    width: var(--discog-cover-size);
    height: var(--discog-cover-size);
    flex: 0 0 auto;
    border-radius: calc(0.4rem * var(--hud-scale));
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    background: color-mix(in srgb, var(--color-border) 22%, transparent);
    transition:
      width 280ms cubic-bezier(0.22, 1, 0.36, 1),
      height 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .discog__collection-card.is-expanded .discog__collection-cover {
    --discog-cover-size: calc(8rem * var(--hud-scale));
  }

  .discog__collection-cover-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .discog__head-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-self: center;
    gap: 0.12rem;
    min-width: 0;
  }

  .discog__head-text__kind,
  .discog__head-text__title {
    display: block;
    margin: 0;
    padding: 0;
  }

  .discog__head-text__kind {
    font-family: var(--font-display);
    font-size: calc(0.68rem * var(--hud-scale));
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .discog__head-text__title {
    font-family: var(--font-display);
    font-size: calc(1.05rem * var(--hud-scale));
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.05;
    color: var(--color-text);
  }

  .discog__collection-tracks {
    list-style: none;
    margin: 0;
    padding: calc(0.35rem * var(--hud-scale)) 0 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-border) 40%, transparent);
  }

  .discog__play-slot {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .discog__play {
    appearance: none;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    width: calc(2.35rem * var(--hud-scale));
    height: calc(2.35rem * var(--hud-scale));
    border-radius: 999px;
    display: grid;
    place-items: center;
    font: inherit;
    color: var(--color-text-muted);
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    background: transparent;
    cursor: pointer;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .discog__play:hover {
    color: var(--color-accent-alt);
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .discog__play :global(.hud-icon) {
    width: calc(1.1rem * var(--hud-scale));
    height: calc(1.1rem * var(--hud-scale));
    translate: 0.08em 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .discog__collection-cover {
      transition: none;
    }
  }
</style>
