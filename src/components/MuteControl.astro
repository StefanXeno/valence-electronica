---
interface Props {
  unmuteTooltip?: string;
  muteTooltip?: string;
  volumeSliderTooltip?: string;
  inJukebox?: boolean;
}

const {
  unmuteTooltip = 'Unmute',
  muteTooltip = 'Mute',
  volumeSliderTooltip = 'Drag to adjust volume',
  inJukebox = false,
} = Astro.props;
---

<div
  class:list={['volume-control', { 'volume-control--in-jukebox': inJukebox }]}
  data-volume-control
  data-sound="off"
  data-unmute-tooltip={unmuteTooltip}
  data-mute-tooltip={muteTooltip}
  hidden
>
  <button
    type="button"
    class="volume-control__toggle glitch-hit"
    data-mute-control
    data-glitch-live
    data-hud-label={unmuteTooltip}
    data-hud-label-anchor="above"
    aria-pressed="true"
    aria-label={unmuteTooltip}
  >
    <svg
      class="volume-control__icon volume-control__icon--muted"
      viewBox="0 0 24 24"
      width="33"
      height="33"
      aria-hidden="true"
      focusable="false"
    >
      <path
        fill="currentColor"
        d="M16.5 12a4.5 4.5 0 0 0-2.25-3.9v1.96l2.17 2.17c.05-.24.08-.48.08-.73Zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.8 8.8 0 0 0 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71ZM4.27 3 3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06a8.99 8.99 0 0 0 3.69-1.81L19.73 21 21 19.73 4.27 3ZM12 4 9.91 6.09 12 8.18V4Z"
      ></path>
    </svg>
    <svg
      class="volume-control__icon volume-control__icon--on"
      viewBox="0 0 24 24"
      width="33"
      height="33"
      aria-hidden="true"
      focusable="false"
    >
      <path
        fill="currentColor"
        d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 8.97v6.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
      ></path>
    </svg>
  </button>

  <label class="volume-control__slider-wrap" data-volume-wrap inert>
    <span class="visually-hidden">Volume</span>
    <input
      class="volume-control__slider"
      data-volume-slider
      data-hud-label={volumeSliderTooltip}
      data-hud-label-anchor="above"
      type="range"
      min="0"
      max="1"
      step="0.01"
      value="0.7"
      aria-label={volumeSliderTooltip}
    />
  </label>
</div>

<script>
  import { createContinuousGlitch, isGlitchThemeActive, playElementGlitch } from '../lib/glitch';

  function initMuteControl() {
    const root = document.querySelector<HTMLElement>('[data-atmosphere]');
    const control = document.querySelector<HTMLElement>('[data-volume-control]');
    const button = control?.querySelector<HTMLButtonElement>('[data-mute-control]');
    const sliderWrap = control?.querySelector<HTMLElement>('[data-volume-wrap]');
    const slider = control?.querySelector<HTMLInputElement>('[data-volume-slider]');
    if (!root || !control || !button || !sliderWrap || !slider) return;

    const getVideo = () => root.querySelector<HTMLVideoElement>('[data-bg-video]');

    const unmuteTooltip = control.dataset.unmuteTooltip ?? 'Unmute';
    const muteTooltip = control.dataset.muteTooltip ?? 'Mute';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let lastVolume = Number(slider.value) || 0.7;
    let wasMuted = true;
    let glitchTimer: number | undefined;
    let pointerOverMute = false;

    const videoAtInit = getVideo();
    if (videoAtInit) videoAtInit.volume = lastVolume;

    const isAudioPlaying = () => {
      const video = getVideo();
      return Boolean(video && !(video.muted || video.volume === 0));
    };

    // In-jukebox hover glitch is owned by Jukebox.astro (all toolbar buttons).
    const hoverGlitch = createContinuousGlitch(
      button,
      () =>
        pointerOverMute &&
        !control.hidden &&
        !control.classList.contains('volume-control--in-jukebox') &&
        !isAudioPlaying() &&
        !control.classList.contains('is-glitching'),
    );

    const playGlitch = (direction: 'in' | 'out') => {
      if (reduceMotion.matches || !isGlitchThemeActive()) return;
      // Morph supersedes continuous mute hover for this click
      hoverGlitch.stop();
      control.dataset.glitch = direction;
      window.clearTimeout(glitchTimer);
      const dur = playElementGlitch(control, 'is-glitching');
      glitchTimer = window.setTimeout(() => {
        control.classList.remove('is-glitching');
        delete control.dataset.glitch;
        hoverGlitch.start();
      }, dur + 80);
    };

    const muteSlot = control.closest<HTMLElement>('[data-jukebox-mute-slot]');

    const setMuteSlotVisible = (visible: boolean) => {
      control.hidden = !visible;
      if (muteSlot) muteSlot.hidden = !visible;
    };

    const applySoundUi = (muted: boolean) => {
      control.dataset.sound = muted ? 'off' : 'on';
      button.setAttribute('aria-pressed', muted ? 'true' : 'false');
      const label = muted ? unmuteTooltip : muteTooltip;
      button.setAttribute('aria-label', label);
      button.dataset.hudLabel = label;
      sliderWrap.toggleAttribute('inert', muted);
      const video = getVideo();
      if (!muted && video) slider.value = String(video.volume);
    };

    const sync = () => {
      const video = getVideo();
      if (!video) return;

      const fallback = root.getAttribute('data-bg-state') === 'fallback' || reduceMotion.matches;
      const hasAudio = root.getAttribute('data-has-audio') === 'true';
      if (fallback) {
        setMuteSlotVisible(false);
        hoverGlitch.stop();
        applySoundUi(true);
        wasMuted = true;
        return;
      }
      if (!hasAudio) {
        setMuteSlotVisible(false);
        hoverGlitch.stop();
        applySoundUi(true);
        wasMuted = true;
        return;
      }
      setMuteSlotVisible(true);

      control.hidden = false;

      const muted = video.muted || video.volume === 0;
      const turningOn = wasMuted && !muted;
      const turningOff = !wasMuted && muted;

      // Audio playing → no continuous mute hover
      if (!muted) hoverGlitch.stop();

      if (
        turningOff &&
        !reduceMotion.matches &&
        isGlitchThemeActive() &&
        !control.classList.contains('volume-control--in-jukebox')
      ) {
        // Keep pill visible briefly so the slider can glitch-collapse, then go circular
        applySoundUi(false);
        playGlitch('out');
        window.clearTimeout(glitchTimer);
        glitchTimer = window.setTimeout(() => {
          applySoundUi(true);
          control.classList.remove('is-glitching');
          delete control.dataset.glitch;
          hoverGlitch.start();
        }, 480);
      } else {
        // Non-glitch themes (e.g. Taking Over) collapse immediately via CSS ease
        applySoundUi(muted);
        if (turningOn && !control.classList.contains('volume-control--in-jukebox')) playGlitch('in');
      }

      wasMuted = muted;
    };

    button.addEventListener('pointerenter', () => {
      pointerOverMute = true;
      if (!control.classList.contains('volume-control--in-jukebox')) hoverGlitch.start();
    });

    button.addEventListener('pointerleave', () => {
      pointerOverMute = false;
      if (!control.classList.contains('volume-control--in-jukebox')) hoverGlitch.stop();
    });

    button.addEventListener('click', (event) => {
      event.stopPropagation();
      const video = getVideo();
      if (!video) return;

      if (video.muted || video.volume === 0) {
        video.muted = false;
        video.volume = lastVolume > 0 ? lastVolume : 0.7;
        slider.value = String(video.volume);
      } else {
        lastVolume = video.volume > 0 ? video.volume : lastVolume;
        video.muted = true;
      }
      sync();
    });

    slider.addEventListener('input', () => {
      const video = getVideo();
      if (!video) return;

      const next = Number(slider.value);
      video.volume = next;
      video.muted = next === 0;
      if (next > 0) lastVolume = next;
      sync();
    });

    root.addEventListener('bg-state-change', sync);
    reduceMotion.addEventListener('change', () => {
      if (reduceMotion.matches) hoverGlitch.stop();
      sync();
    });
    sync();
  }

  initMuteControl();
</script>

<style>
  .volume-control {
    --volume-slider-size: min(calc(8.5rem * var(--hud-scale)), 28vw);

    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--control-size);
    height: var(--control-size);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    box-sizing: border-box;
  }

  .volume-control--in-jukebox {
    --volume-slider-size: var(--jukebox-volume-slider-size, min(calc(5.5rem * var(--hud-scale)), 24vw));

    border: 0;
    background: transparent;
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    max-width: none;
    flex: none;
    overflow: visible;
    gap: 0;
    padding: 0;
  }

  .volume-control--in-jukebox[data-sound='off'],
  .volume-control--in-jukebox[data-sound='on'] {
    width: 100%;
    height: 100%;
    min-width: 0;
    max-width: none;
    padding: 0;
    gap: 0;
    flex: none;
  }

  .volume-control--in-jukebox .volume-control__toggle {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    width: var(--control-size);
    height: var(--control-size);
    flex: none;
  }

  .volume-control--in-jukebox .volume-control__slider-wrap {
    position: absolute;
    left: calc(var(--control-size) + var(--jukebox-toolbar-gap, calc(0.2rem * var(--hud-scale))));
    top: 50%;
    right: auto;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    flex: none;
    min-width: 0;
    margin: 0;
    transform-origin: left center;
    overflow: visible;
    box-sizing: content-box;
  }

  .volume-control--in-jukebox[data-sound='on'] .volume-control__slider-wrap {
    width: var(--volume-slider-size);
    max-width: var(--volume-slider-size);
    padding-right: var(--jukebox-slider-thumb-inset, calc(0.35rem * var(--hud-scale)));
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .volume-control--in-jukebox[data-sound='off'] .volume-control__slider-wrap {
    width: 0;
    max-width: 0;
    padding-right: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .volume-control--in-jukebox .volume-control__slider {
    width: var(--volume-slider-size);
    min-width: 0;
    max-width: var(--volume-slider-size);
    margin: 0;
  }

  html:not([data-hud-glitch='true']) .volume-control--in-jukebox .volume-control__slider-wrap {
    transition:
      width 280ms cubic-bezier(0.4, 0, 0.2, 1),
      max-width 280ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 220ms cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s linear 280ms;
  }

  /* Nightmare: stepped shell so the glitch morph owns the shape change */
  html[data-hud-glitch='true'] .volume-control {
    transition:
      padding 160ms steps(2, end),
      gap 160ms steps(2, end);
  }

  /* Default / Taking Over / other packs: same ease as jukebox + stage panels */
  html:not([data-hud-glitch='true']) .volume-control {
    transition:
      padding 280ms cubic-bezier(0.4, 0, 0.2, 1),
      gap 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  html:not([data-hud-glitch='true']) .volume-control__slider-wrap {
    transition:
      width 280ms cubic-bezier(0.4, 0, 0.2, 1),
      max-width 280ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 220ms cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s linear 280ms;
  }

  html[data-hud-glitch='true'] .volume-control.is-glitching .volume-control__slider-wrap {
    transition: none;
  }

  /* Muted: min-width + collapsed slider keep a circle (width:auto tracks the wrap) */
  .volume-control[data-sound='off'] {
    padding: 0;
    gap: 0;
  }

  /* Unmuted: pill with slider */
  .volume-control[data-sound='on'] {
    padding: 0 0.75rem 0 0.35rem;
    gap: 0.55rem;
  }

  .volume-control[hidden] {
    display: none;
  }

  .volume-control__toggle {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    width: calc(2.4rem * var(--hud-scale));
    height: calc(2.4rem * var(--hud-scale));
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .volume-control__toggle:hover {
    color: var(--color-accent-alt);
  }

  .volume-control__icon {
    grid-area: 1 / 1;
    display: block;
  }

  .volume-control__icon--on {
    display: none;
  }

  .volume-control[data-sound='on'] .volume-control__icon--muted {
    display: none;
  }

  .volume-control[data-sound='on'] .volume-control__icon--on {
    display: block;
  }

  .volume-control__slider-wrap {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    width: 0;
    max-width: 0;
    min-width: 0;
    opacity: 0;
    overflow: hidden;
    visibility: hidden;
    pointer-events: none;
    transform-origin: left center;
  }

  .volume-control[data-sound='on'] .volume-control__slider-wrap {
    width: var(--volume-slider-size);
    max-width: var(--volume-slider-size);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .volume-control__slider {
    width: var(--volume-slider-size);
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  .volume-control.is-glitching:not(.volume-control--in-jukebox) {
    animation: volume-shell-glitch var(--g-dur) both;
  }

  .volume-control.is-glitching:not(.volume-control--in-jukebox) .volume-control__toggle {
    animation: volume-icon-glitch var(--g-dur) both;
  }

  .volume-control.is-glitching:not(.volume-control--in-jukebox)[data-glitch='in'] .volume-control__slider-wrap {
    animation: volume-slider-glitch-in var(--g-dur) both;
  }

  .volume-control.is-glitching:not(.volume-control--in-jukebox)[data-glitch='in'] .volume-control__slider {
    animation: volume-slider-track-glitch var(--g-dur) both;
  }

  .volume-control.is-glitching:not(.volume-control--in-jukebox)[data-glitch='out'] .volume-control__slider-wrap {
    animation: volume-slider-glitch-out 520ms both;
  }

  .volume-control.is-glitching:not(.volume-control--in-jukebox)[data-glitch='out'] .volume-control__slider {
    animation: volume-slider-track-glitch 520ms both;
  }

  /* No clip-path on shell/icon — keeps the mute button clickable mid-glitch */
  @keyframes volume-shell-glitch {
    0% {
      transform: none;
      filter: none;
      border-color: var(--color-border);
      animation-timing-function: steps(1, end);
    }
    14% {
      transform: translateX(calc(var(--g-xa) * 1px)) skewX(calc(var(--g-sa) * 0.9deg))
        scaleX(var(--g-scale));
      filter: drop-shadow(calc(var(--g-xa) * -0.4px) 0 var(--glitch-red)) contrast(1.25);
      border-color: var(--glitch-white);
      animation-timing-function: steps(1, end);
    }
    28% {
      transform: translateY(calc(var(--g-ya) * 1px)) skewY(calc(var(--g-sb) * 0.45deg));
      filter: drop-shadow(0 calc(var(--g-ya) * -0.4px) var(--glitch-white)) brightness(1.1);
      border-color: var(--glitch-red);
      animation-timing-function: steps(1, end);
    }
    42% {
      transform: translateX(calc(var(--g-xb) * 1px)) skewX(calc(var(--g-sa) * -0.8deg));
      filter: drop-shadow(calc(var(--g-xb) * -0.4px) 0 var(--glitch-red));
      animation-timing-function: steps(1, end);
    }
    56% {
      transform: translateY(calc(var(--g-yb) * 1px));
      filter: drop-shadow(0 calc(var(--g-yb) * -0.35px) var(--glitch-white));
      animation-timing-function: steps(1, end);
    }
    72% {
      transform: translateX(calc(var(--g-xc) * 0.6px)) skewX(calc(var(--g-sc) * 0.55deg));
      filter: drop-shadow(calc(var(--g-xc) * -0.3px) 0 var(--glitch-red));
      animation-timing-function: steps(1, end);
    }
    86% {
      transform: translateY(calc(var(--g-yc) * 0.5px));
      filter: drop-shadow(0 calc(var(--g-yc) * -0.25px) var(--glitch-white));
      animation-timing-function: steps(1, end);
    }
    100% {
      transform: none;
      filter: none;
      border-color: var(--color-border);
    }
  }

  @keyframes volume-icon-glitch {
    0% {
      transform: none;
      filter: none;
      animation-timing-function: steps(1, end);
    }
    14% {
      transform: translateX(calc(var(--g-xa) * 0.8px)) skewX(calc(var(--g-sa) * 0.9deg))
        scaleX(var(--g-scale));
      filter: drop-shadow(calc(var(--g-xa) * -0.35px) 0 var(--glitch-red));
      animation-timing-function: steps(1, end);
    }
    28% {
      transform: translateY(calc(var(--g-ya) * 0.8px));
      filter: drop-shadow(0 calc(var(--g-ya) * -0.35px) var(--glitch-white));
      animation-timing-function: steps(1, end);
    }
    42% {
      transform: translateX(calc(var(--g-xb) * 0.75px)) skewX(calc(var(--g-sa) * -0.75deg));
      filter: drop-shadow(calc(var(--g-xb) * -0.35px) 0 var(--glitch-red));
      animation-timing-function: steps(1, end);
    }
    56% {
      transform: translateY(calc(var(--g-yb) * 0.7px));
      filter: drop-shadow(0 calc(var(--g-yb) * -0.3px) var(--glitch-white));
      animation-timing-function: steps(1, end);
    }
    72% {
      transform: translateX(calc(var(--g-xc) * 0.45px));
      filter: drop-shadow(calc(var(--g-xc) * -0.25px) 0 var(--glitch-red));
      animation-timing-function: steps(1, end);
    }
    86% {
      transform: translateY(calc(var(--g-yc) * 0.35px));
      filter: drop-shadow(0 calc(var(--g-yc) * -0.2px) var(--glitch-white));
      animation-timing-function: steps(1, end);
    }
    100% {
      transform: none;
      filter: none;
    }
  }

  @keyframes volume-slider-glitch-in {
    0% {
      width: 0;
      max-width: 0;
      opacity: 0;
      transform: translateX(calc(var(--g-xb) * 1px));
      clip-path: inset(0 100% 0 0);
      filter: none;
      animation-timing-function: steps(1, end);
    }
    18% {
      width: var(--volume-slider-size);
      max-width: var(--volume-slider-size);
      opacity: 1;
      transform: translateX(calc(var(--g-xa) * 1px)) skewX(calc(var(--g-sa) * 1deg));
      clip-path: polygon(
        0 0,
        100% 0,
        100% 20%,
        0 22%,
        0 42%,
        100% 40%,
        100% 62%,
        0 64%,
        0 100%,
        100% 100%
      );
      filter: drop-shadow(calc(var(--g-xa) * -0.35px) 0 var(--glitch-red));
      animation-timing-function: steps(1, end);
    }
    36% {
      transform: translateY(calc(var(--g-ya) * 0.8px));
      filter: drop-shadow(0 calc(var(--g-ya) * -0.35px) var(--glitch-white));
      animation-timing-function: steps(1, end);
    }
    54% {
      transform: translateX(calc(var(--g-xb) * 0.8px));
      clip-path: inset(0 10% 0 0);
      filter: drop-shadow(calc(var(--g-xb) * -0.3px) 0 var(--glitch-red));
      animation-timing-function: steps(1, end);
    }
    72% {
      transform: translateY(calc(var(--g-yb) * 0.45px));
      clip-path: inset(0);
      filter: drop-shadow(0 calc(var(--g-yb) * -0.25px) var(--glitch-white));
      animation-timing-function: steps(1, end);
    }
    100% {
      width: var(--volume-slider-size);
      max-width: var(--volume-slider-size);
      opacity: 1;
      transform: none;
      clip-path: inset(0);
      filter: none;
    }
  }

  @keyframes volume-slider-glitch-out {
    0% {
      width: var(--volume-slider-size);
      max-width: var(--volume-slider-size);
      opacity: 1;
      transform: none;
      clip-path: inset(0);
      filter: none;
      animation-timing-function: steps(1, end);
    }
    20% {
      transform: translateX(calc(var(--g-xa) * 0.85px));
      clip-path: polygon(0 0, 100% 0, 100% 30%, 0 32%, 0 58%, 100% 56%, 100% 100%, 0 100%);
      filter: drop-shadow(calc(var(--g-xa) * -0.35px) 0 var(--glitch-red));
      animation-timing-function: steps(1, end);
    }
    40% {
      transform: translateY(calc(var(--g-ya) * 0.7px));
      clip-path: inset(0 0 0 38%);
      filter: drop-shadow(0 calc(var(--g-ya) * -0.3px) var(--glitch-white));
      animation-timing-function: steps(1, end);
    }
    65% {
      width: 1.25rem;
      max-width: 1.25rem;
      opacity: 0.5;
      transform: translateX(calc(var(--g-xb) * 0.9px));
      clip-path: inset(0 0 0 72%);
      filter: drop-shadow(calc(var(--g-xb) * -0.3px) 0 var(--glitch-red));
      animation-timing-function: steps(1, end);
    }
    100% {
      width: 0;
      max-width: 0;
      opacity: 0;
      transform: translateY(calc(var(--g-yb) * 0.6px));
      clip-path: inset(0 0 0 100%);
      filter: none;
    }
  }

  @keyframes volume-slider-track-glitch {
    0% {
      transform: none;
      filter: none;
      animation-timing-function: steps(1, end);
    }
    25% {
      transform: scaleX(1.12) translateX(calc(var(--g-xa) * 0.5px));
      filter: drop-shadow(calc(var(--g-xa) * -0.3px) 0 var(--glitch-red));
      animation-timing-function: steps(1, end);
    }
    50% {
