---
import site from '../data/site.json';
import {
  getCollectionListenLinks,
  getMergedDiscography,
  groupDiscographyByYear,
} from '../lib/catalog-tracks';
import { getValidJukeboxEntries } from '../lib/background';
import type { UiChrome } from '../lib/stage';
import DiscographyCollectionCard from './DiscographyCollectionCard.astro';
import DiscographyTrackRow from './DiscographyTrackRow.astro';

interface Props {
  chrome: UiChrome;
}

const { chrome } = Astro.props;
const videos = await getValidJukeboxEntries();
const validIds = new Set(videos.map((entry) => entry.id));
const releases = await getMergedDiscography(validIds);
const yearGroups = groupDiscographyByYear(releases, await getCollectionListenLinks());
const defaultArtist = site.artist.name;
const dateFmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

{
  releases.length === 0 ? (
    <p class="discog__empty">{chrome.emptyReleases}</p>
  ) : (
    <div class="discog discog--catalog" data-discog-catalog>
      {yearGroups.map(({ year, blocks }) => (
        <section class="discog__year" aria-labelledby={`discog-year-${year}`}>
          <h3 class="discog__year-label" id={`discog-year-${year}`}>
            {year}
          </h3>
          <div class="discog__year-body">
            {blocks.map((block) => {
              if (block.type === 'collection') {
                return (
                  <DiscographyCollectionCard
                    chrome={chrome}
                    block={block}
                    defaultArtist={defaultArtist}
                    dateFmt={dateFmt}
                    year={year}
                  />
                );
              }

              const release = block.entry;
              return (
                <ul class="discog__list discog__list--lone">
                  <DiscographyTrackRow
                    chrome={chrome}
                    release={release}
                    artistName={release.artist ?? defaultArtist}
                    kindLabel={release.kindType ?? release.kind}
                    typeDetail={release.kind}
                    dateFmt={dateFmt}
                  />
                </ul>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  )
}

<script>
  const DURATION = 460;
  const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';
  /** Rows mid-animation: a second click waits for the first to finish. */
  const busy = new WeakSet<HTMLElement>();

  const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function parts(item: HTMLElement) {
    return {
      toggle: item.querySelector<HTMLButtonElement>('.discog__toggle'),
      details: item.querySelector<HTMLElement>('.discog__details'),
      home: item.querySelector<HTMLElement>('[data-discog-listen-home]'),
      dock: item.querySelector<HTMLElement>('[data-discog-listen-dock]'),
      slot: item.querySelector<HTMLElement>('[data-discog-listen-dock-slot]'),
      links: item.querySelector<HTMLElement>('[data-discog-listen-links]'),
      label: item.querySelector<HTMLElement>('[data-discog-listen-dock-slot] .discog__listen-label'),
    };
  }

  function syncCollection(item: HTMLElement) {
    const collection = item.closest<HTMLElement>('[data-discog-collection]');
    if (!collection) return;
    const anyOpen = Boolean(collection.querySelector('.discog__item.is-expanded'));
    collection.classList.toggle('is-expanded', anyOpen);
  }

  /** Height 0 ↔ natural, so the box grows or shrinks smoothly. */
  function slide(el: HTMLElement | null, from: number, to: number, opacity?: [number, number]) {
    if (!el) return undefined;
    const frames: Keyframe[] = [
      { height: `${from}px`, ...(opacity ? { opacity: opacity[0] } : {}) },
      { height: `${to}px`, ...(opacity ? { opacity: opacity[1] } : {}) },
    ];
    return el.animate(frames, { duration: DURATION, easing: EASE });
  }

  /** FLIP: play the links from where they were to where they are now. */
  function travel(links: HTMLElement, before: DOMRect) {
    const after = links.getBoundingClientRect();
    const dx = before.left - after.left;
    const dy = before.top - after.top;
    if (!dx && !dy) return undefined;
    return links.animate(
      [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }],
      { duration: DURATION, easing: EASE },
    );
  }

  function setExpanded(item: HTMLElement, open: boolean) {
    const { toggle, details, home, dock, slot, links, label } = parts(item);
    if (!toggle || !details || busy.has(item)) return;
    const animate = !reducedMotion();
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');

    if (open) {
      const before = links?.getBoundingClientRect();
      const homeHeight = home?.offsetHeight ?? 0;
      item.classList.add('is-expanded');
      details.hidden = false;
      if (dock) dock.hidden = false;
      if (links && slot) slot.append(links);
      syncCollection(item);
      if (!animate) return;

      busy.add(item);
      const runs = [
        slide(details, 0, details.offsetHeight, [0, 1]),
        slide(dock, 0, dock?.offsetHeight ?? 0),
        // Cards: the emptied home under the title folds away instead of jumping.
        home && home.closest('.discog__head') ? slide(home, homeHeight, 0) : undefined,
        label?.animate([{ opacity: 0 }, { opacity: 0.75 }], { duration: DURATION, easing: EASE }),
        links && before ? travel(links, before) : undefined,
      ];
      if (home && home.closest('.discog__head')) home.style.display = 'flow-root';
      Promise.all(runs.map((run) => run?.finished)).finally(() => {
        if (home) home.style.display = '';
        busy.delete(item);
      });
      return;
    }

    const before = links?.getBoundingClientRect();
    const detailsHeight = details.offsetHeight;
    const dockHeight = dock?.offsetHeight ?? 0;
    item.classList.remove('is-expanded');
    if (links && home) home.append(links);
    syncCollection(item);

    const finish = () => {
      details.hidden = true;
      if (dock) dock.hidden = true;
      busy.delete(item);
    };
    if (!animate) {
      finish();
      return;
    }

    busy.add(item);
    // Keep details and dock on screen while they fold back up.
    const runs = [
      slide(details, detailsHeight, 0, [1, 0]),
      slide(dock, dockHeight, 0),
      home && home.closest('.discog__head') ? slide(home, 0, home.offsetHeight) : undefined,
      label?.animate([{ opacity: 0.75 }, { opacity: 0 }], { duration: DURATION * 0.6, easing: EASE, fill: 'forwards' }),
      links && before ? travel(links, before) : undefined,
    ];
    Promise.all(runs.map((run) => run?.finished)).finally(() => {
      runs.forEach((run) => run?.cancel());
      finish();
    });
  }

  function initCatalog(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>('[data-discog-catalog]').forEach((catalog) => {
      if (catalog.dataset.discogReady === 'true') return;
      catalog.dataset.discogReady = 'true';

      catalog.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        // Links, stage play and the cover art (incl. its play badge) never toggle the card.
        if (target.closest('a, [data-stage-button], .discog__cover-slot, .discog__collection-cover-slot')) {
          return;
        }

        const item = target.closest<HTMLElement>('[data-discog-entry]');
        if (!item || !catalog.contains(item)) return;

        const open = item.classList.contains('is-expanded');
        setExpanded(item, !open);
      });
    });
  }

  initCatalog();
  document.addEventListener('astro:page-load', () => initCatalog());
</script>

<style>
  .discog {
    --discog-row-gap: calc(0.75rem * var(--hud-scale));
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--discog-row-gap);
  }

  .discog__empty {
    margin: 0;
    color: var(--color-text-muted);
    font-size: calc(0.8rem * var(--hud-scale));
  }

  /* —— Catalog (fullscreen discography): year groups + expandable rows —— */
  .discog--catalog {
    gap: calc(1.35rem * var(--hud-scale));
  }

  .discog__year-body {
    display: flex;
    flex-direction: column;
    gap: calc(1rem * var(--hud-scale));
  }

  .discog__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--discog-row-gap);
  }

  .discog__year-label {
    margin: 0 0 calc(0.55rem * var(--hud-scale));
    font-family: var(--font-display);
    font-size: calc(0.72rem * var(--hud-scale));
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .discog__year {
    font-size: calc(0.78rem * var(--hud-scale));
    color: var(--color-text-muted);
  }
</style>
