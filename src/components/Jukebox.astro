---
import { getBackgroundConfig } from '../lib/background';
import { getChrome } from '../lib/stage';
import { withBase } from '../lib/url';
import HudIcon from './HudIcon.astro';
import LyricsPanel from './LyricsPanel.astro';
import MuteControl from './MuteControl.astro';
import TrackInfoPanel from './TrackInfoPanel.astro';

const chrome = await getChrome();
const { videos, defaultVideoId, schedule } = await getBackgroundConfig();
const defaultEntry = videos.find((entry) => entry.id === defaultVideoId) ?? videos[0];
const catalog = videos.map((entry) => ({
  id: entry.id,
  label: entry.label,
  themeId: entry.themeId,
  hasAudio: entry.hasAudio,
  poster: withBase(entry.poster),
  sources: entry.sources.map((source) => ({ ...source, src: withBase(source.src) })),
}));
const showMute = videos.some((entry) => entry.hasAudio);
---

{
  videos.length > 0 && (
    <details
      class="jukebox"
      aria-label={chrome.jukeboxLabel}
      data-jukebox
      data-stage-catalog={JSON.stringify(catalog)}
      data-stage-schedule={JSON.stringify(schedule)}
      data-stage-fallback={defaultVideoId}
      data-stage-default={defaultVideoId}
      data-shuffle-default={chrome.shuffleDefault ? 'true' : 'false'}
      data-loop-default={chrome.loopDefault ? 'true' : 'false'}
    >
      <div class="jukebox__head">
        <summary
          class="jukebox__toggle glitch-hit"
          data-jukebox-toggle
          data-glitch-live
          data-hud-label={chrome.jukeboxLabel}
          data-hud-label-anchor="above"
          aria-label={chrome.jukeboxLabel}
        >
          <span class="jukebox__vinyl">
            <HudIcon token={chrome.jukeboxIcon} emoji={chrome.jukeboxIconEmoji} />
          </span>
        </summary>
        <span class="jukebox__title" data-now-playing-title>
          {defaultEntry?.label ?? chrome.jukeboxLabel}
        </span>
        {showMute && (
          <div class="jukebox__mute">
            <MuteControl
              unmuteTooltip={chrome.unmuteTooltip}
              muteTooltip={chrome.muteTooltip}
              volumeSliderTooltip={chrome.volumeSliderTooltip}
              inJukebox
            />
          </div>
        )}
      </div>

      <div class="jukebox__transport">
        <button
          type="button"
          class="jukebox__transport-btn glitch-hit"
          data-shuffle-toggle
          aria-pressed={chrome.shuffleDefault ? 'true' : 'false'}
          aria-label={chrome.shuffleLabel}
        >
          <HudIcon token={chrome.shuffleIcon} emoji={chrome.shuffleIconEmoji} />
          <span class="jukebox__transport-label">{chrome.shuffleLabel}</span>
        </button>
        <button
          type="button"
          class="jukebox__transport-btn glitch-hit"
          data-loop-toggle
          aria-pressed={chrome.loopDefault ? 'true' : 'false'}
          aria-label={chrome.loopLabel}
        >
          <HudIcon token={chrome.loopIcon} emoji={chrome.loopIconEmoji} />
          <span class="jukebox__transport-label">{chrome.loopLabel}</span>
        </button>
      </div>

      <div class="jukebox__panel">
        <section class="jukebox__section" aria-label={chrome.trackInfoTitle}>
          <h3 class="jukebox__section-title">{chrome.trackInfoTitle}</h3>
          <TrackInfoPanel chrome={chrome} />
        </section>
        <section class="jukebox__section" aria-label={chrome.lyricsTitle}>
          <h3 class="jukebox__section-title">{chrome.lyricsTitle}</h3>
          <LyricsPanel chrome={chrome} />
        </section>
        <div class="jukebox__list" role="group" aria-label={chrome.jukeboxLabel}>
          {videos.map((entry) => (
            <button
              type="button"
              class="glitch-hit"
              data-jukebox-option={entry.id}
              aria-pressed={entry.id === defaultVideoId ? 'true' : 'false'}
            >
              {entry.label}
            </button>
          ))}
        </div>
      </div>
    </details>
  )
}

<script>
  import { createContinuousGlitch, isGlitchThemeActive, playElementGlitch } from '../lib/glitch';
  import { panelCloseDelayMs, runSmoothPanelOpen, shouldSmoothPanelOpen } from '../lib/panel-motion';
  import { initStageSwitch, type StageCatalogEntry } from '../lib/stage-switch';
  import type { StageSchedule } from '../lib/stage-schedule';

  function bootStageSwitch() {
    const root = document.querySelector<HTMLDetailsElement>('[data-jukebox]');
    const toggle = root?.querySelector<HTMLElement>('[data-jukebox-toggle]');
    if (!root?.dataset.stageCatalog || !toggle) return;

    const catalog = JSON.parse(root.dataset.stageCatalog) as StageCatalogEntry[];
    const staticFallbackId = root.dataset.stageFallback ?? root.dataset.stageDefault ?? '';
    const schedule = root.dataset.stageSchedule
      ? (JSON.parse(root.dataset.stageSchedule) as StageSchedule)
      : { timezone: 'Europe/Berlin', rules: [] };
    initStageSwitch(catalog, staticFallbackId, schedule, {
      shuffleDefault: root.dataset.shuffleDefault !== 'false',
      loopDefault: root.dataset.loopDefault === 'true',
    });

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let morphTimer: number | undefined;
    let pointerOver = false;

    const hoverGlitch = createContinuousGlitch(
      toggle,
      () => pointerOver && !root.open && !root.classList.contains('is-glitching'),
    );

    const playMorph = (direction: 'in' | 'out') => {
      if (reduceMotion.matches || !isGlitchThemeActive()) return;
      hoverGlitch.stop();
      root.dataset.glitch = direction;
      window.clearTimeout(morphTimer);
      const dur = playElementGlitch(root, 'is-glitching');
      morphTimer = window.setTimeout(() => {
        root.classList.remove('is-glitching');
        delete root.dataset.glitch;
        hoverGlitch.start();
      }, dur + 80);
    };

    toggle.addEventListener('pointerenter', () => {
      pointerOver = true;
      hoverGlitch.start();
    });

    toggle.addEventListener('pointerleave', () => {
      pointerOver = false;
      hoverGlitch.stop();
    });

    toggle.addEventListener('click', (event) => {
      if (!root.open) {
        if (!shouldSmoothPanelOpen(reduceMotion.matches)) return;
        event.preventDefault();
        root.open = true;
        runSmoothPanelOpen(root, reduceMotion.matches);
        return;
      }

      event.preventDefault();
      if (root.classList.contains('is-glitching')) return;

      if (isGlitchThemeActive()) {
        playMorph('out');
      } else if (!reduceMotion.matches) {
        root.classList.add('is-panel-closing');
      }

      window.setTimeout(() => {
        root.open = false;
        root.classList.remove('is-panel-closing');
      }, panelCloseDelayMs(reduceMotion.matches));
    });

    root.addEventListener('toggle', () => {
      if (root.open) {
        hoverGlitch.stop();
        playMorph('in');
      }
    });
  }

  bootStageSwitch();
</script>

<style>
  .jukebox {
    position: relative;
    display: inline-flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    width: auto;
    max-width: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    text-shadow: 0 1px 12px var(--bg-scrim);
  }

  html[data-hud-glitch='true'] .jukebox {
    transition:
      width 160ms steps(2, end),
      border-radius 160ms steps(2, end);
  }

  html:not([data-hud-glitch='true']) .jukebox {
    transition:
      width 280ms cubic-bezier(0.4, 0, 0.2, 1),
      border-radius 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .jukebox__head {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    min-width: 0;
    flex: 0 1 auto;
  }

  .jukebox[open] {
    flex-direction: column;
    align-items: stretch;
    width: min(calc(22rem * var(--hud-scale)), calc(100vw - 2 * var(--hud-inset, 0.75rem)));
    max-width: min(calc(22rem * var(--hud-scale)), calc(100vw - 2 * var(--hud-inset, 0.75rem)));
    border-radius: calc(0.85rem * var(--hud-scale));
    overflow-x: clip;
  }

  .jukebox[open] .jukebox__head {
    width: 100%;
    padding: calc(0.35rem * var(--hud-scale));
    box-sizing: border-box;
    gap: calc(0.35rem * var(--hud-scale));
  }

  .jukebox__toggle {
    position: relative;
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    width: var(--control-size);
    height: var(--control-size);
    min-width: var(--control-size);
    min-height: var(--control-size);
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    list-style: none;
    box-sizing: border-box;
  }

  .jukebox__vinyl {
    flex: 0 0 var(--control-size);
    display: grid;
    place-items: center;
    width: var(--control-size);
    height: var(--control-size);
  }

  .jukebox__toggle::marker {
    content: '';
  }

  .jukebox__toggle::-webkit-details-marker {
    display: none;
  }

  .jukebox__toggle:hover {
    color: var(--color-accent-alt);
  }

  .jukebox__title {
    display: none;
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-display);
    font-size: calc(18px * var(--hud-scale));
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .jukebox[open] .jukebox__title {
    display: block;
  }

  .jukebox__mute {
    flex: 0 0 auto;
    min-width: 0;
  }

  .jukebox__transport {
    display: none;
    flex-direction: row;
    gap: calc(0.35rem * var(--hud-scale));
    padding: 0 calc(0.35rem * var(--hud-scale));
  }

  .jukebox[open] .jukebox__transport {
    display: flex;
  }

  .jukebox__transport-btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0.35em 0.55em;
    border: 1px solid transparent;
    border-radius: 0.35rem;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: calc(0.75rem * var(--hud-scale));
    cursor: pointer;
  }

  .jukebox__transport-btn:hover {
    border-color: var(--color-border);
    color: var(--color-accent-alt);
  }

  .jukebox__transport-btn[aria-pressed='true'] {
    border-color: var(--color-accent);
    color: var(--color-accent-alt);
  }

  .jukebox__transport-label {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .jukebox__panel {
    width: 0;
    max-width: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
  }

  html:not([data-hud-glitch='true']) .jukebox__panel {
    transition:
      max-height 280ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 220ms cubic-bezier(0.4, 0, 0.2, 1),
      width 280ms cubic-bezier(0.4, 0, 0.2, 1),
      max-width 280ms cubic-bezier(0.4, 0, 0.2, 1),
      padding 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .jukebox[open] .jukebox__panel {
    width: 100%;
    max-width: 100%;
    max-height: min(42svh, calc(18rem * var(--hud-scale)));
    min-width: 0;
    opacity: 1;
    overflow-x: hidden;
    overflow-y: auto;
    pointer-events: auto;
    padding: 0 calc(0.35rem * var(--hud-scale)) calc(0.35rem * var(--hud-scale));
    box-sizing: border-box;
  }

  .jukebox__section {
    margin-bottom: calc(0.65rem * var(--hud-scale));
  }

  .jukebox__section-title {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: calc(0.7rem * var(--hud-scale));
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent-alt);
  }

  .jukebox__list {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.25rem;
    min-width: 0;
    width: 100%;
    margin-top: calc(0.35rem * var(--hud-scale));
  }

  .jukebox__list button {
    appearance: none;
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    margin: 0;
    padding: 0.35em 0.55em;
    border: 1px solid transparent;
    border-radius: 0.35rem;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: calc(0.8rem * var(--hud-scale));
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    cursor: pointer;
  }

  .jukebox__list button:hover {
    border-color: var(--color-border);
  }

  .jukebox__list button[aria-pressed='true'] {
    border-color: var(--color-accent);
    color: var(--color-accent-alt);
  }

  html:not([data-hud-glitch='true']) .jukebox.is-panel-closing .jukebox__panel,
  html:not([data-hud-glitch='true']) .jukebox.is-panel-opening .jukebox__panel {
    width: 0;
    max-width: 0;
    max-height: 0;
    opacity: 0;
    padding: 0;
    pointer-events: none;
  }

  html[data-hud-glitch='true'] .jukebox.is-glitching .jukebox__panel {
    transition: none;
  }

  .jukebox.is-glitching[data-glitch='in'] .jukebox__panel {
    animation: jukebox-panel-in var(--g-dur, 560ms) both;
  }

  .jukebox.is-glitching[data-glitch='out'] .jukebox__panel {
    animation: jukebox-panel-out 520ms both;
  }

  @keyframes jukebox-panel-in {
    0% {
      width: 0;
      max-width: 0;
      max-height: 0;
      opacity: 0;
      animation-timing-function: steps(1, end);
    }
    35% {
      width: 100%;
      max-width: 100%;
      max-height: min(42svh, calc(18rem * var(--hud-scale)));
      opacity: 1;
      animation-timing-function: steps(1, end);
    }
    100% {
      width: 100%;
      max-width: 100%;
      max-height: min(42svh, calc(18rem * var(--hud-scale)));
      opacity: 1;
    }
  }

  @keyframes jukebox-panel-out {
    0% {
      width: 100%;
      max-width: 100%;
      max-height: min(42svh, calc(18rem * var(--hud-scale)));
      opacity: 1;
      animation-timing-function: steps(1, end);
    }
    55% {
      width: 2rem;
      max-width: 2rem;
      opacity: 0.4;
      animation-timing-function: steps(1, end);
    }
    100% {
      width: 0;
      max-width: 0;
      max-height: 0;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jukebox,
    .jukebox__panel,
    .jukebox__toggle {
      transition: none !important;
    }

    .jukebox.is-glitching,
    .jukebox.is-glitching .jukebox__panel {
      animation: none !important;
    }
  }
</style>
