---
import { getMergedDiscography, getThemeTrackDiscography } from '../lib/catalog-tracks';
import { getValidJukeboxEntries } from '../lib/background';
import type { UiChrome } from '../lib/stage';
import ChannelIcon from './ChannelIcon.astro';
import HudIcon from './HudIcon.astro';

interface Props {
  chrome: UiChrome;
  defaultId: string;
  /** Player playlist: stage/theme tracks only (includes hasAudio: false). */
  themeTracksOnly?: boolean;
}

const { chrome, defaultId, themeTracksOnly = false } = Astro.props;
const videos = await getValidJukeboxEntries();
const validIds = new Set(videos.map((entry) => entry.id));
const releases = themeTracksOnly
  ? await getThemeTrackDiscography(validIds)
  : await getMergedDiscography(validIds);
---

{
  releases.length === 0 ? (
    <p class="discog__empty">{chrome.emptyReleases}</p>
  ) : (
    <ul class="discog" data-theme-tracks={themeTracksOnly ? '' : undefined}>
      {releases.map((release) => {
        const onStage = Boolean(release.jukeboxId);
        const stageId = release.jukeboxId;
        const isActive = stageId === defaultId;
        return (
          <li
            class:list={['discog__item', { 'is-playlist-collapsed': themeTracksOnly && !isActive }]}
            data-discog-item={stageId}
            data-discog-active={isActive ? 'true' : undefined}
          >
            <div class="discog__main">
              <div class="discog__meta">
                <span class="discog__title">{release.title}</span>
                <span class="discog__year">
                  {release.year}
                  {release.kind ? ` · ${release.kind}` : ''}
                </span>
              </div>
              {release.listenLinks.length > 0 && (
                <div class="discog__listen">
                  <span class="discog__listen-label">{chrome.listenOnLabel}</span>
                  <ul class="discog__listen-links">
                    {release.listenLinks.map((link) => (
                      <li>
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={link.label}
                          data-hud-label={link.label}
                          data-hud-label-anchor="above"
                        >
                          <ChannelIcon id={link.platform} label={link.label} />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
            {onStage && stageId && (
              <div class="discog__stage-slot">
                <button
                  type="button"
                  class="discog__stage"
                  data-stage-button={stageId}
                  aria-pressed={isActive ? 'true' : 'false'}
                  aria-label={chrome.stageButtonLabel}
                  data-hud-label={chrome.stageButtonLabel}
                  data-hud-label-anchor="above"
                  hidden={isActive}
                >
                  <HudIcon token="play" />
                </button>
                <span
                  class="discog__now-playing"
                  data-discog-playing={stageId}
                  role="status"
                  aria-label={chrome.currentlyPlayingLabel}
                  hidden={!isActive}
                >
                  <span class="discog__eq" aria-hidden="true">
                    <span />
                    <span />
                    <span />
                    <span />
                    <span />
                  </span>
                </span>
              </div>
            )}
          </li>
        );
      })}
    </ul>
  )
}

<style>
  .discog {
    --discog-row-gap: calc(0.75rem * var(--hud-scale));
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--discog-row-gap);
  }

  .discog__empty {
    margin: 0;
    color: var(--color-text-muted);
    font-size: calc(0.8rem * var(--hud-scale));
  }

  /* Left: title / meta / divider / listen. Right: play (or playing) spanning the card. */
  .discog__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: stretch;
    column-gap: calc(0.7rem * var(--hud-scale));
    padding: calc(0.7rem * var(--hud-scale)) calc(0.75rem * var(--hud-scale));
    border: 1px solid color-mix(in srgb, var(--color-border) 85%, transparent);
    border-radius: calc(0.6rem * var(--hud-scale));
    background: color-mix(in srgb, var(--color-bg) 22%, transparent);
    min-width: 0;
    transition:
      border-color 200ms ease,
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  .discog__item[data-discog-active='true'] {
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-text) 6%, transparent);
  }

  .discog__main {
    display: flex;
    flex-direction: column;
    gap: calc(0.55rem * var(--hud-scale));
    min-width: 0;
  }

  .discog__meta {
    display: flex;
    flex-direction: column;
    gap: calc(0.2rem * var(--hud-scale));
    min-width: 0;
  }

  .discog__title {
    font-family: var(--font-display);
    font-size: calc(0.88rem * var(--hud-scale));
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.25;
    color: var(--color-text);
  }

  .discog__item[data-discog-active='true'] .discog__title {
    color: var(--color-accent-alt);
  }

  .discog__year {
    font-size: calc(0.78rem * var(--hud-scale));
    color: var(--color-text-muted);
  }

  .discog__stage-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    flex: 0 0 auto;
    min-width: 0;
  }

  .discog__stage,
  .discog__now-playing {
    appearance: none;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    width: calc(2.85rem * var(--hud-scale));
    height: calc(2.85rem * var(--hud-scale));
    border-radius: 999px;
    display: grid;
    place-items: center;
    font: inherit;
    color: var(--color-text);
  }

  .discog__stage {
    border: 1px solid var(--color-border);
    background: transparent;
    cursor: pointer;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .discog__stage:hover {
    color: var(--color-accent-alt);
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .discog__stage :global(.hud-icon) {
    width: calc(1.35rem * var(--hud-scale));
    height: calc(1.35rem * var(--hud-scale));
    /* Optical center for the play triangle */
    translate: 0.08em 0;
  }

  /* Pressed HUD-tool language: accent ring + wash (matches shuffle/loop). */
  .discog__now-playing {
    border: 1px solid var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 16%, transparent);
    color: var(--color-accent-alt);
  }

  .discog__stage[hidden],
  .discog__now-playing[hidden] {
    display: none;
  }

  /* Idle rest = diamond; playing = per-bar EQ (matches player-dock). Reduced-motion: static. */
  .discog__eq {
    /* Same integer tokens as .player-dock__soundwave — no rem/hud-scale rounding. */
    --eq-bar-width: 4px;
    --eq-bar-gap: 3px;
    --eq-paused-bar-height: 4px;
    --eq-flatten-duration: 280ms;
    --eq-flatten-easing: cubic-bezier(0.4, 0, 0.2, 1);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--eq-bar-gap);
    width: calc(5 * var(--eq-bar-width) + 4 * var(--eq-bar-gap));
    height: calc(1.35rem * var(--hud-scale));
    pointer-events: none;
  }

  .discog__eq span {
    display: block;
    box-sizing: border-box;
    flex: 0 0 var(--eq-bar-width);
    width: var(--eq-bar-width);
    min-width: var(--eq-bar-width);
    max-width: var(--eq-bar-width);
    height: calc(100% / 3);
    border-radius: 1px;
    background: currentColor;
    transform-origin: center center;
    animation: discog-eq-1 2.16s cubic-bezier(0.3, 0, 0.2, 1) infinite;
    transition:
      height var(--eq-flatten-duration) var(--eq-flatten-easing),
      min-height var(--eq-flatten-duration) var(--eq-flatten-easing),
      max-height var(--eq-flatten-duration) var(--eq-flatten-easing);
  }

  .discog__eq span:nth-child(2) {
    height: calc(200% / 3);
    animation-name: discog-eq-2;
    animation-duration: 1.64s;
    animation-delay: -0.72s;
  }

  .discog__eq span:nth-child(3) {
    height: 100%;
    animation-name: discog-eq-3;
    animation-duration: 1.32s;
    animation-delay: -0.28s;
  }

  .discog__eq span:nth-child(4) {
    height: calc(200% / 3);
    animation-name: discog-eq-4;
    animation-duration: 2.48s;
    animation-delay: -1.16s;
  }

  .discog__eq span:nth-child(5) {
    height: calc(100% / 3);
    animation-name: discog-eq-5;
    animation-duration: 1.88s;
    animation-delay: -0.48s;
  }

  /* Pause: freeze the dance only. Height → 4px comes from .is-eq-flat (JS bake). */
  :global(html[data-player-paused]) .discog__eq span:nth-child(n) {
    animation-play-state: paused;
    flex: 0 0 var(--eq-bar-width);
    width: var(--eq-bar-width);
    min-width: var(--eq-bar-width);
    max-width: var(--eq-bar-width);
  }

  /* After JS locks visual height, drop keyframes and ease to the flat line. */
  :global(html[data-player-paused]) .discog__eq.is-eq-flat span:nth-child(n) {
    animation: none;
    transform: none;
    height: var(--eq-paused-bar-height);
    min-height: var(--eq-paused-bar-height);
    max-height: var(--eq-paused-bar-height);
  }

  /* No-JS: still flatten (instant). JS path must not use this — it snaps. */
  :global(html:not([data-player-dock-js])[data-player-paused]) .discog__eq span:nth-child(n) {
    animation: none;
    transform: none;
    height: var(--eq-paused-bar-height);
    min-height: var(--eq-paused-bar-height);
    max-height: var(--eq-paused-bar-height);
  }

  @keyframes discog-eq-1 {
    0%,
    100% {
      transform: scaleY(0.35);
    }
    14% {
      transform: scaleY(2.55);
    }
    28% {
      transform: scaleY(0.4);
    }
    43% {
      transform: scaleY(1.7);
    }
    58% {
      transform: scaleY(0.55);
    }
    74% {
      transform: scaleY(2.9);
    }
    88% {
      transform: scaleY(0.22);
    }
  }

  @keyframes discog-eq-2 {
    0%,
    100% {
      transform: scaleY(0.2);
    }
    16% {
      transform: scaleY(1.32);
    }
    27% {
      transform: scaleY(0.48);
    }
    42% {
      transform: scaleY(0.82);
    }
    57% {
      transform: scaleY(1.45);
    }
    71% {
      transform: scaleY(0.28);
    }
    86% {
      transform: scaleY(1.12);
    }
  }

  @keyframes discog-eq-3 {
    0%,
    100% {
      transform: scaleY(0.16);
    }
    11% {
      transform: scaleY(0.92);
    }
    23% {
      transform: scaleY(0.28);
    }
    36% {
      transform: scaleY(1.06);
    }
    49% {
      transform: scaleY(0.18);
    }
    62% {
      transform: scaleY(0.68);
    }
    76% {
      transform: scaleY(1.02);
    }
    89% {
      transform: scaleY(0.34);
    }
  }

  @keyframes discog-eq-4 {
    0%,
    100% {
      transform: scaleY(0.88);
    }
    13% {
      transform: scaleY(0.22);
    }
    30% {
      transform: scaleY(1.42);
    }
    44% {
      transform: scaleY(0.52);
    }
    59% {
      transform: scaleY(1.18);
    }
    73% {
      transform: scaleY(0.16);
    }
    87% {
      transform: scaleY(1.36);
    }
  }

  @keyframes discog-eq-5 {
    0%,
    100% {
      transform: scaleY(1.55);
    }
    15% {
      transform: scaleY(0.28);
    }
    32% {
      transform: scaleY(2.35);
    }
    48% {
      transform: scaleY(0.65);
    }
    64% {
      transform: scaleY(0.2);
    }
    79% {
      transform: scaleY(2.85);
    }
    91% {
      transform: scaleY(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .discog__eq span {
      animation: none;
      transform: none;
      transition: none;
    }

    :global(html[data-player-paused]) .discog__eq span:nth-child(n) {
      height: var(--eq-paused-bar-height);
      min-height: var(--eq-paused-bar-height);
      max-height: var(--eq-paused-bar-height);
    }
  }

  /* Divider lives on the left column only — does not run under the play control. */
  .discog__listen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(0.45rem * var(--hud-scale));
    padding-top: calc(0.55rem * var(--hud-scale));
    border-top: 1px solid color-mix(in srgb, var(--color-border) 40%, transparent);
    min-width: 0;
  }

  .discog__listen-label {
    font-family: var(--font-display);
    font-size: calc(0.58rem * var(--hud-scale));
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent-alt);
    opacity: 0.75;
    flex: 0 0 auto;
  }

  .discog__listen-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: inline-flex;
    flex-flow: row wrap;
    align-items: center;
    gap: calc(0.35rem * var(--hud-scale));
  }

  .discog__listen-links li {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .discog__listen-links a {
    display: inline-grid;
    place-items: center;
    width: calc(2.35rem * var(--hud-scale));
    height: calc(2.35rem * var(--hud-scale));
    border: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
    border-radius: 999px;
    color: var(--color-text-muted);
    background: color-mix(in srgb, var(--color-bg) 30%, transparent);
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .discog__listen-links a:hover {
    color: var(--color-accent-alt);
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .discog__listen-links :global(.channel-icon) {
    width: calc(1.45rem * var(--hud-scale));
    height: calc(1.45rem * var(--hud-scale));
  }

  /*
   * Phone sheet (max-width: 1023px).
   * Thumb-sized listen marks + play slot; divider already lives on .discog__main only.
   */
  @media (max-width: 1023px) {
    .discog {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      /* Phone sheet: this list is the scrollport. Length cap — not height:100% of <details>. */
      max-height: min(50svh, calc(22rem * var(--hud-scale)), var(--phone-sheet-scroll-h, 45svh));
      min-height: 0;
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-y;
    }

    .discog__item {
      column-gap: 0.55rem;
    }

    /* Circular play / selected wave — vertically centered via .discog__stage-slot. */
    .discog__stage,
    .discog__now-playing {
      width: 3rem;
      height: 3rem;
      min-width: 3rem;
    }

    .discog__stage :global(.hud-icon) {
      width: 1.5rem;
      height: 1.5rem;
    }

    .discog__eq {
      height: 1.5rem;
    }

    .discog__stage[hidden],
    .discog__now-playing[hidden] {
      display: none;
    }

    .discog__listen-links a {
      width: 2.5rem;
      height: 2.5rem;
    }

    .discog__listen-links :global(.channel-icon) {
      width: 1.55rem;
      height: 1.55rem;
    }

    /* Player-owned theme playlist: parent section is the scrollport. */
    .discog[data-theme-tracks] {
      --discog-row-gap: calc(0.75rem * var(--hud-scale));
      gap: var(--discog-row-gap);
      max-height: none;
      overflow: visible;
    }

    .discog[data-theme-tracks] .discog__item {
      cursor: pointer;
    }

    /*
     * Solo player (playlist closed): collapse every non-playing row in THIS
     * component's scope. Jukebox-scoped selectors never match these items.
     * Playing row stays mounted — no display:none.
     */
    .discog[data-theme-tracks] .discog__item.is-playlist-collapsed,
    :global(.jukebox.is-player-expanded:not(.is-theme-tracks):not(.is-playlist-morphing))
      .discog[data-theme-tracks]
      .discog__item:not([data-discog-active='true']),
    :global(.jukebox.is-open:not(.is-theme-tracks):not(.is-playlist-morphing))
      .discog[data-theme-tracks]
      .discog__item:not([data-discog-active='true']) {
      box-sizing: border-box;
      height: 0;
      min-height: 0;
      max-height: 0;
      padding: 0;
      margin: 0;
      border: none;
      box-shadow: none;
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      clip-path: inset(100%);
    }

    .discog[data-theme-tracks] .discog__item.is-playlist-collapsed > *,
    :global(.jukebox.is-player-expanded:not(.is-theme-tracks):not(.is-playlist-morphing))
      .discog[data-theme-tracks]
      .discog__item:not([data-discog-active='true'])
      > *,
    :global(.jukebox.is-open:not(.is-theme-tracks):not(.is-playlist-morphing))
      .discog[data-theme-tracks]
      .discog__item:not([data-discog-active='true'])
      > * {
      min-height: 0;
      min-width: 0;
      overflow: hidden;
    }

    /* Playing card keeps its solo box while siblings add in / collapse. */
    :global(.jukebox.is-playlist-morphing)
      .discog[data-theme-tracks]
      .discog__item[data-discog-active='true'] {
      flex-shrink: 0;
    }

    /* Solo: drop the now-playing EQ / play circle — one card, no redundant badge. */
    .discog[data-theme-tracks] .discog__stage-slot {
      overflow: hidden;
      width: 3rem;
      max-width: 3rem;
      transition:
        width var(--phone-panel-morph-dur, 320ms) var(--phone-bloom-ease, cubic-bezier(0.4, 0, 0.2, 1)),
        max-width var(--phone-panel-morph-dur, 320ms) var(--phone-bloom-ease, cubic-bezier(0.4, 0, 0.2, 1)),
        opacity var(--phone-panel-morph-dur, 320ms) var(--phone-bloom-ease, cubic-bezier(0.4, 0, 0.2, 1));
    }

    .discog[data-theme-tracks] .discog__item[data-discog-active='true'] {
      transition:
        border-color 200ms ease,
        background-color 200ms ease,
        box-shadow 200ms ease,
        column-gap var(--phone-panel-morph-dur, 320ms)
          var(--phone-bloom-ease, cubic-bezier(0.4, 0, 0.2, 1));
    }

    :global(.jukebox:not(.is-theme-tracks))
      .discog[data-theme-tracks]
      .discog__item[data-discog-active='true'] {
      column-gap: 0;
    }

    :global(.jukebox:not(.is-theme-tracks))
      .discog[data-theme-tracks]
      .discog__item[data-discog-active='true']
      .discog__stage-slot {
      width: 0;
      max-width: 0;
      min-width: 0;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    :global(.jukebox:not(.is-theme-tracks))
      .discog[data-theme-tracks]
      .discog__item[data-discog-active='true']
      .discog__now-playing,
    :global(.jukebox:not(.is-theme-tracks))
      .discog[data-theme-tracks]
      .discog__item[data-discog-active='true']
      [data-discog-playing],
    :global(.jukebox:not(.is-theme-tracks))
      .discog[data-theme-tracks]
      .discog__item[data-discog-active='true']
      .discog__eq {
      opacity: 0;
      visibility: hidden;
      width: 0;
      height: 0;
      min-width: 0;
      min-height: 0;
      overflow: hidden;
      pointer-events: none;
    }
  }
</style>
