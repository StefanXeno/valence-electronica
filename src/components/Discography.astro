---
import site from '../data/site.json';
import { getMergedDiscography, groupDiscographyByYear } from '../lib/catalog-tracks';
import { getValidJukeboxEntries } from '../lib/background';
import type { UiChrome } from '../lib/stage';
import DiscographyCollectionCard from './DiscographyCollectionCard.astro';
import DiscographyTrackRow from './DiscographyTrackRow.astro';

interface Props {
  chrome: UiChrome;
}

const { chrome } = Astro.props;
const videos = await getValidJukeboxEntries();
const validIds = new Set(videos.map((entry) => entry.id));
const releases = await getMergedDiscography(validIds);
const yearGroups = groupDiscographyByYear(releases);
const defaultArtist = site.artist.name;
const dateFmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

{
  releases.length === 0 ? (
    <p class="discog__empty">{chrome.emptyReleases}</p>
  ) : (
    <div class="discog discog--catalog" data-discog-catalog>
      {yearGroups.map(({ year, blocks }) => (
        <section class="discog__year" aria-labelledby={`discog-year-${year}`}>
          <h3 class="discog__year-label" id={`discog-year-${year}`}>
            {year}
          </h3>
          <div class="discog__year-body">
            {blocks.map((block) => {
              if (block.type === 'collection') {
                return (
                  <DiscographyCollectionCard
                    chrome={chrome}
                    block={block}
                    defaultArtist={defaultArtist}
                    dateFmt={dateFmt}
                    year={year}
                  />
                );
              }

              const release = block.entry;
              return (
                <ul class="discog__list discog__list--lone">
                  <DiscographyTrackRow
                    chrome={chrome}
                    release={release}
                    artistName={release.artist ?? defaultArtist}
                    kindLabel={release.kindType ?? release.kind}
                    typeDetail={release.kind}
                    dateFmt={dateFmt}
                  />
                </ul>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  )
}

<script>
  function setExpanded(item: HTMLElement, open: boolean) {
    const toggle = item.querySelector<HTMLButtonElement>('.discog__toggle');
    const details = item.querySelector<HTMLElement>('.discog__details');
    if (!toggle || !details) return;
    item.classList.toggle('is-expanded', open);
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    details.hidden = !open;

    const collection = item.closest<HTMLElement>('[data-discog-collection]');
    if (collection) {
      const anyOpen = Boolean(collection.querySelector('.discog__item.is-expanded'));
      collection.classList.toggle('is-expanded', anyOpen);
    }
  }

  function initCatalog(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>('[data-discog-catalog]').forEach((catalog) => {
      if (catalog.dataset.discogReady === 'true') return;
      catalog.dataset.discogReady = 'true';

      catalog.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (target.closest('a, [data-stage-button]')) return;

        const item = target.closest<HTMLElement>('[data-discog-entry]');
        if (!item || !catalog.contains(item)) return;

        const open = item.classList.contains('is-expanded');
        setExpanded(item, !open);
      });
    });
  }

  initCatalog();
  document.addEventListener('astro:page-load', () => initCatalog());
</script>

<style>
  .discog {
    --discog-row-gap: calc(0.75rem * var(--hud-scale));
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--discog-row-gap);
  }

  .discog__empty {
    margin: 0;
    color: var(--color-text-muted);
    font-size: calc(0.8rem * var(--hud-scale));
  }

  /* —— Catalog (fullscreen discography): year groups + expandable rows —— */
  .discog--catalog {
    gap: calc(1.35rem * var(--hud-scale));
  }

  .discog__year-body {
    display: flex;
    flex-direction: column;
    gap: calc(1rem * var(--hud-scale));
  }

  .discog__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--discog-row-gap);
  }

  .discog__year-label {
    margin: 0 0 calc(0.55rem * var(--hud-scale));
    font-family: var(--font-display);
    font-size: calc(0.72rem * var(--hud-scale));
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .discog__year {
    font-size: calc(0.78rem * var(--hud-scale));
    color: var(--color-text-muted);
  }
</style>
