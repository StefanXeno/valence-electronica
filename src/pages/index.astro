---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Channels from '../components/Channels.astro';
import StagePlayer from '../components/StagePlayer.astro';
import SiteNav from '../components/SiteNav.astro';
import LandingIntro from '../components/LandingIntro.astro';
import { getChrome } from '../lib/stage';

const chrome = await getChrome();
---

<Base>
  <LandingIntro introLead={chrome.introLead} introName={chrome.introName} />
  <SiteNav chrome={chrome} />
  <div class="stage" id="stage">
    {/* Wordmark in SiteNav; rotating pool line sits under it (012). */}
    <div class="stage__identity">
      <Hero variant="tagline" />
    </div>
    <div class="stage__socials" id="stage-socials">
      <Channels />
    </div>
    <StagePlayer />
  </div>
</Base>
