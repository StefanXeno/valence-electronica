---
import AboutPanel from './AboutPanel.astro';
import ContactPanel from './ContactPanel.astro';
import Discography from './Discography.astro';
import ShopComingSoon from './ShopComingSoon.astro';
import TourDates from './TourDates.astro';
import HudIcon from './HudIcon.astro';
import { getBackgroundConfig } from '../lib/background';
import { getAboutEntry, getChrome, getSiteNavData } from '../lib/stage';

const [chrome, about, { defaultVideoId }] = await Promise.all([
  getChrome(),
  getAboutEntry(),
  getBackgroundConfig(),
]);
const { shopUrl, contact } = getSiteNavData();

const panels = [
  about && {
    title: chrome.aboutTitle,
    icon: chrome.aboutIcon,
    emoji: chrome.aboutIconEmoji,
    body: 'about' as const,
  },
  {
    title: chrome.discographyTitle,
    icon: chrome.discographyIcon,
    emoji: chrome.discographyIconEmoji,
    body: 'discography' as const,
  },
  {
    title: chrome.tourTitle,
    icon: chrome.tourIcon,
    emoji: chrome.tourIconEmoji,
    body: 'tour' as const,
  },
].filter((panel): panel is NonNullable<typeof panel> => Boolean(panel));
---

<div class="stage-panels stage-panels--nav-driven" data-stage-panels id="stage-nav-overlay">
  <div class="stage-panels__sheet">
    {
      panels.map((panel) => (
        <details
          class:list={[
            'stage-panel',
            panel.body === 'discography' && 'stage-panel--discography',
            panel.body === 'tour' && 'stage-panel--tour',
          ]}
          id={`stage-panel-${panel.body}`}
          data-stage-panel={panel.body}
        >
          <summary class="stage-panel__summary stage-panel__summary--sr-only">
            <span class="visually-hidden">{panel.title}</span>
          </summary>
          <div class="stage-panel__body">
            <header class="stage-panel__sheet-header">
              <button
                type="button"
                class="stage-panel__exit glitch-hit"
                data-stage-panel-exit
                aria-label="Exit"
                title="Exit"
              >
                <svg
                  class="stage-panel__exit-icon"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    d="M6 6l12 12M18 6L6 18"></path>
                </svg>
              </button>
              <h2 class="stage-panel__sheet-title">
                <HudIcon token={panel.icon} emoji={panel.emoji} />
                <span class="stage-panel__sheet-title-text">{panel.title}</span>
              </h2>
            </header>
            <div class="stage-panel__scroll">
              {panel.body === 'about' && <AboutPanel />}
              {panel.body === 'discography' && (
                <Discography chrome={chrome} defaultId={defaultVideoId} />
              )}
              {panel.body === 'tour' && <TourDates chrome={chrome} />}
            </div>
          </div>
        </details>
      ))
    }
    {
      !shopUrl && (
        <details class="stage-panel stage-panel--shop" id="stage-panel-shop" data-stage-panel="shop">
          <summary class="stage-panel__summary stage-panel__summary--sr-only">
            <span class="visually-hidden">{chrome.shopTitle}</span>
          </summary>
          <div class="stage-panel__body">
            <header class="stage-panel__sheet-header">
              <button
                type="button"
                class="stage-panel__exit glitch-hit"
                data-stage-panel-exit
                aria-label="Exit"
                title="Exit"
              >
                <svg
                  class="stage-panel__exit-icon"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    d="M6 6l12 12M18 6L6 18"></path>
                </svg>
              </button>
              <h2 class="stage-panel__sheet-title">
                <span class="stage-panel__sheet-title-text">{chrome.shopTitle}</span>
              </h2>
            </header>
            <div class="stage-panel__scroll">
              <ShopComingSoon chrome={chrome} />
            </div>
          </div>
        </details>
      )
    }
    <details
      class="stage-panel stage-panel--contact"
      id="stage-panel-contact"
      data-stage-panel="contact"
    >
      <summary class="stage-panel__summary stage-panel__summary--sr-only">
        <span class="visually-hidden">{chrome.contactTitle}</span>
      </summary>
      <div class="stage-panel__body">
        <header class="stage-panel__sheet-header">
          <button
            type="button"
            class="stage-panel__exit glitch-hit"
            data-stage-panel-exit
            aria-label="Exit"
            title="Exit"
          >
            <svg
              class="stage-panel__exit-icon"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              aria-hidden="true"
              focusable="false"
            >
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
          <h2 class="stage-panel__sheet-title">
            <span class="stage-panel__sheet-title-text">{chrome.contactTitle}</span>
          </h2>
        </header>
        <div class="stage-panel__scroll">
          <ContactPanel chrome={chrome} contact={contact} />
        </div>
      </div>
    </details>
  </div>
  <!-- Primary circular icon dock removed (020). Sheets open from SiteNav; Imprint/Privacy via LegalOverlay. -->
</div>

<script>
  import { clearTransitionGlitch, isGlitchThemeActive, playTransitionGlitch } from '../lib/glitch';
  import { SMOOTH_PANEL_PHASE_MS } from '../lib/panel-motion';
  import {
    closeOpenStageNavPanels,
    closeStageNavPanel,
    setStageNavPanelOpen,
  } from '../lib/stage-nav-overlay';

  function initExclusivePanels() {
    const cluster = document.querySelector('[data-stage-panels]');
    if (!cluster) return;

    cluster.addEventListener(
      'toggle',
      (event) => {
        const target = event.target;
        if (!(target instanceof HTMLDetailsElement) || !target.open) return;
        closeOpenStageNavPanels(target);
      },
      true,
    );
  }

  function initStagePanelOverlay(panel: HTMLDetailsElement) {
    const summary = panel.querySelector('summary');
    if (!summary) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let morphTimer: number | undefined;

    const playMorph = (direction: 'in' | 'out') => {
      if (reduceMotion.matches || !isGlitchThemeActive()) return;
      panel.dataset.glitch = direction;
      window.clearTimeout(morphTimer);
      const dur = playTransitionGlitch(panel, SMOOTH_PANEL_PHASE_MS * 2);
      morphTimer = window.setTimeout(() => {
        clearTransitionGlitch(panel);
      }, (dur || SMOOTH_PANEL_PHASE_MS * 2) + 80);
    };

    summary.addEventListener('click', (event) => {
      event.preventDefault();
      const next = !panel.open;
      if (isGlitchThemeActive() && !reduceMotion.matches) {
        playMorph(next ? 'in' : 'out');
      }
      if (next) {
        closeOpenStageNavPanels(panel);
        setStageNavPanelOpen(panel, true);
        const exit = panel.querySelector<HTMLElement>('[data-stage-panel-exit]');
        exit?.focus();
      } else {
        closeStageNavPanel(panel);
      }
    });

    panel.querySelectorAll<HTMLElement>('[data-stage-panel-exit]').forEach((exit) => {
      exit.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        if (isGlitchThemeActive() && !reduceMotion.matches) playMorph('out');
        closeStageNavPanel(panel);
      });
    });

    // Backdrop click (padding around the frame) — same dismiss path as Exit.
    panel.addEventListener('click', (event) => {
      if (event.target === panel && panel.open) {
        if (isGlitchThemeActive() && !reduceMotion.matches) playMorph('out');
        closeStageNavPanel(panel);
      }
    });
  }

  function initOverlayEscape() {
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      // Legal overlay owns Escape when it is open (Imprint/Privacy from SiteNav).
      const legalOpen = document.querySelector(
        '#legal-overlay [data-legal-panel]:not([hidden]), [data-legal-panel]:not([hidden])',
      );
      if (legalOpen) return;
      const open = document.querySelector<HTMLDetailsElement>(
        '[data-stage-panel][open]:not(.is-panel-closing)',
      );
      if (!open) return;
      event.preventDefault();
      closeStageNavPanel(open);
    });
  }

  function bootStagePanels() {
    const cluster = document.querySelector('[data-stage-panels]');
    cluster?.setAttribute('data-nav-overlay-js', '');
    initExclusivePanels();
    initOverlayEscape();
    document.querySelectorAll<HTMLDetailsElement>('[data-stage-panel]').forEach(initStagePanelOverlay);
  }

  bootStagePanels();
</script>

<style>
  .stage-panels {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: flex-end;
    gap: calc(0.35rem * var(--hud-scale));
  }

  /*
   * Body-level host (Base.astro). Stay out of document flow; open sheets are
   * position:fixed like .legal-panel (inset 0, z-index 5).
   */
  .stage-panels--nav-driven {
    position: fixed;
    inset: 0;
    z-index: 5;
    display: block;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    pointer-events: none;
    overflow: visible;
  }

  /* 020: no circular resting pills — sheets open from SiteNav only */
  .stage-panels--nav-driven .stage-panel__summary--sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /*
   * Nav content = LegalPanel presentation (fullscreen sheet), not a dock chip.
   * Mounted on <body> next to #legal-overlay so fixed + z-index:5 covers SiteNav
   * the same way Imprint does (page-shell is only z-index:1).
   */
  .stage-panels--nav-driven .stage-panel:not([open]) {
    display: none;
  }

  .stage-panels--nav-driven .stage-panel[open] {
    position: fixed;
    inset: 0;
    z-index: 5;
    display: grid;
    place-items: stretch;
    width: auto;
    max-width: none;
    margin: 0;
    padding: clamp(0.75rem, 3vw, 1.5rem);
    border: 0;
    border-radius: 0;
    background: transparent;
    backdrop-filter: none;
    overflow: visible;
    box-sizing: border-box;
    pointer-events: auto;
  }

  .stage-panels--nav-driven .stage-panel[open] .stage-panel__summary--sr-only {
    display: none;
  }

  .stage-panels--nav-driven .stage-panel[open] .stage-panel__body {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-height: 100%;
    height: 100%;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    opacity: 1;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 35%);
    box-sizing: border-box;
  }

  .stage-panels--nav-driven .stage-panel[open].is-overlay-in .stage-panel__body {
    animation: stage-panel-overlay-in 320ms ease-out both;
  }

  @keyframes stage-panel-overlay-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-panels--nav-driven .stage-panel[open].is-overlay-in .stage-panel__body {
      animation: none;
    }
  }

  .stage-panel__sheet-header {
    display: grid;
    gap: var(--space-s);
    flex: 0 0 auto;
    padding: var(--space-m) var(--space-m) var(--space-s);
    border-bottom: 1px solid var(--color-border);
  }

  .stage-panel__exit {
    justify-self: end;
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin: 0;
    padding: 0;
    color: var(--color-text);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    cursor: pointer;
  }

  .stage-panel__exit:hover,
  .stage-panel__exit:focus-visible {
    border-color: var(--color-accent);
    outline: none;
  }

  .stage-panel__exit-icon {
    display: block;
  }

  .stage-panels--nav-driven .stage-panel[open] .stage-panel__sheet-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.65rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 5vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  .stage-panels--nav-driven .stage-panel[open] .stage-panel__sheet-copy--sheet {
    margin-left: auto;
    font-family: var(--font-body);
    font-size: calc(0.72rem * var(--hud-scale));
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--color-text-muted);
  }

  .stage-panels--nav-driven .stage-panel[open] .stage-panel__scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    padding: var(--space-m);
    color: var(--color-text);
  }

  /*
   * Phone dock used to morph a content pill. Nav overlays are fixed LegalPanel
   * sheets — keep the dock collapsed and never clip the overlay.
   */
  @media (max-width: 1023px) {
    .stage-panels--nav-driven,
    .stage-panels--nav-driven:has([data-stage-panel][open]),
    .stage-panels--nav-driven.is-sheet-open,
    .stage-panels--nav-driven.is-sheet-closing,
    :global(html[data-sheet-open]) .stage-panels--nav-driven {
      height: 0 !important;
      min-height: 0 !important;
      padding: 0 !important;
      border: 0 !important;
      background: transparent !important;
      backdrop-filter: none !important;
      box-shadow: none !important;
      gap: 0 !important;
      overflow: visible !important;
      pointer-events: none !important;
    }

    .stage-panels--nav-driven .stage-panels__sheet,
    .stage-panels--nav-driven:has([data-stage-panel][open]) .stage-panels__sheet,
    .stage-panels--nav-driven.is-sheet-open .stage-panels__sheet {
      display: contents;
      height: auto !important;
      overflow: visible !important;
      visibility: visible !important;
      pointer-events: none;
    }

    .stage-panels--nav-driven .stage-panel[open] {
      pointer-events: auto;
      /* Beat later phone `.stage-panels__sheet .stage-panel[open] { position:static }`
         (equal specificity, source order) — that rule collapsed overlays into a
         height:0 dock so nav clicks looked like a no-op. */
      position: fixed !important;
      inset: 0 !important;
      z-index: 5 !important;
      display: grid !important;
      width: auto !important;
      max-width: none !important;
      overflow: visible !important;
      background: transparent !important;
      border: 0 !important;
      border-radius: 0 !important;
      backdrop-filter: none !important;
    }
  }

  /* Desktop: wrappers dissolve so details stay flex pills. Phone restyles both. */
  .stage-panels__sheet {
    display: contents;
  }

  .stage-panels__icons {
    display: none;
  }

  .stage-panel__icon {
    appearance: none;
    font: inherit;
    color: inherit;
  }

  .stage-panel {
    --stage-panel-inset: calc(0.65rem * var(--hud-scale));
    --stage-panel-body-open-h: min(30svh, calc(11rem * var(--hud-scale)));

    position: relative;
    overflow: visible;
    margin: 0;
    width: var(--control-size);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    backdrop-filter: blur(8px);
    box-sizing: border-box;
  }

  .stage-panel--socials {
    display: none;
  }

  /* Info rests hidden; open overlay rule paints it like About. */
  .stage-panel--info:not([open]) {
    display: none;
  }

  .stage-panel--socials .stage-panel__summary {
    appearance: none;
    border: 0;
    background: transparent;
    font: inherit;
    color: inherit;
  }

  html[data-hud-glitch='true'] .stage-panel {
    transition:
      width 160ms steps(2, end),
      border-radius 160ms steps(2, end);
  }

  html:not([data-hud-glitch='true']) .stage-panel {
    transition:
      width 280ms cubic-bezier(0.4, 0, 0.2, 1),
      border-radius 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  html:not([data-hud-glitch='true']) .stage-panel__summary {
    transition: padding 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  html:not([data-hud-glitch='true']) .stage-panel:not([open]) .stage-panel__summary {
    gap: 0;
  }

  html:not([data-hud-glitch='true']) .stage-panel__label {
    display: block;
    flex: 0 0 auto;
    width: 0;
    min-width: 0;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-width 280ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 220ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  html:not([data-hud-glitch='true']) .stage-panel[open] .stage-panel__label {
    flex: 1 1 auto;
    width: auto;
    max-width: 100%;
    opacity: 1;
  }

  html:not([data-hud-glitch='true']) .stage-panel__body {
    transition:
      max-height 280ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 220ms cubic-bezier(0.4, 0, 0.2, 1),
      padding 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Close: width + height reverse together while [open] is still true. */
  html:not([data-hud-glitch='true']) .stage-panel.is-panel-closing .stage-panel__body,
  html:not([data-hud-glitch='true']) .stage-panel[open].is-panel-closing .stage-panel__body {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
    padding-top: 0;
    padding-bottom: 0;
  }

  html[data-hud-glitch='true'] .stage-panel.is-glitching .stage-panel__body {
    transition: none;
  }

  .stage-panel[open] {
    border-radius: calc(0.85rem * var(--hud-scale));
    width: min(calc(18rem * var(--hud-scale)), calc(100vw - 2 * var(--hud-inset)));
    max-width: min(calc(18rem * var(--hud-scale)), calc(100vw - 2 * var(--hud-inset)));
  }

  .stage-panel--discography[open],
  .stage-panel--tour[open] {
    width: min(calc(22rem * var(--hud-scale)), calc(100vw - 2 * var(--hud-inset)));
    max-width: min(calc(22rem * var(--hud-scale)), calc(100vw - 2 * var(--hud-inset)));
  }

  /* Laptop only — phone pill stays full dock width while height reverses. */
  @media (min-width: 1024px) {
    /* Two full discog cards + a peek of the third (page gap 0.75rem). */
    .stage-panel--discography {
      --discog-panel-row-h: calc(7rem * var(--hud-scale));
      --discog-panel-gap: calc(0.75rem * var(--hud-scale));
      --discog-panel-viewport-h: calc(
        2.5 * var(--discog-panel-row-h) + 2 * var(--discog-panel-gap)
      );
      --stage-panel-body-open-h: min(50svh, var(--discog-panel-viewport-h));
    }

    .stage-panel--discography[open] .stage-panel__body {
      max-height: var(--stage-panel-body-open-h);
    }

    /* Two tour cards (title / date·place / pills) without clipping the footer. */
    .stage-panel--tour {
      --stage-panel-body-open-h: min(50svh, calc(16rem * var(--hud-scale)));
    }

    /* Sequential two-stage: width ([open]) first, height after is-two-stage-height.
       No-JS: omit [data-two-stage-js] so native [open] still paints the body. */
    .stage-panels[data-two-stage-js] .stage-panel[open]:not(.is-two-stage-height) .stage-panel__body {
      max-height: 0;
      opacity: 0;
      pointer-events: none;
      padding-top: 0;
      padding-bottom: 0;
    }

    .stage-panel--info[open] .stage-panel__summary {
      align-items: center;
    }

    .stage-panel--info[open] .stage-panel__sheet-copy--summary {
      display: block;
      margin-left: auto;
      flex: 0 0 auto;
      align-self: center;
      font-family: var(--font-body);
      font-size: calc(0.72rem * var(--hud-scale));
      font-weight: 400;
      line-height: 1;
      letter-spacing: 0.02em;
      text-transform: none;
      color: var(--color-text-muted);
      text-shadow: none;
      white-space: nowrap;
    }

    .stage-panel--info .stage-panel__sheet-copy--sheet {
      display: none;
    }

    html:not([data-hud-glitch='true']) .stage-panel[open].is-panel-closing,
    html:not([data-hud-glitch='true']) .stage-panel--discography[open].is-panel-closing {
      width: var(--control-size);
      max-width: var(--control-size);
      border-radius: 999px;
    }

    html:not([data-hud-glitch='true']) .stage-panel[open].is-panel-closing .stage-panel__summary {
      justify-content: center;
      width: var(--control-size);
      min-width: var(--control-size);
      height: var(--control-size);
      min-height: var(--control-size);
      padding: 0;
    }

    html:not([data-hud-glitch='true']) .stage-panel[open].is-panel-closing .stage-panel__label {
      flex: 0 0 auto;
      width: 0;
      max-width: 0;
      opacity: 0;
    }
  }

  .stage-panel__summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: calc(0.5rem * var(--hud-scale));
    width: var(--control-size);
    height: var(--control-size);
    min-width: var(--control-size);
    min-height: var(--control-size);
    cursor: pointer;
    padding: 0;
    margin: 0;
    color: var(--color-text);
    list-style: none;
    box-sizing: border-box;
    border-radius: inherit;
  }

  .stage-panel[open] .stage-panel__summary {
    justify-content: flex-start;
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: var(--control-size);
    padding: var(--stage-panel-inset);
    color: var(--color-accent-alt);
  }

  .stage-panel[open] .stage-panel__summary :global(.hud-icon) {
    filter: drop-shadow(
      0 0 calc(0.35rem * var(--hud-scale)) color-mix(in srgb, var(--color-accent) 55%, transparent)
    );
  }

  .stage-panel__summary::marker {
    content: '';
  }

  .stage-panel__summary::-webkit-details-marker {
    display: none;
  }

  .stage-panel__summary:hover {
    color: var(--color-accent-alt);
  }

  .stage-panel__label {
    font-family: var(--font-display);
    font-size: calc(18px * var(--hud-scale));
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: inherit;
    white-space: nowrap;
