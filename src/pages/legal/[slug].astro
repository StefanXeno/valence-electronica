---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Channels from '../../components/Channels.astro';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const entries = await getCollection('legal');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'legal'>;
}

const { entry } = Astro.props as Props;
---

<!--
  Same landing shell as `/`. LegalOverlay in Base opens the matching panel from the URL
  so deep links work; footer clicks on the home page use history + overlay (no reload).
-->
<Base title={`${entry.data.title} — ${site.artist.name}`}>
  <Hero />
  <Channels />
</Base>
