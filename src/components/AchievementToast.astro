---
/**
 * Shared one-shot achievement toast (036). Driven by `src/lib/achievement-toast.ts`.
 */
import { ACHIEVEMENT_GLYPHS, toClientPayload } from '../lib/achievements';
import { loadAchievementRegistry } from '../lib/achievements-registry';
import { getChrome } from '../lib/stage';
import AchievementGlyph from './AchievementGlyph.astro';

const chrome = await getChrome();
// Validated at build: a broken achievements.json fails `npm run build` here.
const achievementPayload = toClientPayload(loadAchievementRegistry());
---

{/* Shared one-shot achievement toast — driven by achievement-toast.ts. Ships without copy:
   text comes from the registry payload so secret titles never sit in the HTML (036). */}
<div
  class="ve-achievement"
  data-ve-achievement
  data-achievement-registry={achievementPayload}
  data-achievement-unlocked-label={chrome.achievementUnlockedLabel}
  hidden
>
  <button type="button" class="ve-achievement__card" data-ve-achievement-open>
    {ACHIEVEMENT_GLYPHS.map((glyph) => (
      <span class="ve-achievement__glyph" data-ve-achievement-glyph={glyph} hidden>
        <AchievementGlyph glyph={glyph} />
      </span>
    ))}
    <span class="ve-achievement__copy">
      <span class="ve-achievement__eyebrow">{chrome.achievementUnlockedLabel}</span>
      <span class="ve-achievement__title" data-ve-achievement-title></span>
      <span class="ve-achievement__sub" data-ve-achievement-sub></span>
    </span>
  </button>
  {/* Screen-reader announcement lives here, so the button content is not announced twice. */}
  <span
    class="ve-achievement__sr"
    role="status"
    aria-live="polite"
    aria-atomic="true"
    data-ve-achievement-announce
  ></span>
</div>

<style>
  /* Above SiteNav menu (z≈10) and overlays — top-center toast, never steals pointer events. */
  .ve-achievement {
    position: fixed;
    top: max(0.85rem, env(safe-area-inset-top, 0px));
    left: 50%;
    z-index: 50;
    width: min(26rem, calc(100vw - 1.7rem));
    margin: 0;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .ve-achievement[hidden] {
    display: none;
  }

  .ve-achievement__card {
    width: 100%;
    font: inherit;
    text-align: left;
    color: inherit;
    cursor: pointer;
    pointer-events: auto;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1.05rem 1.2rem 1.1rem 1.05rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 80%, var(--color-accent));
    border-radius: 0.6rem;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-accent) 14%, transparent) 0%,
        transparent 42%
      ),
      color-mix(in srgb, var(--color-surface) 94%, transparent);
    backdrop-filter: blur(10px);
    box-shadow:
      0 0.65rem 1.75rem rgb(0 0 0 / 42%),
      inset 0 1px 0 color-mix(in srgb, var(--color-accent-alt) 12%, transparent);
    /* Accent rail */
    border-left: 3px solid var(--color-accent);
    transform-origin: top center;
    opacity: 0;
    transform: translateY(-1.1rem) scale(0.94);
  }

  .ve-achievement__card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .ve-achievement.is-in .ve-achievement__card {
    animation: ve-achievement-in 520ms cubic-bezier(0.16, 0.84, 0.28, 1) both;
  }

  .ve-achievement.is-out .ve-achievement__card {
    animation: ve-achievement-out 380ms cubic-bezier(0.4, 0, 0.7, 0.2) both;
  }

  .ve-achievement__glyph {
    display: grid;
    place-items: center;
    width: 3.15rem;
    height: 3.15rem;
    color: var(--color-accent-alt);
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, var(--color-accent));
    border-radius: 0.45rem;
    background: color-mix(in srgb, var(--color-bg) 55%, transparent);
  }

  .ve-achievement__glyph[hidden] {
    display: none;
  }

  /* Fit the player vinyl / infinity mark inside the rounded glyph slot. */
  .ve-achievement__glyph :global(.hud-icon) {
    width: 1.9rem;
    height: 1.9rem;
  }

  .ve-achievement.is-in .ve-achievement__glyph {
    animation: ve-achievement-glyph 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .ve-achievement__copy {
    min-width: 0;
    display: grid;
    gap: 0.2rem;
  }

  .ve-achievement__eyebrow {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-alt);
  }

  .ve-achievement__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.8vw, 1.25rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text);
  }

  .ve-achievement__sub {
    margin: 0.15rem 0 0;
    font-size: 0.85rem;
    line-height: 1.35;
    color: var(--color-text-muted);
  }

  .ve-achievement__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes ve-achievement-in {
    0% {
      opacity: 0;
      transform: translateY(-1.1rem) scale(0.94);
    }
    58% {
      opacity: 1;
      transform: translateY(0.12rem) scale(1.02);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes ve-achievement-out {
    from {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    to {
      opacity: 0;
      transform: translateY(-0.65rem) scale(0.96);
    }
  }

  @keyframes ve-achievement-glyph {
    0% {
      transform: rotate(-28deg) scale(0.7);
      opacity: 0.35;
    }
    55% {
      transform: rotate(8deg) scale(1.08);
      opacity: 1;
    }
    100% {
      transform: rotate(0deg) scale(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ve-achievement.is-in .ve-achievement__card,
    .ve-achievement.is-out .ve-achievement__card,
    .ve-achievement.is-in .ve-achievement__glyph {
      animation: none;
    }

    .ve-achievement.is-in .ve-achievement__card {
      opacity: 1;
      transform: none;
    }
  }
</style>
