---
import {
  getMergedDiscography,
  getThemeTrackDiscography,
  groupDiscographyByYear,
} from '../lib/catalog-tracks';
import { getValidJukeboxEntries } from '../lib/background';
import type { UiChrome } from '../lib/stage';
import { withBase } from '../lib/url';
import ChannelIcon from './ChannelIcon.astro';
import HudIcon from './HudIcon.astro';

interface Props {
  chrome: UiChrome;
  defaultId: string;
  /** Player playlist: stage/theme tracks only (includes hasAudio: false). */
  themeTracksOnly?: boolean;
}

const { chrome, defaultId, themeTracksOnly = false } = Astro.props;
const videos = await getValidJukeboxEntries();
const validIds = new Set(videos.map((entry) => entry.id));
const releases = themeTracksOnly
  ? await getThemeTrackDiscography(validIds)
  : await getMergedDiscography(validIds);
const yearGroups = themeTracksOnly ? [] : groupDiscographyByYear(releases);
const dateFmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

{
  releases.length === 0 ? (
    <p class="discog__empty">{chrome.emptyReleases}</p>
  ) : themeTracksOnly ? (
    <ul class="discog" data-theme-tracks>
      {releases.map((release) => {
        const onStage = Boolean(release.jukeboxId);
        const stageId = release.jukeboxId;
        const isActive = stageId === defaultId;
        return (
          <li
            class:list={['discog__item', { 'is-playlist-collapsed': !isActive }]}
            data-discog-item={stageId}
            data-discog-active={isActive ? 'true' : undefined}
          >
            <div class="discog__main">
              <div class="discog__meta">
                <span class="discog__title">{release.title}</span>
                <span class="discog__year">
                  {release.year}
                  {release.kind ? ` · ${release.kind}` : ''}
                </span>
              </div>
              {release.listenLinks.length > 0 && (
                <div class="discog__listen">
                  <span class="discog__listen-label">{chrome.listenOnLabel}</span>
                  <ul class="discog__listen-links">
                    {release.listenLinks.map((link) => (
                      <li>
                        <a
                          class="glitch-hit"
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={link.label}
                          data-hud-label={link.label}
                          data-hud-label-anchor="above"
                        >
                          <ChannelIcon id={link.platform} label={link.label} />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
            {onStage && stageId && (
              <div class="discog__stage-slot">
                <button
                  type="button"
                  class="discog__stage glitch-hit"
                  data-stage-button={stageId}
                  aria-pressed={isActive ? 'true' : 'false'}
                  aria-label={chrome.stageButtonLabel}
                  data-hud-label={chrome.stageButtonLabel}
                  data-hud-label-anchor="above"
                  hidden={isActive}
                >
                  <HudIcon token="play" />
                </button>
                <span
                  class="discog__now-playing"
                  data-discog-playing={stageId}
                  role="status"
                  aria-label={chrome.currentlyPlayingLabel}
                  hidden={!isActive}
                >
                  <span class="discog__eq" aria-hidden="true">
                    <span />
                    <span />
                    <span />
                    <span />
                    <span />
                  </span>
                </span>
              </div>
            )}
          </li>
        );
      })}
    </ul>
  ) : (
    <div class="discog discog--catalog" data-discog-catalog>
      {yearGroups.map(({ year, entries }) => (
        <section class="discog__year" aria-labelledby={`discog-year-${year}`}>
          <h3 class="discog__year-label" id={`discog-year-${year}`}>
            {year}
          </h3>
          <ul class="discog__list">
            {entries.map((release) => {
              const detailsId = `discog-details-${release.id}`;
              const dateIso = release.sortDate.toISOString().slice(0, 10);
              const dateLabel = dateFmt.format(release.sortDate);
              const coverSrc = release.coverUrl ? withBase(release.coverUrl) : undefined;
              const primaryListen =
                release.listenLinks.find((link) => link.url === release.url) ??
                release.listenLinks[0];
              const coverListenHref = release.url;
              const coverListenLabel = primaryListen
                ? `${chrome.listenOnLabel} ${release.title} (${primaryListen.label})`
                : undefined;
              return (
                <li class="discog__item" data-discog-entry={release.id}>
                  <div class="discog__row">
                    <div
                      class="discog__cover"
                      aria-hidden={coverListenHref && coverSrc ? undefined : 'true'}
                    >
                      {coverSrc && coverListenHref && coverListenLabel ? (
                        <a
                          class="discog__cover-link glitch-hit"
                          href={coverListenHref}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={coverListenLabel}
                          data-hud-label={primaryListen?.label}
                          data-hud-label-anchor="above"
                        >
                          <img
                            class="discog__cover-img"
                            src={coverSrc}
                            alt=""
                            loading="lazy"
                            decoding="async"
                          />
                        </a>
                      ) : coverSrc ? (
                        <img
                          class="discog__cover-img"
                          src={coverSrc}
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <span class="discog__cover-placeholder" />
                      )}
                    </div>
                    <div class="discog__main">
                      <button
                        type="button"
                        class="discog__toggle"
                        aria-expanded="false"
                        aria-controls={detailsId}
                      >
                        <span class="discog__headline">
                          <span class="discog__title">{release.title}</span>
                          {release.kind && <span class="discog__kind">{release.kind}</span>}
                        </span>
                      </button>
                      {release.listenLinks.length > 0 && (
                        <div class="discog__listen discog__listen--summary">
                          <span class="discog__listen-label">{chrome.listenOnLabel}</span>
                          <ul class="discog__listen-links">
                            {release.listenLinks.map((link) => (
                              <li>
                                <a
                                  class="glitch-hit"
                                  href={link.url}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  aria-label={link.label}
                                  data-hud-label={link.label}
                                  data-hud-label-anchor="above"
                                >
                                  <ChannelIcon id={link.platform} label={link.label} />
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}
                      <div class="discog__details" id={detailsId} hidden>
                        <dl class="discog__facts">
                          <div class="discog__fact">
                            <dt>{chrome.releasedLabel}</dt>
                            <dd>
                              <time datetime={dateIso}>{dateLabel}</time>
                            </dd>
                          </div>
                          {release.kind && (
                            <div class="discog__fact">
                              <dt>Type</dt>
                              <dd>{release.kind}</dd>
                            </div>
                          )}
                        </dl>
                        {release.listenLinks.length > 0 && (
                          <div class="discog__listen">
                            <span class="discog__listen-label">{chrome.listenOnLabel}</span>
                            <ul class="discog__listen-links">
                              {release.listenLinks.map((link) => (
                                <li>
                                  <a
                                    class="glitch-hit"
                                    href={link.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={link.label}
                                    data-hud-label={link.label}
                                    data-hud-label-anchor="above"
                                  >
                                    <ChannelIcon id={link.platform} label={link.label} />
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}
                        {release.notes && <p class="discog__notes">{release.notes}</p>}
                      </div>
                    </div>
                    <div class="discog__play-slot">
                      <button
                        type="button"
                        class="discog__play glitch-hit"
                        data-discog-play
                        aria-label={chrome.stageButtonLabel}
                        data-hud-label={chrome.stageButtonLabel}
                        data-hud-label-anchor="above"
                      >
                        <HudIcon token="play" />
                      </button>
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  )
}
{
  themeTracksOnly ? (
    <template data-playlist-placeholder-template>
      <li class="discog__item" data-playlist-placeholder aria-hidden="true"></li>
    </template>
  ) : null
}

{
  !themeTracksOnly ? (
    <script>
      function setExpanded(item: HTMLElement, open: boolean) {
        const toggle = item.querySelector<HTMLButtonElement>('.discog__toggle');
        const details = item.querySelector<HTMLElement>('.discog__details');
        if (!toggle || !details) return;
        item.classList.toggle('is-expanded', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        details.hidden = !open;
      }

      function initCatalog(root: ParentNode = document) {
        root.querySelectorAll<HTMLElement>('[data-discog-catalog]').forEach((catalog) => {
          if (catalog.dataset.discogReady === 'true') return;
          catalog.dataset.discogReady = 'true';

          catalog.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            if (target.closest('a, [data-discog-play]')) return;

            const item = target.closest<HTMLElement>('[data-discog-entry]');
            if (!item || !catalog.contains(item)) return;

            const open = item.classList.contains('is-expanded');
            setExpanded(item, !open);
          });
        });
      }

      initCatalog();
      document.addEventListener('astro:page-load', () => initCatalog());
    </script>
  ) : null
}

<style>
  .discog {
    --discog-row-gap: calc(0.75rem * var(--hud-scale));
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--discog-row-gap);
  }

  .discog__empty {
    margin: 0;
    color: var(--color-text-muted);
    font-size: calc(0.8rem * var(--hud-scale));
  }

  /* —— Catalog (fullscreen discography): year groups + expandable rows —— */
  .discog--catalog {
    gap: calc(1.35rem * var(--hud-scale));
  }

  .discog__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--discog-row-gap);
  }

  .discog__year-label {
    margin: 0 0 calc(0.55rem * var(--hud-scale));
    font-family: var(--font-display);
    font-size: calc(0.72rem * var(--hud-scale));
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .discog--catalog .discog__item {
    display: block;
    padding: calc(0.7rem * var(--hud-scale)) calc(0.75rem * var(--hud-scale));
    border: 1px solid color-mix(in srgb, var(--color-border) 85%, transparent);
    border-radius: calc(0.6rem * var(--hud-scale));
    background: color-mix(in srgb, var(--color-bg) 22%, transparent);
    min-width: 0;
    cursor: pointer;
    transition:
      border-color 200ms ease,
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  .discog--catalog .discog__item.is-expanded {
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-text) 6%, transparent);
  }

  .discog__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    column-gap: calc(0.75rem * var(--hud-scale));
    align-items: start;
  }

  .discog__cover {
    --discog-cover-size: calc(3.1rem * var(--hud-scale));
    width: var(--discog-cover-size);
    height: var(--discog-cover-size);
    flex: 0 0 auto;
    border-radius: calc(0.35rem * var(--hud-scale));
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    background: color-mix(in srgb, var(--color-border) 22%, transparent);
    transition:
      width 280ms cubic-bezier(0.22, 1, 0.36, 1),
      height 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .discog--catalog .discog__item.is-expanded .discog__cover {
    --discog-cover-size: calc(5.5rem * var(--hud-scale));
  }

  .discog__cover-link {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .discog__cover-link:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 70%, transparent);
    outline-offset: 2px;
  }

  .discog__cover-link:hover .discog__cover-img,
  .discog__cover-link:focus-visible .discog__cover-img {
    filter: brightness(1.08);
  }

  .discog__cover-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .discog__cover-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-border) 35%, transparent) 0%,
        color-mix(in srgb, var(--color-border) 12%, transparent) 100%
      );
  }

  .discog--catalog .discog__main {
    display: flex;
    flex-direction: column;
    gap: calc(0.45rem * var(--hud-scale));
    min-width: 0;
  }

  .discog__toggle {
    appearance: none;
    display: block;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    min-width: 0;
  }

  .discog__toggle:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 70%, transparent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .discog__headline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35em 0.65em;
    min-width: 0;
  }

  .discog--catalog .discog__title {
    font-family: var(--font-display);
    font-size: calc(0.88rem * var(--hud-scale));
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.25;
    color: var(--color-text);
  }

  .discog__kind {
    font-size: calc(0.72rem * var(--hud-scale));
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .discog__details {
    display: flex;
    flex-direction: column;
    gap: calc(0.55rem * var(--hud-scale));
    padding-top: calc(0.35rem * var(--hud-scale));
  }

  .discog__details[hidden] {
    display: none;
  }

  .discog__facts {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: calc(0.3rem * var(--hud-scale));
  }

  .discog__fact {
    display: grid;
    grid-template-columns: minmax(4.5rem, auto) minmax(0, 1fr);
    column-gap: calc(0.65rem * var(--hud-scale));
    align-items: baseline;
    font-size: calc(0.78rem * var(--hud-scale));
  }

  .discog__fact dt {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.85em;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .discog__fact dd {
    margin: 0;
    color: var(--color-text);
  }

  .discog__notes {
    margin: 0;
    font-size: calc(0.78rem * var(--hud-scale));
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  /* Collapsed: listen under title. Expanded: listen lives in details only. */
  .discog--catalog .discog__item.is-expanded .discog__listen--summary {
    display: none;
  }

  .discog__play-slot {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: calc(0.15rem * var(--hud-scale));
  }

  .discog__play {
    appearance: none;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    width: calc(2.35rem * var(--hud-scale));
    height: calc(2.35rem * var(--hud-scale));
    border-radius: 999px;
    display: grid;
    place-items: center;
    font: inherit;
    color: var(--color-text-muted);
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    background: transparent;
    cursor: pointer;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .discog__play:hover {
    color: var(--color-accent-alt);
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .discog__play :global(.hud-icon) {
    width: calc(1.1rem * var(--hud-scale));
    height: calc(1.1rem * var(--hud-scale));
    translate: 0.08em 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .discog__cover {
      transition: none;
    }
  }

  /* Left: title / meta / divider / listen. Right: play (or playing) spanning the card. */
  .discog:not(.discog--catalog) .discog__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: stretch;
    column-gap: calc(0.7rem * var(--hud-scale));
    padding: calc(0.7rem * var(--hud-scale)) calc(0.75rem * var(--hud-scale));
    border: 1px solid color-mix(in srgb, var(--color-border) 85%, transparent);
    border-radius: calc(0.6rem * var(--hud-scale));
    background: color-mix(in srgb, var(--color-bg) 22%, transparent);
    min-width: 0;
    transition:
      border-color 200ms ease,
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  .discog:not(.discog--catalog) .discog__item[data-discog-active='true'] {
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-text) 6%, transparent);
  }

  .discog:not(.discog--catalog) .discog__main {
    display: flex;
    flex-direction: column;
    gap: calc(0.55rem * var(--hud-scale));
    min-width: 0;
  }

  .discog__meta {
    display: flex;
    flex-direction: column;
    gap: calc(0.2rem * var(--hud-scale));
    min-width: 0;
  }

  .discog:not(.discog--catalog) .discog__title {
    font-family: var(--font-display);
    font-size: calc(0.88rem * var(--hud-scale));
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.25;
    color: var(--color-text);
  }

  .discog:not(.discog--catalog) .discog__item[data-discog-active='true'] .discog__title {
    color: var(--color-accent-alt);
  }

  .discog__year {
    font-size: calc(0.78rem * var(--hud-scale));
    color: var(--color-text-muted);
  }

  .discog__stage-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    flex: 0 0 auto;
    min-width: 0;
  }

  .discog__stage,
  .discog__now-playing {
    appearance: none;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    width: calc(2.85rem * var(--hud-scale));
    height: calc(2.85rem * var(--hud-scale));
    border-radius: 999px;
    display: grid;
    place-items: center;
    font: inherit;
    color: var(--color-text);
  }

  .discog__stage {
    border: 1px solid var(--color-border);
    background: transparent;
    cursor: pointer;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .discog__stage:hover {
    color: var(--color-accent-alt);
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .discog__stage :global(.hud-icon) {
    width: calc(1.35rem * var(--hud-scale));
    height: calc(1.35rem * var(--hud-scale));
    /* Optical center for the play triangle */
    translate: 0.08em 0;
  }

  /* Pressed HUD-tool language: accent ring + wash (matches shuffle/loop). */
  .discog__now-playing {
    border: 1px solid var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 16%, transparent);
    color: var(--color-accent-alt);
  }

  .discog__stage[hidden],
  .discog__now-playing[hidden] {
    display: none;
  }

  /* Idle rest = diamond; playing = per-bar EQ (matches player-dock). Reduced-motion: static. */
  .discog__eq {
    /* Same integer tokens as .player-dock__soundwave — no rem/hud-scale rounding. */
    --eq-bar-width: 4px;
    --eq-bar-gap: 3px;
    --eq-paused-bar-height: 4px;
    --eq-flatten-duration: 280ms;
    --eq-flatten-easing: cubic-bezier(0.4, 0, 0.2, 1);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--eq-bar-gap);
    width: calc(5 * var(--eq-bar-width) + 4 * var(--eq-bar-gap));
    height: calc(1.35rem * var(--hud-scale));
    pointer-events: none;
  }

  .discog__eq span {
    display: block;
    box-sizing: border-box;
    flex: 0 0 var(--eq-bar-width);
    width: var(--eq-bar-width);
    min-width: var(--eq-bar-width);
    max-width: var(--eq-bar-width);
    height: calc(100% / 3);
    border-radius: 1px;
    background: currentColor;
    transform-origin: center center;
    animation: discog-eq-1 2.16s cubic-bezier(0.3, 0, 0.2, 1) infinite;
    transition:
      height var(--eq-flatten-duration) var(--eq-flatten-easing),
      min-height var(--eq-flatten-duration) var(--eq-flatten-easing),
      max-height var(--eq-flatten-duration) var(--eq-flatten-easing);
  }

  .discog__eq span:nth-child(2) {
    height: calc(200% / 3);
    animation-name: discog-eq-2;
    animation-duration: 1.64s;
    animation-delay: -0.72s;
  }

  .discog__eq span:nth-child(3) {
    height: 100%;
    animation-name: discog-eq-3;
    animation-duration: 1.32s;
    animation-delay: -0.28s;
  }

  .discog__eq span:nth-child(4) {
    height: calc(200% / 3);
    animation-name: discog-eq-4;
    animation-duration: 2.48s;
    animation-delay: -1.16s;
  }

  .discog__eq span:nth-child(5) {
    height: calc(100% / 3);
    animation-name: discog-eq-5;
    animation-duration: 1.88s;
    animation-delay: -0.48s;
  }

  /* Pause: freeze the dance only. Height → 4px comes from .is-eq-flat (JS bake). */
