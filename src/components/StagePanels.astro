---
import AboutPanel from './AboutPanel.astro';
import ContactPanel from './ContactPanel.astro';
import Discography from './Discography.astro';
import LegalSheet from './LegalSheet.astro';
import ShopComingSoon from './ShopComingSoon.astro';
import TourDates from './TourDates.astro';
import HudIcon from './HudIcon.astro';
import site from '../data/site.json';
import { getBackgroundConfig } from '../lib/background';
import { getAboutEntry, getChrome, getSiteNavData } from '../lib/stage';

const year = new Date().getFullYear();

const [chrome, about, { defaultVideoId }] = await Promise.all([
  getChrome(),
  getAboutEntry(),
  getBackgroundConfig(),
]);
const { shopUrl, contact } = getSiteNavData();

const panels = [
  about && {
    title: chrome.aboutTitle,
    icon: chrome.aboutIcon,
    emoji: chrome.aboutIconEmoji,
    body: 'about' as const,
  },
  {
    title: chrome.discographyTitle,
    icon: chrome.discographyIcon,
    emoji: chrome.discographyIconEmoji,
    body: 'discography' as const,
  },
  {
    title: chrome.tourTitle,
    icon: chrome.tourIcon,
    emoji: chrome.tourIconEmoji,
    body: 'tour' as const,
  },
].filter((panel): panel is NonNullable<typeof panel> => Boolean(panel));
---

<div class="stage-panels stage-panels--nav-driven" data-stage-panels>
  <div class="stage-panels__sheet">
    {
      panels.map((panel) => (
        <details
          class:list={[
            'stage-panel',
            panel.body === 'discography' && 'stage-panel--discography',
            panel.body === 'tour' && 'stage-panel--tour',
          ]}
          id={`stage-panel-${panel.body}`}
          data-stage-panel={panel.body}
        >
          <summary class="stage-panel__summary stage-panel__summary--sr-only">
            <span class="visually-hidden">{panel.title}</span>
          </summary>
          <div class="stage-panel__body">
            <h2 class="stage-panel__sheet-title">
              <HudIcon token={panel.icon} emoji={panel.emoji} />
              <span class="stage-panel__sheet-title-text">{panel.title}</span>
            </h2>
            <div class="stage-panel__scroll">
              {panel.body === 'about' && <AboutPanel />}
              {panel.body === 'discography' && (
                <Discography chrome={chrome} defaultId={defaultVideoId} />
              )}
              {panel.body === 'tour' && <TourDates chrome={chrome} />}
            </div>
          </div>
        </details>
      ))
    }
    {
      !shopUrl && (
        <details class="stage-panel stage-panel--shop" id="stage-panel-shop" data-stage-panel="shop">
          <summary class="stage-panel__summary stage-panel__summary--sr-only">
            <span class="visually-hidden">{chrome.shopTitle}</span>
          </summary>
          <div class="stage-panel__body">
            <h2 class="stage-panel__sheet-title">
              <span class="stage-panel__sheet-title-text">{chrome.shopTitle}</span>
            </h2>
            <div class="stage-panel__scroll">
              <ShopComingSoon chrome={chrome} />
            </div>
          </div>
        </details>
      )
    }
    <details
      class="stage-panel stage-panel--contact"
      id="stage-panel-contact"
      data-stage-panel="contact"
    >
      <summary class="stage-panel__summary stage-panel__summary--sr-only">
        <span class="visually-hidden">{chrome.contactTitle}</span>
      </summary>
      <div class="stage-panel__body">
        <h2 class="stage-panel__sheet-title">
          <span class="stage-panel__sheet-title-text">{chrome.contactTitle}</span>
        </h2>
        <div class="stage-panel__scroll">
          <ContactPanel chrome={chrome} contact={contact} />
        </div>
      </div>
    </details>
    <details class="stage-panel stage-panel--info" id="stage-panel-info" data-stage-panel="info">
      <summary class="stage-panel__summary stage-panel__summary--sr-only">
        <span class="visually-hidden">{chrome.infoTitle}</span>
      </summary>
      <div class="stage-panel__body">
        <h2 class="stage-panel__sheet-title">
          <HudIcon token={chrome.infoIcon} emoji={chrome.infoIconEmoji} />
          <span class="stage-panel__sheet-title-text">{chrome.infoTitle}</span>
          <span class="stage-panel__sheet-copy stage-panel__sheet-copy--sheet"
            >© {year} {site.artist.name}</span
          >
        </h2>
        <div class="stage-panel__scroll">
          <LegalSheet />
        </div>
      </div>
    </details>
  </div>
  <!-- Primary circular icon dock removed (020). Sheets open from SiteNav. -->
</div>

<script>
  import { clearTransitionGlitch, isGlitchThemeActive, playTransitionGlitch } from '../lib/glitch';
  import { createTwoStageMotion, SMOOTH_PANEL_PHASE_MS } from '../lib/panel-motion';
  import { isPhoneHud, requestPhoneContent, type PhoneContentSheet } from '../lib/player-dock';

  const desktopPanelMotion = new Map<HTMLDetailsElement, ReturnType<typeof createTwoStageMotion>>();

  function initExclusivePanels() {
    const cluster = document.querySelector('[data-stage-panels]');
    if (!cluster) return;

    cluster.addEventListener(
      'toggle',
      (event) => {
        // Phone: player-dock cross-switch keeps the outgoing [open] while fading.
        if (isPhoneHud()) return;
        const target = event.target;
        if (!(target instanceof HTMLDetailsElement) || !target.open) return;
        cluster.querySelectorAll('details[open]').forEach((node) => {
          if (!(node instanceof HTMLDetailsElement) || node === target) return;
          const motion = desktopPanelMotion.get(node);
          if (motion) motion.request(false);
          else node.open = false;
        });
      },
      true,
    );
  }

  function initStagePanelGlitch(panel: HTMLDetailsElement) {
    const summary = panel.querySelector('summary');
    if (!summary) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let morphTimer: number | undefined;

    const playMorph = (direction: 'in' | 'out') => {
      if (reduceMotion.matches || !isGlitchThemeActive()) return;
      panel.dataset.glitch = direction;
      window.clearTimeout(morphTimer);
      const dur = playTransitionGlitch(panel, SMOOTH_PANEL_PHASE_MS * 2);
      morphTimer = window.setTimeout(() => {
        clearTransitionGlitch(panel);
      }, (dur || SMOOTH_PANEL_PHASE_MS * 2) + 80);
    };

    const motion = createTwoStageMotion(panel, {
      reducedMotion: () => reduceMotion.matches,
      applySemanticOpen: (open) => {
        panel.open = open;
        if (!open) panel.classList.remove('is-panel-closing');
      },
    });
    desktopPanelMotion.set(panel, motion);

    summary.addEventListener('click', (event) => {
      // Phone: icon row drives open/close (native open + delayed close).
      if (isPhoneHud()) return;

      event.preventDefault();
      const next = !motion.getTarget();
      if (isGlitchThemeActive() && !reduceMotion.matches) {
        playMorph(next ? 'in' : 'out');
      }
      motion.request(next);
    });

    window.matchMedia('(max-width: 1023px)').addEventListener('change', (event) => {
      if (event.matches) motion.snap(false);
    });
  }

  function initPhoneIconTriggers() {
    const cluster = document.querySelector('[data-stage-panels]');
    const icons = cluster?.querySelector('[data-stage-panel-icons]');
    if (!cluster || !icons) return;

    const syncExpanded = () => {
      icons.querySelectorAll<HTMLButtonElement>('[data-stage-panel-trigger]').forEach((btn) => {
        const id = btn.dataset.stagePanelTrigger;
        const open = Boolean(
          id &&
            cluster.querySelector(
              `[data-stage-panel="${id}"][open]:not(.is-cross-out):not(.is-panel-closing)`,
            ),
        );
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    };

    icons.addEventListener('click', (event) => {
      const btn = event.target instanceof Element
        ? event.target.closest<HTMLButtonElement>('[data-stage-panel-trigger]')
        : null;
      if (!btn) return;
      const id = btn.dataset.stagePanelTrigger;
      if (id !== 'about' && id !== 'discography' && id !== 'tour' && id !== 'info') return;
      event.preventDefault();

      if (isPhoneHud()) {
        requestPhoneContent(id as PhoneContentSheet);
        return;
      }

      const panel = cluster.querySelector<HTMLDetailsElement>(`[data-stage-panel="${id}"]`);
      const summary = panel?.querySelector<HTMLElement>(':scope > summary');
      summary?.click();
    });

    cluster.addEventListener('toggle', syncExpanded, true);
    syncExpanded();
  }

  function bootStagePanels() {
    const cluster = document.querySelector('[data-stage-panels]');
    cluster?.setAttribute('data-two-stage-js', '');
    initExclusivePanels();
    initPhoneIconTriggers();
    document.querySelectorAll<HTMLDetailsElement>('[data-stage-panel]').forEach(initStagePanelGlitch);
  }

  bootStagePanels();
</script>

<style>
  .stage-panels {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: flex-end;
    gap: calc(0.35rem * var(--hud-scale));
  }

  /* 020: no circular resting pills — sheets open from SiteNav only */
  .stage-panels--nav-driven .stage-panel__summary--sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 1024px) {
    .stage-panels--nav-driven .stage-panel:not([open]) {
      display: none;
    }

    .stage-panels--nav-driven .stage-panel[open] {
      width: min(24rem, 38vw);
      border-radius: 0.85rem;
      overflow: hidden;
    }

    .stage-panels--nav-driven .stage-panel[open] .stage-panel__summary--sr-only {
      display: none;
    }
  }

  /* Desktop: wrappers dissolve so details stay flex pills. Phone restyles both. */
  .stage-panels__sheet {
    display: contents;
  }

  .stage-panels__icons {
    display: none;
  }

  .stage-panel__icon {
    appearance: none;
    font: inherit;
    color: inherit;
  }

  .stage-panel {
    --stage-panel-inset: calc(0.65rem * var(--hud-scale));
    --stage-panel-body-open-h: min(30svh, calc(11rem * var(--hud-scale)));

    position: relative;
    overflow: visible;
    margin: 0;
    width: var(--control-size);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    backdrop-filter: blur(8px);
    box-sizing: border-box;
  }

  .stage-panel--socials,
  .stage-panel--info {
    display: none;
  }

  @media (min-width: 1024px) {
    .stage-panel--info {
      display: block;
    }
  }

  .stage-panel--socials .stage-panel__summary {
    appearance: none;
    border: 0;
    background: transparent;
    font: inherit;
    color: inherit;
  }

  html[data-hud-glitch='true'] .stage-panel {
    transition:
      width 160ms steps(2, end),
      border-radius 160ms steps(2, end);
  }

  html:not([data-hud-glitch='true']) .stage-panel {
    transition:
      width 280ms cubic-bezier(0.4, 0, 0.2, 1),
      border-radius 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  html:not([data-hud-glitch='true']) .stage-panel__summary {
    transition: padding 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  html:not([data-hud-glitch='true']) .stage-panel:not([open]) .stage-panel__summary {
    gap: 0;
  }

  html:not([data-hud-glitch='true']) .stage-panel__label {
    display: block;
    flex: 0 0 auto;
    width: 0;
    min-width: 0;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-width 280ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 220ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  html:not([data-hud-glitch='true']) .stage-panel[open] .stage-panel__label {
    flex: 1 1 auto;
    width: auto;
    max-width: 100%;
    opacity: 1;
  }

  html:not([data-hud-glitch='true']) .stage-panel__body {
    transition:
      max-height 280ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 220ms cubic-bezier(0.4, 0, 0.2, 1),
      padding 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Close: width + height reverse together while [open] is still true. */
  html:not([data-hud-glitch='true']) .stage-panel.is-panel-closing .stage-panel__body,
  html:not([data-hud-glitch='true']) .stage-panel[open].is-panel-closing .stage-panel__body {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
    padding-top: 0;
    padding-bottom: 0;
  }

  html[data-hud-glitch='true'] .stage-panel.is-glitching .stage-panel__body {
    transition: none;
  }

  .stage-panel[open] {
    border-radius: calc(0.85rem * var(--hud-scale));
    width: min(calc(18rem * var(--hud-scale)), calc(100vw - 2 * var(--hud-inset)));
    max-width: min(calc(18rem * var(--hud-scale)), calc(100vw - 2 * var(--hud-inset)));
  }

  .stage-panel--discography[open],
  .stage-panel--tour[open] {
    width: min(calc(22rem * var(--hud-scale)), calc(100vw - 2 * var(--hud-inset)));
    max-width: min(calc(22rem * var(--hud-scale)), calc(100vw - 2 * var(--hud-inset)));
  }

  /* Laptop only — phone pill stays full dock width while height reverses. */
  @media (min-width: 1024px) {
    /* Two full discog cards + a peek of the third (page gap 0.75rem). */
    .stage-panel--discography {
      --discog-panel-row-h: calc(7rem * var(--hud-scale));
      --discog-panel-gap: calc(0.75rem * var(--hud-scale));
      --discog-panel-viewport-h: calc(
        2.5 * var(--discog-panel-row-h) + 2 * var(--discog-panel-gap)
      );
      --stage-panel-body-open-h: min(50svh, var(--discog-panel-viewport-h));
    }

    .stage-panel--discography[open] .stage-panel__body {
      max-height: var(--stage-panel-body-open-h);
    }

    /* Two tour cards (title / date·place / pills) without clipping the footer. */
    .stage-panel--tour {
      --stage-panel-body-open-h: min(50svh, calc(16rem * var(--hud-scale)));
    }

    /* Sequential two-stage: width ([open]) first, height after is-two-stage-height.
       No-JS: omit [data-two-stage-js] so native [open] still paints the body. */
    .stage-panels[data-two-stage-js] .stage-panel[open]:not(.is-two-stage-height) .stage-panel__body {
      max-height: 0;
      opacity: 0;
      pointer-events: none;
      padding-top: 0;
      padding-bottom: 0;
    }

    .stage-panel--info[open] .stage-panel__summary {
      align-items: center;
    }

    .stage-panel--info[open] .stage-panel__sheet-copy--summary {
      display: block;
      margin-left: auto;
      flex: 0 0 auto;
      align-self: center;
      font-family: var(--font-body);
      font-size: calc(0.72rem * var(--hud-scale));
      font-weight: 400;
      line-height: 1;
      letter-spacing: 0.02em;
      text-transform: none;
      color: var(--color-text-muted);
      text-shadow: none;
      white-space: nowrap;
    }

    .stage-panel--info .stage-panel__sheet-copy--sheet {
      display: none;
    }

    html:not([data-hud-glitch='true']) .stage-panel[open].is-panel-closing,
    html:not([data-hud-glitch='true']) .stage-panel--discography[open].is-panel-closing {
      width: var(--control-size);
      max-width: var(--control-size);
      border-radius: 999px;
    }

    html:not([data-hud-glitch='true']) .stage-panel[open].is-panel-closing .stage-panel__summary {
      justify-content: center;
      width: var(--control-size);
      min-width: var(--control-size);
      height: var(--control-size);
      min-height: var(--control-size);
      padding: 0;
    }

    html:not([data-hud-glitch='true']) .stage-panel[open].is-panel-closing .stage-panel__label {
      flex: 0 0 auto;
      width: 0;
      max-width: 0;
      opacity: 0;
    }
  }

  .stage-panel__summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: calc(0.5rem * var(--hud-scale));
    width: var(--control-size);
    height: var(--control-size);
    min-width: var(--control-size);
    min-height: var(--control-size);
    cursor: pointer;
    padding: 0;
    margin: 0;
    color: var(--color-text);
    list-style: none;
    box-sizing: border-box;
    border-radius: inherit;
  }

  .stage-panel[open] .stage-panel__summary {
    justify-content: flex-start;
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: var(--control-size);
    padding: var(--stage-panel-inset);
    color: var(--color-accent-alt);
  }

  .stage-panel[open] .stage-panel__summary :global(.hud-icon) {
    filter: drop-shadow(
      0 0 calc(0.35rem * var(--hud-scale)) color-mix(in srgb, var(--color-accent) 55%, transparent)
    );
  }

  .stage-panel__summary::marker {
    content: '';
  }

  .stage-panel__summary::-webkit-details-marker {
    display: none;
  }

  .stage-panel__summary:hover {
    color: var(--color-accent-alt);
  }

  .stage-panel__label {
    font-family: var(--font-display);
    font-size: calc(18px * var(--hud-scale));
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: inherit;
    white-space: nowrap;
    min-width: 0;
  }

  html[data-hud-glitch='true'] .stage-panel__label {
    display: none;
  }

  html[data-hud-glitch='true'] .stage-panel[open] .stage-panel__label {
    display: block;
    text-shadow: 0 0 calc(0.35rem * var(--hud-scale))
      color-mix(in srgb, var(--color-accent) 55%, transparent);
  }

  html:not([data-hud-glitch='true']) .stage-panel[open] .stage-panel__label {
    text-shadow: 0 0 calc(0.35rem * var(--hud-scale))
      color-mix(in srgb, var(--color-accent) 55%, transparent);
  }

  .stage-panel__body {
    width: 100%;
    max-width: 100%;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    padding: 0 var(--stage-panel-inset);
    box-sizing: border-box;
    font-size: calc(0.9rem * var(--hud-scale));
    color: var(--color-text);
  }

  .stage-panel[open] .stage-panel__body {
    max-height: var(--stage-panel-body-open-h);
    opacity: 1;
    overflow: auto;
    pointer-events: auto;
    padding: 0 var(--stage-panel-inset) var(--stage-panel-inset);
  }

  /* After the generic open body — desktop Discography must not inherit 11rem. */
  @media (min-width: 1024px) {
    .stage-panel--discography[open] .stage-panel__body {
      max-height: min(50svh, var(--discog-panel-viewport-h, var(--stage-panel-body-open-h)));
    }
  }

  .stage-panel.is-glitching[data-glitch='in'] .stage-panel__body {
    animation: stage-panel-body-in var(--g-dur, 560ms) both;
  }

  .stage-panel.is-glitching[data-glitch='out'] .stage-panel__body {
    animation: stage-panel-body-out 520ms both;
  }

  @keyframes stage-panel-body-in {
    0% {
      max-height: 0;
      opacity: 0;
      animation-timing-function: steps(1, end);
    }
    35% {
      max-height: var(--stage-panel-body-open-h);
      opacity: 1;
      animation-timing-function: steps(1, end);
    }
    100% {
      max-height: var(--stage-panel-body-open-h);
      opacity: 1;
    }
  }

  @keyframes stage-panel-body-out {
    0% {
      max-height: var(--stage-panel-body-open-h);
      opacity: 1;
      animation-timing-function: steps(1, end);
    }
    55% {
      max-height: var(--control-size);
      opacity: 0.4;
      animation-timing-function: steps(1, end);
    }
    100% {
      max-height: 0;
      opacity: 0;
    }
  }

  .stage-panel__body :global(p) {
    margin: 0;
  }

  /* Phone sheet header only — desktop already titles the open summary. */
  .stage-panel__sheet-title {
    display: none;
  }

  .stage-panel__sheet-copy--summary {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-panels,
    .stage-panels__sheet,
    .stage-panel,
    .stage-panel__summary,
    .stage-panel__body,
    .stage-panel__label {
      transition: none !important;
      transform: none !important;
    }

    .stage-panel__body {
      transform: none !important;
    }

    .stage-panel.is-glitching,
    .stage-panel.is-glitching .stage-panel__body {
      animation: none !important;
    }
  }

  @media (max-width: 1023px) {
    .stage-panels {
      /* List/legal scrollport cap — JS overwrites with sheet minus title. */
      --phone-sheet-scroll-h: min(45svh, calc(20rem * var(--hud-scale)));
      position: relative;
      display: flex;
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      /* Icons stay on the floor so close never recenters them through the sheet. */
      justify-content: flex-end;
      /* Kill the desktop 0.35rem row gap — it leaked between sheet and icons. */
      gap: 0;
      width: 100%;
      max-width: 100%;
      min-width: 0;
      padding-top: var(--phone-bar-pad);
      padding-bottom: var(--phone-bar-pad);
      padding-left: var(--phone-bar-pad);
      padding-right: var(--phone-bar-pad);
      border: 1px solid var(--color-border);
      /* Constant collapsed-bar radius — 999px→0.85rem looked more circular mid-flight. */
      border-radius: var(--phone-pill-radius);
      background: color-mix(in srgb, var(--color-surface) 92%, transparent);
      backdrop-filter: blur(10px);
      /* Pill drop shadow lives on .stage-dock__right — backdrop-filter here
         drops box-shadow in Chromium. Do not zero it on open. */
      box-sizing: border-box;
      overflow: visible;
      /* padding + gap only — do not interpolate border-radius */
      transition:
        padding var(--phone-panel-morph-dur, 320ms) var(--phone-bloom-ease, cubic-bezier(0.4, 0, 0.2, 1)),
        gap var(--phone-panel-morph-dur, 320ms) var(--phone-bloom-ease, cubic-bezier(0.4, 0, 0.2, 1));
    }

    /* 020: no resting circular icon pill — sheet only when open from SiteNav / Links */
    .stage-panels--nav-driven:not(.is-sheet-open):not(.is-sheet-closing):not(.is-socials-open) {
      padding: 0;
      border: 0;
      background: transparent;
      backdrop-filter: none;
      min-height: 0;
      height: 0;
      overflow: hidden;
      pointer-events: none;
      box-shadow: none;
    }

    .stage-panels--nav-driven.is-sheet-open,
    .stage-panels--nav-driven.is-sheet-closing,
    .stage-panels--nav-driven.is-socials-open,
    :global(html[data-sheet-open]) .stage-panels--nav-driven,
    :global(html[data-socials-open]) .stage-panels--nav-driven {
      height: auto;
      overflow: visible;
      pointer-events: auto;
      padding-top: var(--phone-bar-pad);
      padding-bottom: var(--phone-bar-pad);
      padding-left: var(--phone-bar-pad);
      padding-right: var(--phone-bar-pad);
      border: 1px solid var(--color-border);
      background: color-mix(in srgb, var(--color-surface) 92%, transparent);
