---
import { withBase } from '../lib/url';

interface Props {
  title: string;
  slug: string;
  open?: boolean;
}

const { title, slug, open = false } = Astro.props;
const titleId = `legal-panel-title-${slug}`;
---

<div
  class="legal-panel"
  id={`legal-panel-${slug}`}
  data-legal-panel={slug}
  role="dialog"
  aria-modal="true"
  aria-labelledby={titleId}
  hidden={!open}
>
  <div class="legal-panel__frame">
    <header class="legal-panel__header">
      <a
        class="legal-panel__exit glitch-hit"
        href={withBase('/')}
        data-legal-exit
        aria-label="Back"
        title="Back"
      >
        <svg
          class="legal-panel__exit-icon"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          aria-hidden="true"
          focusable="false"
        >
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19 12H5M11 6l-6 6 6 6"
          ></path>
        </svg>
      </a>
      <h1 id={titleId}>{title}</h1>
    </header>
    <div class="legal-panel__body">
      <slot />
    </div>
  </div>
</div>

<style>
  .legal-panel {
    position: fixed;
    inset: 0;
    z-index: 5;
    display: grid;
    place-items: stretch;
    padding: clamp(0.75rem, 3vw, 1.5rem);
    pointer-events: none;
  }

  .legal-panel[hidden] {
    display: none;
  }

  .legal-panel__frame {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-height: 100%;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 35%);
    animation: legal-panel-in 320ms ease-out both;
  }

  .legal-panel__header {
    display: grid;
    gap: var(--space-s);
    padding: var(--space-m) var(--space-m) var(--space-s);
    border-bottom: 1px solid var(--color-border);
  }

  .legal-panel__exit {
    justify-self: end;
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-text);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0;
    background: var(--color-bg);
  }

  .legal-panel__exit:hover {
    border-color: var(--color-accent);
  }

  .legal-panel__exit-icon {
    display: block;
  }

  .legal-panel__header h1 {
    margin: 0;
    font-size: clamp(1.5rem, 5vw, 2.25rem);
  }

  .legal-panel__body {
    overflow: auto;
    padding: var(--space-m);
    color: var(--color-text);
  }

  .legal-panel__body :global(p) {
    max-width: 42rem;
  }

  @keyframes legal-panel-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /*
   * Desktop: same layer as the phone menu — full viewport, dark glass, no card. It opens as
   * a circle growing out of the clicked nav item (`--legal-origin`, set by LegalOverlay)
   * and collapses back into it. Content sits in one centered column.
   */
  /* Phone: above the whole nav (z=8) — deep links show the sheet over everything. */
  @media (max-width: 1023px) {
    .legal-panel {
      z-index: 9;
    }
  }

  @media (min-width: 1024px) {
    .legal-panel {
      padding: 0;
    }

    .legal-panel__frame {
      --legal-pad-x: clamp(2rem, 6vw, 4rem);
      border: 0;
      border-radius: 0;
      background: color-mix(in srgb, #050505 92%, transparent);
      backdrop-filter: blur(16px);
      box-shadow: none;
      animation: none;
      clip-path: circle(160% at var(--legal-origin, 50% 0%));
      /* Opening runs a touch slower than the shared morph; closing keeps --morph-dur. */
      transition: clip-path var(--legal-open-dur, 650ms) var(--morph-ease);
    }

    .legal-panel.is-collapsed .legal-panel__frame {
      clip-path: circle(0% at var(--legal-origin, 50% 0%));
      transition: clip-path var(--morph-dur) var(--morph-ease);
    }

    .legal-panel__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-m);
      width: 100%;
      max-width: 52rem;
      margin: 0 auto;
      /* Clear the nav wordmark that stays in front (top inset + 11rem × 362/960). */
      padding: calc(0.75rem + 11rem * 362 / 960 + 1.75rem) var(--legal-pad-x) 1.15rem;
      box-sizing: border-box;
      border-bottom: 0;
    }

    .legal-panel__header h1 {
      font-family: var(--font-display);
      font-size: clamp(1.9rem, 2.6vw, 2.6rem);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      line-height: 1.15;
    }

    .legal-panel__exit {
      order: 1;
      flex: 0 0 auto;
      width: 2.75rem;
      height: 2.75rem;
      background: transparent;
    }

    /* The column scrolls with the whole layer, so the scrollbar sits at the viewport edge. */
    .legal-panel__frame {
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .legal-panel__body {
      overflow: visible;
      width: 100%;
      max-width: 52rem;
      margin: 0 auto;
      padding: 0 var(--legal-pad-x) clamp(2.5rem, 7vh, 4.5rem);
      box-sizing: border-box;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .legal-panel__frame {
      animation: none;
      transition: none;
    }
  }
</style>
