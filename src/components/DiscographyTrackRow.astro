---
import type { DiscographyEntry } from '../lib/catalog-tracks';
import type { UiChrome } from '../lib/stage';
import { coverOrPlaceholder } from '../lib/url';
import ChannelIcon from './ChannelIcon.astro';
import StagePlayButton from './StagePlayButton.astro';

interface Props {
  chrome: UiChrome;
  release: DiscographyEntry;
  /** Artist line under the title (credits Artist, or site fallback). */
  artistName: string;
  /**
   * Kind chip beside the title. Singles show `Single`; collection members omit
   * it because the group header already names the EP/Compilation.
   */
  kindLabel?: string;
  /** Full kind string for the expanded Type row. */
  typeDetail?: string;
  dateFmt: Intl.DateTimeFormat;
  /** `nested` = track inside a collection card (no per-track cover). */
  variant?: 'card' | 'nested';
}

const {
  chrome,
  release,
  artistName,
  kindLabel,
  typeDetail,
  dateFmt,
  variant = 'card',
} = Astro.props;
const nested = variant === 'nested';
const detailsId = `discog-details-${release.id}`;
const dateIso = release.sortDate.toISOString().slice(0, 10);
const dateLabel = dateFmt.format(release.sortDate);
const coverSrc = coverOrPlaceholder(release.coverUrl);
const expandedType = typeDetail ?? release.kind;
/** Only stage songs (with a jukebox entry) can go on stage — catalog-only rows get no play. */
const stageId = release.jukeboxId;
/** Tracklist rows carry play + platform links; cards carry platform links (play is on the cover). */
const hasLinks = release.listenLinks.length > 0 || Boolean(stageId);
---

<li
  class:list={['discog__item', { 'discog__item--nested': nested }]}
  data-discog-entry={release.id}
  data-swipeable={release.swipeable ? '' : undefined}
>
  {/*
    One links list per row. Collapsed it sits in its "home" (under the title on cards, at the
    right of tracklist rows); expanding moves it into the dock at the bottom-right of the box
    while the details slide out above it (animated in Discography.astro).
  */}
  {
    nested ? (
      <div class="discog__nested-row">
        <button
          type="button"
          class="discog__toggle"
          aria-expanded="false"
          aria-controls={detailsId}
        >
          <span class="discog__head-text__title">{release.title}</span>
          <span class="discog__head-text__artist">{artistName}</span>
        </button>
        {hasLinks && (
          <div class="discog__listen-home" data-discog-listen-home>
            <ul
              class="discog__listen-links discog__listen-links--compact"
              aria-label={chrome.listenOnLabel}
              data-discog-listen-links
            >
              {/* Play leads the icon row, before the platform links. */}
              {stageId && (
                <li>
                  <StagePlayButton chrome={chrome} stageId={stageId} />
                </li>
              )}
              {release.listenLinks.map((link) => (
                <li>
                  <a
                    class="glitch-hit"
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={link.label}
                    data-hud-label={link.label}
                    data-hud-label-anchor="above"
                  >
                    <ChannelIcon id={link.platform} label={link.label} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    ) : (
      <div class="discog__head">
        <div class="discog__cover-slot">
          {/* Artwork only — no link; clicks on the cover do nothing. */}
          <div class="discog__cover" aria-hidden="true">
            <img
              class="discog__cover-img"
              src={coverSrc}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
          {stageId && <StagePlayButton chrome={chrome} stageId={stageId} size="badge" />}
        </div>
        <div class="discog__meta">
          <button
            type="button"
            class="discog__toggle"
            aria-expanded="false"
            aria-controls={detailsId}
          >
            {kindLabel && <span class="discog__head-text__kind">{kindLabel}</span>}
            <span class="discog__head-text__title">{release.title}</span>
            <span class="discog__head-text__artist">{artistName}</span>
          </button>
          {release.listenLinks.length > 0 && (
            <div class="discog__listen-home" data-discog-listen-home>
              <ul
                class="discog__listen-links"
                aria-label={chrome.listenOnLabel}
                data-discog-listen-links
              >
                {release.listenLinks.map((link) => (
                  <li>
                    <a
                      class="glitch-hit"
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={link.label}
                      data-hud-label={link.label}
                      data-hud-label-anchor="above"
                    >
                      <ChannelIcon id={link.platform} label={link.label} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    )
  }
  <div class="discog__details" id={detailsId} hidden>
    <div class="discog__details-inner">
      <dl class="discog__facts">
        <div class="discog__fact">
          <dt>{chrome.releasedLabel}</dt>
          <dd>
            <time datetime={dateIso}>{dateLabel}</time>
          </dd>
        </div>
        {expandedType && (
          <div class="discog__fact">
            <dt>Type</dt>
            <dd>{expandedType}</dd>
          </div>
        )}
        <div class="discog__fact">
          <dt>Artist</dt>
          <dd>{artistName}</dd>
        </div>
      </dl>
      {release.notes && <p class="discog__notes">{release.notes}</p>}
    </div>
  </div>
  {
    (nested ? hasLinks : release.listenLinks.length > 0) && (
      <div class="discog__listen-dock" data-discog-listen-dock hidden>
        <div class="discog__listen-dock-inner" data-discog-listen-dock-slot>
          {release.listenLinks.length > 0 && (
            <span class="discog__listen-label">{chrome.listenOnLabel}</span>
          )}
        </div>
      </div>
    )
  }
</li>

<style>
  .discog__item {
    display: flex;
    flex-direction: column;
    padding: calc(0.75rem * var(--hud-scale));
    /* Neutral card chrome, as in the phone menu. */
    border: 1px solid color-mix(in srgb, #fff 14%, transparent);
    border-radius: calc(0.55rem * var(--hud-scale));
    background: color-mix(in srgb, #fff 4%, transparent);
    min-width: 0;
    cursor: pointer;
    transition:
      border-color 320ms ease,
      background-color 320ms ease,
      box-shadow 320ms ease;
  }

  .discog__item[data-swipeable] {
    touch-action: pan-y;
  }

  .discog__item--nested {
    display: block;
    padding: calc(0.5rem * var(--hud-scale)) 0;
    border: none;
    border-radius: 0;
    border-bottom: 1px solid color-mix(in srgb, #fff 10%, transparent);
    background: transparent;
    box-shadow: none;
  }

  .discog__item--nested:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .discog__item.is-expanded:not(.discog__item--nested) {
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-text) 6%, transparent);
  }

  .discog__item--nested.is-expanded {
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
  }

  .discog__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: calc(0.85rem * var(--hud-scale));
    align-items: center;
  }

  /* Positioning context for the stage play badge (outside the cover's aria-hidden). */
  .discog__cover-slot {
    position: relative;
    /* The card is clickable; the artwork is not. */
    cursor: default;
    flex: 0 0 auto;
  }

  .discog__cover {
    --discog-cover-size: calc(6.75rem * var(--hud-scale));
    width: var(--discog-cover-size);
    height: var(--discog-cover-size);
    flex: 0 0 auto;
    border-radius: calc(0.4rem * var(--hud-scale));
    overflow: hidden;
    border: 1px solid color-mix(in srgb, #fff 14%, transparent);
    background: color-mix(in srgb, #fff 6%, transparent);
  }

  .discog__cover-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .discog__meta {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    align-self: center;
  }

  .discog__toggle {
    appearance: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    min-width: 0;
    width: 100%;
  }

  .discog__toggle:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 70%, transparent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .discog__head-text__kind,
  .discog__head-text__title,
  .discog__head-text__artist {
    display: block;
    margin: 0;
    padding: 0;
  }

  .discog__head-text__kind {
    font-family: var(--font-display);
    font-size: calc(0.56rem * var(--hud-scale));
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .discog__head-text__title {
    font-family: var(--font-display);
    font-size: calc(0.84rem * var(--hud-scale));
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.15;
    color: var(--color-text);
  }

  /* Tracklist rows: title only a touch larger than the artist line. */
  .discog__item--nested .discog__head-text__title {
    font-size: calc(0.7rem * var(--hud-scale));
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .discog__head-text__artist {
    font-size: calc(0.66rem * var(--hud-scale));
    line-height: 1.2;
    color: var(--color-text-muted);
  }

  .discog__item--nested .discog__head-text__artist {
    font-size: calc(0.6rem * var(--hud-scale));
  }

  /* —— Details: slide out below the head (height animated in Discography.astro) —— */

  .discog__details {
    overflow: hidden;
  }

  .discog__details[hidden],
  .discog__listen-dock[hidden] {
    display: none;
  }

  .discog__details-inner {
    display: flex;
    flex-direction: column;
    gap: calc(0.5rem * var(--hud-scale));
    padding-top: calc(0.7rem * var(--hud-scale));
  }

  .discog__facts {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: calc(0.28rem * var(--hud-scale));
  }

  .discog__fact {
    display: grid;
    grid-template-columns: minmax(4.5rem, auto) minmax(0, 1fr);
    column-gap: calc(0.65rem * var(--hud-scale));
    align-items: baseline;
    font-size: calc(0.66rem * var(--hud-scale));
  }

  .discog__fact dt {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.85em;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .discog__fact dd {
    margin: 0;
    color: var(--color-text);
  }

  .discog__notes {
    margin: 0;
    font-size: calc(0.66rem * var(--hud-scale));
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  /* —— Listen links: home (collapsed) and dock (expanded, bottom-right) —— */

  .discog__nested-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(0.45rem * var(--hud-scale));
    min-width: 0;
  }

  .discog__nested-row .discog__toggle {
    flex: 1 1 auto;
    width: auto;
  }

  /* flow-root keeps the list's top margin inside, so the home's height is measurable. */
  .discog__head .discog__listen-home {
    display: flow-root;
  }

  .discog__head .discog__listen-home > .discog__listen-links {
    margin-top: calc(0.45rem * var(--hud-scale));
  }

  .discog__nested-row .discog__listen-home {
    flex: 0 0 auto;
  }

  /* While expanded the emptied home keeps its size (pinned inline by Discography.astro),
     so the title block never shifts and the travelling links land where they aim. */

  .discog__listen-dock-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(0.45rem * var(--hud-scale));
    margin-top: calc(0.6rem * var(--hud-scale));
    padding-top: calc(0.55rem * var(--hud-scale));
    border-top: 1px solid color-mix(in srgb, #fff 12%, transparent);
  }

  .discog__listen-dock-inner .discog__listen-links {
    margin-left: auto;
  }

  .discog__listen-label {
    font-family: var(--font-display);
    font-size: calc(0.52rem * var(--hud-scale));
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent-alt);
    opacity: 0.75;
    flex: 0 0 auto;
  }

  .discog__listen-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: inline-flex;
    flex-flow: row wrap;
    align-items: center;
    gap: calc(0.35rem * var(--hud-scale));
  }

  .discog__listen-links li {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .discog__listen-links a {
    overflow: visible;
    display: inline-grid;
    place-items: center;
    width: calc(1.85rem * var(--hud-scale));
    height: calc(1.85rem * var(--hud-scale));
    border: 1px solid color-mix(in srgb, #fff 18%, transparent);
    border-radius: 999px;
    color: var(--color-text-muted);
    background: color-mix(in srgb, #fff 4%, transparent);
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .discog__listen-links a:hover {
    color: var(--color-accent-alt);
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .discog__listen-links :global(.channel-icon) {
    width: calc(1.05rem * var(--hud-scale));
    height: calc(1.05rem * var(--hud-scale));
  }

  /* Play shares the row with the platform links: same circle size. */
  .discog__listen-links :global(.stage-play) {
    --stage-play-size: calc(1.85rem * var(--hud-scale));
  }

  /* Tracklist rows: the phone menu's dense glyphs (kept when they move to the dock). */
  .discog__listen-links--compact {
    flex-wrap: nowrap;
    gap: calc(0.22rem * var(--hud-scale));
  }

  .discog__listen-links--compact a {
    width: calc(1.6rem * var(--hud-scale));
    height: calc(1.6rem * var(--hud-scale));
  }

  .discog__listen-links--compact :global(.channel-icon) {
    width: calc(0.85rem * var(--hud-scale));
    height: calc(0.85rem * var(--hud-scale));
  }

  .discog__listen-links--compact :global(.stage-play) {
    --stage-play-size: calc(1.6rem * var(--hud-scale));
  }

  @media (max-width: 1023px) {
    .discog__listen-links:not(.discog__listen-links--compact) a {
      width: 2.5rem;
      height: 2.5rem;
    }

    .discog__listen-links:not(.discog__listen-links--compact) :global(.channel-icon) {
      width: 1.55rem;
      height: 1.55rem;
    }

    .discog__listen-links:not(.discog__listen-links--compact) :global(.stage-play) {
      --stage-play-size: 2.5rem;
    }
  }
</style>
