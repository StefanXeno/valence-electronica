---
import '@fontsource-variable/unbounded';
import '../styles/global.css';
import '../styles/themes.css';
import '../styles/glitch.css';
import site from '../data/site.json';
import Footer from '../components/Footer.astro';
import BackgroundAtmosphere from '../components/BackgroundAtmosphere.astro';
import GlitchPress from '../components/GlitchPress.astro';
import LegalOverlay from '../components/LegalOverlay.astro';
import { getDefaultVideo } from '../lib/background';
import { applyThemeAttributes, resolveThemePack } from '../lib/theme-packs';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.seo.title, description = site.artist.description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const defaultVideo = await getDefaultVideo();
const themeAttrs = applyThemeAttributes(resolveThemePack(defaultVideo.themeId));

// Dedicated brand OG image — stable for link previews regardless of active stage.
const shareImage = Astro.site
  ? new URL(withBase('/images/brand/og-image.jpg'), Astro.site).href
  : undefined;

// The pre-release preview shares an origin with the live site, so it must never
// be indexed as duplicate content regardless of the seo.indexable switch.
const isPreview = import.meta.env.BASE_URL.replace(/\/$/, '').endsWith('/pre-release');
const indexable = site.seo.indexable && !isPreview;
---

<!doctype html>
<html lang="en" data-theme={themeAttrs.themeId} data-hud-glitch={themeAttrs.hudGlitch}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.artist.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta property="og:image:alt" content={`${site.artist.name} stage artwork`} />}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {shareImage && <meta name="twitter:image" content={shareImage} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/images/brand/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="64x64" href={withBase('/images/brand/favicon-64.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/images/brand/favicon-180.png')} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <BackgroundAtmosphere />
    <div class="page-shell">
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <LegalOverlay />
    <GlitchPress />
    <div id="hud-label-reveal" class="hud-label-reveal" aria-hidden="true" hidden></div>
    <script>
      import { initLabelReveal } from '../lib/label-reveal';
      initLabelReveal();
    </script>
  </body>
</html>

<style>
  .page-shell {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }
</style>
