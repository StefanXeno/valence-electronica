---
import type { DiscographyEntry } from '../lib/catalog-tracks';
import type { UiChrome } from '../lib/stage';
import { coverOrPlaceholder } from '../lib/url';
import ChannelIcon from './ChannelIcon.astro';
import HudIcon from './HudIcon.astro';

interface Props {
  chrome: UiChrome;
  release: DiscographyEntry;
  /** Artist line under the title (credits Artist, or site fallback). */
  artistName: string;
  /**
   * Kind chip beside the title. Singles show `Single`; collection members omit
   * it because the group header already names the EP/Compilation.
   */
  kindLabel?: string;
  /** Full kind string for the expanded Type row. */
  typeDetail?: string;
  dateFmt: Intl.DateTimeFormat;
  /** `nested` = track inside a collection card (no per-track cover). */
  variant?: 'card' | 'nested';
}

const {
  chrome,
  release,
  artistName,
  kindLabel,
  typeDetail,
  dateFmt,
  variant = 'card',
} = Astro.props;
const nested = variant === 'nested';
const detailsId = `discog-details-${release.id}`;
const dateIso = release.sortDate.toISOString().slice(0, 10);
const dateLabel = dateFmt.format(release.sortDate);
const coverSrc = coverOrPlaceholder(release.coverUrl);
const hasRealCover = Boolean(release.coverUrl?.trim());
const primaryListen =
  release.listenLinks.find((link) => link.url === release.url) ?? release.listenLinks[0];
const coverListenHref = release.url;
const coverListenLabel = primaryListen
  ? `${chrome.listenOnLabel} ${release.title} (${primaryListen.label})`
  : undefined;
const expandedType = typeDetail ?? release.kind;
---

<li
  class:list={['discog__item', { 'discog__item--nested': nested }]}
  data-discog-entry={release.id}
  data-rubbable={release.rubbable ? release.id : undefined}
>
  {
    nested ? (
      <div class="discog__main">
        <button
          type="button"
          class="discog__toggle"
          aria-expanded="false"
          aria-controls={detailsId}
        >
          <span class="discog__head-text__title">{release.title}</span>
          <span class="discog__head-text__artist">{artistName}</span>
        </button>
        {release.listenLinks.length > 0 && (
          <div class="discog__listen discog__listen--summary">
            <span class="discog__listen-label">{chrome.listenOnLabel}</span>
            <ul class="discog__listen-links">
              {release.listenLinks.map((link) => (
                <li>
                  <a
                    class="glitch-hit"
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={link.label}
                    data-hud-label={link.label}
                    data-hud-label-anchor="above"
                  >
                    <ChannelIcon id={link.platform} label={link.label} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        <div class="discog__details" id={detailsId} hidden>
          <dl class="discog__facts">
            <div class="discog__fact">
              <dt>{chrome.releasedLabel}</dt>
              <dd>
                <time datetime={dateIso}>{dateLabel}</time>
              </dd>
            </div>
            {expandedType && (
              <div class="discog__fact">
                <dt>Type</dt>
                <dd>{expandedType}</dd>
              </div>
            )}
            <div class="discog__fact">
              <dt>Artist</dt>
              <dd>{artistName}</dd>
            </div>
          </dl>
          {release.listenLinks.length > 0 && (
            <div class="discog__listen">
              <span class="discog__listen-label">{chrome.listenOnLabel}</span>
              <ul class="discog__listen-links">
                {release.listenLinks.map((link) => (
                  <li>
                    <a
                      class="glitch-hit"
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={link.label}
                      data-hud-label={link.label}
                      data-hud-label-anchor="above"
                    >
                      <ChannelIcon id={link.platform} label={link.label} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {release.notes && <p class="discog__notes">{release.notes}</p>}
        </div>
      </div>
    ) : (
      <>
        <div class="discog__head">
          <div
            class="discog__cover"
            aria-hidden={coverListenHref && hasRealCover ? undefined : 'true'}
          >
            {hasRealCover && coverListenHref && coverListenLabel ? (
              <a
                class="discog__cover-link glitch-hit"
                href={coverListenHref}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={coverListenLabel}
                data-hud-label={primaryListen?.label}
                data-hud-label-anchor="above"
              >
                <img
                  class="discog__cover-img"
                  src={coverSrc}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ) : (
              <img
                class="discog__cover-img"
                src={coverSrc}
                alt=""
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
          <div class="discog__meta">
            <button
              type="button"
              class="discog__toggle"
              aria-expanded="false"
              aria-controls={detailsId}
            >
              {kindLabel && <span class="discog__head-text__kind">{kindLabel}</span>}
              <span class="discog__head-text__title">{release.title}</span>
              <span class="discog__head-text__artist">{artistName}</span>
            </button>
          </div>
          <div class="discog__play-slot">
            <button
              type="button"
              class="discog__play glitch-hit"
              data-discog-play
              aria-label={chrome.stageButtonLabel}
              data-hud-label={chrome.stageButtonLabel}
              data-hud-label-anchor="above"
            >
              <HudIcon token="play" />
            </button>
          </div>
        </div>
        {release.listenLinks.length > 0 && (
          <div class="discog__listen discog__listen--summary">
            <span class="discog__listen-label">{chrome.listenOnLabel}</span>
            <ul class="discog__listen-links">
              {release.listenLinks.map((link) => (
                <li>
                  <a
                    class="glitch-hit"
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={link.label}
                    data-hud-label={link.label}
                    data-hud-label-anchor="above"
                  >
                    <ChannelIcon id={link.platform} label={link.label} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        <div class="discog__details" id={detailsId} hidden>
          <dl class="discog__facts">
            <div class="discog__fact">
              <dt>{chrome.releasedLabel}</dt>
              <dd>
                <time datetime={dateIso}>{dateLabel}</time>
              </dd>
            </div>
            {expandedType && (
              <div class="discog__fact">
                <dt>Type</dt>
                <dd>{expandedType}</dd>
              </div>
            )}
            <div class="discog__fact">
              <dt>Artist</dt>
              <dd>{artistName}</dd>
            </div>
          </dl>
          {release.listenLinks.length > 0 && (
            <div class="discog__listen">
              <span class="discog__listen-label">{chrome.listenOnLabel}</span>
              <ul class="discog__listen-links">
                {release.listenLinks.map((link) => (
                  <li>
                    <a
                      class="glitch-hit"
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={link.label}
                      data-hud-label={link.label}
                      data-hud-label-anchor="above"
                    >
                      <ChannelIcon id={link.platform} label={link.label} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {release.notes && <p class="discog__notes">{release.notes}</p>}
        </div>
      </>
    )
  }
</li>

<style>
  .discog__item {
    display: flex;
    flex-direction: column;
    gap: calc(0.55rem * var(--hud-scale));
    padding: calc(0.75rem * var(--hud-scale));
    border: 1px solid color-mix(in srgb, var(--color-border) 85%, transparent);
    border-radius: calc(0.6rem * var(--hud-scale));
    background: color-mix(in srgb, var(--color-bg) 22%, transparent);
    min-width: 0;
    cursor: pointer;
    transition:
      border-color 200ms ease,
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  .discog__item[data-rubbable] {
    touch-action: pan-y;
  }

  .discog__item--nested {
    display: block;
    padding: calc(0.55rem * var(--hud-scale)) 0;
    border: none;
    border-radius: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 28%, transparent);
    background: transparent;
    box-shadow: none;
    gap: 0;
  }

  .discog__item--nested:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .discog__item.is-expanded:not(.discog__item--nested) {
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-text) 6%, transparent);
  }

  .discog__item--nested.is-expanded {
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
  }

  /* Same head rhythm as EP/collection cards: cover | text | play */
  .discog__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    column-gap: calc(0.75rem * var(--hud-scale));
    align-items: center;
  }

  .discog__cover {
    --discog-cover-size: calc(5.5rem * var(--hud-scale));
    width: var(--discog-cover-size);
    height: var(--discog-cover-size);
    flex: 0 0 auto;
    border-radius: calc(0.4rem * var(--hud-scale));
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    background: color-mix(in srgb, var(--color-border) 22%, transparent);
    transition:
      width 280ms cubic-bezier(0.22, 1, 0.36, 1),
      height 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .discog__item.is-expanded:not(.discog__item--nested) .discog__cover {
    --discog-cover-size: calc(8rem * var(--hud-scale));
  }

  .discog__cover-link {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .discog__cover-link:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 70%, transparent);
    outline-offset: 2px;
  }

  .discog__cover-link:hover .discog__cover-img,
  .discog__cover-link:focus-visible .discog__cover-img {
    filter: brightness(1.08);
  }

  .discog__cover-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .discog__meta {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    align-self: center;
  }

  .discog__main {
    display: flex;
    flex-direction: column;
    gap: calc(0.3rem * var(--hud-scale));
    min-width: 0;
  }

  .discog__toggle {
    appearance: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.12rem;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    min-width: 0;
    width: 100%;
  }

  .discog__toggle:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 70%, transparent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .discog__head-text__kind,
  .discog__head-text__title,
  .discog__head-text__artist {
    display: block;
    margin: 0;
    padding: 0;
  }

  .discog__head-text__kind {
    font-family: var(--font-display);
    font-size: calc(0.68rem * var(--hud-scale));
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .discog__head-text__title {
    font-family: var(--font-display);
    font-size: calc(1.05rem * var(--hud-scale));
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.05;
    color: var(--color-text);
  }

  .discog__item--nested .discog__head-text__title {
    font-size: calc(0.95rem * var(--hud-scale));
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .discog__head-text__artist {
    font-size: calc(0.78rem * var(--hud-scale));
    line-height: 1.05;
    color: var(--color-text-muted);
  }

  .discog__details {
    display: flex;
    flex-direction: column;
    gap: calc(0.55rem * var(--hud-scale));
    padding-top: calc(0.15rem * var(--hud-scale));
  }

  .discog__details[hidden] {
    display: none;
  }

  .discog__facts {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: calc(0.3rem * var(--hud-scale));
  }

  .discog__fact {
    display: grid;
    grid-template-columns: minmax(4.5rem, auto) minmax(0, 1fr);
    column-gap: calc(0.65rem * var(--hud-scale));
    align-items: baseline;
    font-size: calc(0.78rem * var(--hud-scale));
  }

  .discog__fact dt {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.85em;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .discog__fact dd {
    margin: 0;
    color: var(--color-text);
  }

  .discog__notes {
    margin: 0;
    font-size: calc(0.78rem * var(--hud-scale));
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .discog__listen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(0.45rem * var(--hud-scale));
    padding-top: calc(0.45rem * var(--hud-scale));
    border-top: 1px solid color-mix(in srgb, var(--color-border) 40%, transparent);
    min-width: 0;
  }

  .discog__item--nested .discog__listen--summary {
    padding-top: calc(0.35rem * var(--hud-scale));
    border-top: none;
  }

  .discog__item.is-expanded .discog__listen--summary {
    display: none;
  }

  .discog__listen-label {
    font-family: var(--font-display);
    font-size: calc(0.58rem * var(--hud-scale));
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent-alt);
    opacity: 0.75;
    flex: 0 0 auto;
  }

  .discog__listen-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: inline-flex;
    flex-flow: row wrap;
    align-items: center;
    gap: calc(0.35rem * var(--hud-scale));
  }

  .discog__listen-links li {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .discog__listen-links a {
    overflow: visible;
    display: inline-grid;
    place-items: center;
    width: calc(2.35rem * var(--hud-scale));
    height: calc(2.35rem * var(--hud-scale));
    border: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
    border-radius: 999px;
    color: var(--color-text-muted);
    background: color-mix(in srgb, var(--color-bg) 30%, transparent);
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .discog__listen-links a:hover {
    color: var(--color-accent-alt);
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .discog__listen-links :global(.channel-icon) {
    width: calc(1.45rem * var(--hud-scale));
    height: calc(1.45rem * var(--hud-scale));
  }

  .discog__play-slot {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .discog__play {
    appearance: none;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    width: calc(2.35rem * var(--hud-scale));
    height: calc(2.35rem * var(--hud-scale));
    border-radius: 999px;
    display: grid;
    place-items: center;
    font: inherit;
    color: var(--color-text-muted);
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    background: transparent;
    cursor: pointer;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .discog__play:hover {
    color: var(--color-accent-alt);
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .discog__play :global(.hud-icon) {
    width: calc(1.1rem * var(--hud-scale));
    height: calc(1.1rem * var(--hud-scale));
    translate: 0.08em 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .discog__cover {
      transition: none;
    }
  }

  @media (max-width: 1023px) {
    .discog__listen-links a {
      width: 2.5rem;
      height: 2.5rem;
    }

    .discog__listen-links :global(.channel-icon) {
      width: 1.55rem;
      height: 1.55rem;
    }
  }
</style>
