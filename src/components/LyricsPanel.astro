---
import { getCollection, render } from 'astro:content';
import { getBackgroundConfig } from '../lib/background';
import type { UiChrome } from '../lib/stage';

interface Props {
  chrome: UiChrome;
}

const { chrome } = Astro.props;
const { videos, defaultVideoId } = await getBackgroundConfig();
const validIds = new Set(videos.map((entry) => entry.id));
const raw = await getCollection('jukebox');
const lyrics = await Promise.all(
  raw
    .filter((entry) => validIds.has(entry.id))
    .map(async (entry) => {
      const empty = !entry.body?.trim();
      const Content = empty ? undefined : (await render(entry)).Content;
      return { id: entry.id, empty, Content };
    }),
);
---

<div class="lyrics">
  {lyrics.map(({ id, empty, Content }) => (
    <div data-lyrics-for={id} hidden={id !== defaultVideoId}>
      {empty || !Content ? <p>{chrome.emptyLyrics}</p> : <Content />}
    </div>
  ))}
</div>

<style>
  .lyrics {
    font-size: 0.9rem;
    color: var(--color-text);
  }

  .lyrics :global(p) {
    margin: 0 0 0.65em;
  }

  .lyrics :global(p:last-child) {
    margin-bottom: 0;
  }

  .lyrics [hidden] {
    display: none;
  }
</style>
