---
import AboutPanel from './AboutPanel.astro';
import Discography from './Discography.astro';
import TourDates from './TourDates.astro';
import HudIcon from './HudIcon.astro';
import { getBackgroundConfig } from '../lib/background';
import { getAboutEntry, getChrome } from '../lib/stage';

const [chrome, about, { defaultVideoId }] = await Promise.all([
  getChrome(),
  getAboutEntry(),
  getBackgroundConfig(),
]);

const panels = [
  about && {
    title: chrome.aboutTitle,
    icon: chrome.aboutIcon,
    emoji: chrome.aboutIconEmoji,
    body: 'about' as const,
  },
  {
    title: chrome.discographyTitle,
    icon: chrome.discographyIcon,
    emoji: chrome.discographyIconEmoji,
    body: 'discography' as const,
  },
  {
    title: chrome.tourTitle,
    icon: chrome.tourIcon,
    emoji: chrome.tourIconEmoji,
    body: 'tour' as const,
  },
].filter((panel): panel is NonNullable<typeof panel> => Boolean(panel));
---

<div class="stage-panels" data-stage-panels>
  {
    panels.map((panel) => (
      <details class="stage-panel" data-stage-panel>
        <summary
          class="stage-panel__summary glitch-hit"
          data-hud-label={panel.title}
          data-hud-label-anchor="above"
        >
          <span class="visually-hidden">{panel.title}</span>
          <HudIcon token={panel.icon} emoji={panel.emoji} />
          <span class="stage-panel__label">{panel.title}</span>
        </summary>
        <div class="stage-panel__body">
          {panel.body === 'about' && <AboutPanel />}
          {panel.body === 'discography' && (
            <Discography chrome={chrome} defaultId={defaultVideoId} />
          )}
          {panel.body === 'tour' && <TourDates chrome={chrome} />}
        </div>
      </details>
    ))
  }
</div>

<script>
  import { isGlitchThemeActive, playElementGlitch } from '../lib/glitch';
  import { panelCloseDelayMs, runSmoothPanelOpen, shouldSmoothPanelOpen } from '../lib/panel-motion';

  function initExclusivePanels() {
    const cluster = document.querySelector('[data-stage-panels]');
    if (!cluster) return;

    cluster.addEventListener(
      'toggle',
      (event) => {
        const target = event.target;
        if (!(target instanceof HTMLDetailsElement) || !target.open) return;
        cluster.querySelectorAll('details[open]').forEach((node) => {
          if (node instanceof HTMLDetailsElement && node !== target) node.open = false;
        });
      },
      true,
    );
  }

  function initStagePanelGlitch(panel: HTMLDetailsElement) {
    const summary = panel.querySelector('summary');
    if (!summary) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let morphTimer: number | undefined;

    const playMorph = (direction: 'in' | 'out') => {
      if (reduceMotion.matches || !isGlitchThemeActive()) return;
      panel.dataset.glitch = direction;
      window.clearTimeout(morphTimer);
      const dur = playElementGlitch(panel, 'is-glitching');
      morphTimer = window.setTimeout(() => {
        panel.classList.remove('is-glitching');
        delete panel.dataset.glitch;
      }, dur + 80);
    };

    summary.addEventListener('click', (event) => {
      if (!panel.open) {
        if (!shouldSmoothPanelOpen(reduceMotion.matches)) return;
        event.preventDefault();
        panel.open = true;
        runSmoothPanelOpen(panel, reduceMotion.matches);
        return;
      }

      event.preventDefault();
      if (panel.classList.contains('is-glitching')) return;

      if (isGlitchThemeActive()) {
        playMorph('out');
      } else if (!reduceMotion.matches) {
        panel.classList.add('is-panel-closing');
      }

      window.setTimeout(() => {
        panel.open = false;
        panel.classList.remove('is-panel-closing');
      }, panelCloseDelayMs(reduceMotion.matches));
    });

    panel.addEventListener('toggle', () => {
      if (panel.open) playMorph('in');
    });
  }

  function bootStagePanels() {
    initExclusivePanels();
    document.querySelectorAll<HTMLDetailsElement>('[data-stage-panel]').forEach(initStagePanelGlitch);
  }

  bootStagePanels();
</script>

<style>
  .stage-panels {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: flex-end;
    gap: calc(0.35rem * var(--hud-scale));
  }

  .stage-panel {
    --stage-panel-inset: calc(0.65rem * var(--hud-scale));

    position: relative;
    overflow: visible;
    margin: 0;
    width: var(--control-size);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    backdrop-filter: blur(8px);
    box-sizing: border-box;
  }

  html[data-hud-glitch='true'] .stage-panel {
    transition:
      width 160ms steps(2, end),
      border-radius 160ms steps(2, end);
  }

  html:not([data-hud-glitch='true']) .stage-panel {
    transition:
      width 280ms cubic-bezier(0.4, 0, 0.2, 1),
      border-radius 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  html:not([data-hud-glitch='true']) .stage-panel__summary {
    transition: padding 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  html:not([data-hud-glitch='true']) .stage-panel:not([open]) .stage-panel__summary {
    gap: 0;
  }

  html:not([data-hud-glitch='true']) .stage-panel__label {
    display: block;
    flex: 0 0 auto;
    width: 0;
    min-width: 0;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-width 280ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 220ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  html:not([data-hud-glitch='true']) .stage-panel[open] .stage-panel__label {
    flex: 1 1 auto;
    width: auto;
    max-width: 100%;
    opacity: 1;
  }

  html:not([data-hud-glitch='true']) .stage-panel__body {
    transition:
      max-height 280ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 220ms cubic-bezier(0.4, 0, 0.2, 1),
      padding 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  html:not([data-hud-glitch='true']) .stage-panel.is-panel-closing .stage-panel__body,
  html:not([data-hud-glitch='true']) .stage-panel.is-panel-opening .stage-panel__body,
  html:not([data-hud-glitch='true']) .stage-panel[open].is-panel-opening .stage-panel__body {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
    padding-top: 0;
    padding-bottom: 0;
  }

  html[data-hud-glitch='true'] .stage-panel.is-glitching .stage-panel__body {
    transition: none;
  }

  .stage-panel[open] {
    border-radius: calc(0.85rem * var(--hud-scale));
    width: min(calc(18rem * var(--hud-scale)), calc(100vw - 2 * var(--hud-inset)));
    max-width: min(calc(18rem * var(--hud-scale)), calc(100vw - 2 * var(--hud-inset)));
  }

  .stage-panel__summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: calc(0.5rem * var(--hud-scale));
    width: var(--control-size);
    height: var(--control-size);
    min-width: var(--control-size);
    min-height: var(--control-size);
    cursor: pointer;
    padding: 0;
    margin: 0;
    color: var(--color-text);
    list-style: none;
    box-sizing: border-box;
    border-radius: inherit;
  }

  .stage-panel[open] .stage-panel__summary {
    justify-content: flex-start;
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: var(--control-size);
    padding: var(--stage-panel-inset);
    color: var(--color-accent-alt);
  }

  .stage-panel[open] .stage-panel__summary :global(.hud-icon) {
    filter: drop-shadow(
      0 0 calc(0.35rem * var(--hud-scale)) color-mix(in srgb, var(--color-accent) 55%, transparent)
    );
  }

  .stage-panel__summary::marker {
    content: '';
  }

  .stage-panel__summary::-webkit-details-marker {
    display: none;
  }

  .stage-panel__summary:hover {
    color: var(--color-accent-alt);
  }

  .stage-panel__label {
    font-family: var(--font-display);
    font-size: calc(18px * var(--hud-scale));
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: inherit;
    white-space: nowrap;
    min-width: 0;
  }

  html[data-hud-glitch='true'] .stage-panel__label {
    display: none;
  }

  html[data-hud-glitch='true'] .stage-panel[open] .stage-panel__label {
    display: block;
    text-shadow: 0 0 calc(0.35rem * var(--hud-scale))
      color-mix(in srgb, var(--color-accent) 55%, transparent);
  }

  html:not([data-hud-glitch='true']) .stage-panel[open] .stage-panel__label {
    text-shadow: 0 0 calc(0.35rem * var(--hud-scale))
      color-mix(in srgb, var(--color-accent) 55%, transparent);
  }

  .stage-panel__body {
    width: 100%;
    max-width: 100%;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    padding: 0 var(--stage-panel-inset);
    box-sizing: border-box;
    font-size: calc(0.9rem * var(--hud-scale));
    color: var(--color-text);
  }

  .stage-panel[open]:not(.is-panel-opening) .stage-panel__body {
    max-height: min(30svh, calc(11rem * var(--hud-scale)));
    opacity: 1;
    overflow: auto;
    pointer-events: auto;
    padding: 0 var(--stage-panel-inset) var(--stage-panel-inset);
  }

  .stage-panel.is-glitching[data-glitch='in'] .stage-panel__body {
    animation: stage-panel-body-in var(--g-dur, 560ms) both;
  }

  .stage-panel.is-glitching[data-glitch='out'] .stage-panel__body {
    animation: stage-panel-body-out 520ms both;
  }

  @keyframes stage-panel-body-in {
    0% {
      max-height: 0;
      opacity: 0;
      animation-timing-function: steps(1, end);
    }
    35% {
      max-height: min(30svh, calc(11rem * var(--hud-scale)));
      opacity: 1;
      animation-timing-function: steps(1, end);
    }
    100% {
      max-height: min(30svh, calc(11rem * var(--hud-scale)));
      opacity: 1;
    }
  }

  @keyframes stage-panel-body-out {
    0% {
      max-height: min(30svh, calc(11rem * var(--hud-scale)));
      opacity: 1;
      animation-timing-function: steps(1, end);
    }
    55% {
      max-height: var(--control-size);
      opacity: 0.4;
      animation-timing-function: steps(1, end);
    }
    100% {
      max-height: 0;
      opacity: 0;
    }
  }

  .stage-panel__body :global(p) {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-panel,
    .stage-panel__summary,
    .stage-panel__body,
    .stage-panel__label {
      transition: none !important;
    }

    .stage-panel.is-glitching,
    .stage-panel.is-glitching .stage-panel__body {
      animation: none !important;
    }
  }
</style>
