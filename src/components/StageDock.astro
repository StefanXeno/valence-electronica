---
---
<div class="stage-dock">
  <div class="stage-dock__left">
    <div class="stage-dock__cluster">
      <slot name="jukebox" />
    </div>
  </div>
  <div class="stage-dock__right">
    <slot name="panels" />
  </div>
</div>

<style>
  .stage-dock__cluster {
    display: flex;
    align-items: flex-end;
    gap: calc(0.35rem * var(--hud-scale));
    width: 100%;
  }

  @media (max-width: 1023px) {
    /* Do not set width: 100% here — left+right insets already stretch the
       fixed dock. width:100% + left:inset overflows by the inset (shears the
       right cap / mute). */
    .stage-dock {
      width: auto;
      max-width: 100%;
      box-sizing: border-box;
      overflow: visible;
    }

    .stage-dock__left,
    .stage-dock__right {
      width: auto;
      max-width: 100%;
      min-width: 0;
      box-sizing: border-box;
    }

    .stage-dock__cluster {
      width: 100%;
      max-width: 100%;
      min-width: 0;
    }
  }
</style>
