---

<script>
  import {
    createAmbientGlitchField,
    isAmbientGlitchTarget,
    isOpenStagePanelChrome,
  } from '../lib/glitch-ambient';
  import { isGlitchThemeActive, playElementGlitch } from '../lib/glitch';

  function prefersReducedMotion(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function isMorphOwned(el: Element): boolean {
    if (el.closest('[data-jukebox-option]')) return false;
    if (
      el.matches(
        '[data-shuffle-toggle][aria-pressed="true"], [data-loop-toggle][aria-pressed="true"]',
      )
    ) {
      return true;
    }
    // Toolbar / mute / vinyl / stage-panel shells own hover+press. Playlist
    // listen/play links inside the jukebox are regular one-shot hits.
    return (
      el.matches(
        '[data-mute-control], [data-volume-control], [data-jukebox-toggle], [data-stage-panel], [data-playlist-toggle], [data-shuffle-toggle], [data-loop-toggle], [data-bg-play-toggle]',
      ) || Boolean(el.closest('[data-volume-control]'))
    );
  }

  function isLiveToggle(el: Element): boolean {
    return el.matches(
      '[data-mute-control], [data-jukebox-toggle], [data-shuffle-toggle][aria-pressed="true"], [data-loop-toggle][aria-pressed="true"]',
    );
  }

  function runGlitch(el: HTMLElement, className: 'is-glitching' | 'is-glitch-hover') {
    if (prefersReducedMotion() || !isGlitchThemeActive()) return;

    // At most one active treatment: hover must not interrupt press or re-fire mid-hover
    if (className === 'is-glitch-hover') {
      if (el.classList.contains('is-glitching') || el.classList.contains('is-glitch-hover')) return;
      if (el.classList.contains('is-glitch-continuous')) return;
    }

    // Press supersedes in-flight hover; both supersede ambient idle
    if (className === 'is-glitching') {
      el.classList.remove('is-glitch-hover');
    }

    const dur = playElementGlitch(el, className);
    const onEnd = (event: AnimationEvent) => {
      if (event.target !== el) return;
      el.removeEventListener('animationend', onEnd);
      el.classList.remove(className);
    };
    el.addEventListener('animationend', onEnd);
    window.setTimeout(() => {
      el.removeEventListener('animationend', onEnd);
      el.classList.remove(className);
    }, dur + 80);
  }

  function bindGlitchPress() {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const ambient = createAmbientGlitchField();

    const clearAllGlitchClasses = () => {
      document
        .querySelectorAll('.is-glitching, .is-glitch-hover, .is-glitch-continuous, .is-glitch-ambient')
        .forEach((node) => {
          node.classList.remove(
            'is-glitching',
            'is-glitch-hover',
            'is-glitch-continuous',
            'is-glitch-ambient',
          );
        });
    };

    const syncAmbient = () => {
      if (reduceMotion.matches || !isGlitchThemeActive()) {
        ambient.stop();
        return;
      }
      ambient.start();
    };

    reduceMotion.addEventListener('change', () => {
      if (reduceMotion.matches) {
        clearAllGlitchClasses();
        ambient.stop();
        return;
      }
      syncAmbient();
    });

    new MutationObserver(() => {
      if (!isGlitchThemeActive()) {
        clearAllGlitchClasses();
        ambient.stop();
        return;
      }
      syncAmbient();
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme', 'data-hud-glitch'],
    });

    document.addEventListener(
      'pointerover',
      (event) => {
        if (prefersReducedMotion() || !isGlitchThemeActive()) return;
        const target = event.target;
        if (!(target instanceof Element)) return;
        const hit = target.closest('.glitch-hit');
        if (!(hit instanceof HTMLElement) || !isAmbientGlitchTarget(hit)) return;

        // Mute button continuous hover is owned by MuteControl
        if (isLiveToggle(hit) || isMorphOwned(hit)) return;
        if (isOpenStagePanelChrome(hit)) return;

        const related = event.relatedTarget;
        if (related instanceof Node && hit.contains(related)) return;

        runGlitch(hit, 'is-glitch-hover');
      },
      true,
    );

    document.addEventListener(
      'focusin',
      (event) => {
        if (prefersReducedMotion() || !isGlitchThemeActive()) return;
        const target = event.target;
        if (!(target instanceof HTMLElement) || !isAmbientGlitchTarget(target)) return;
        if (isOpenStagePanelChrome(target)) return;
        // Keyboard-visible focus only — mouse-click focus must not glitch
        if (!target.matches(':focus-visible')) return;
        runGlitch(target, 'is-glitch-hover');
      },
      true,
    );

    document.addEventListener(
      'pointerdown',
      (event) => {
        if (prefersReducedMotion() || !isGlitchThemeActive()) return;
        const target = event.target;
        if (!(target instanceof Element)) return;
        const hit = target.closest('.glitch-hit');
        if (!(hit instanceof HTMLElement) || !isAmbientGlitchTarget(hit)) return;
        // Morph-owned controls handle their own press / open-close glitch
        if (isMorphOwned(hit)) return;
        if (isOpenStagePanelChrome(hit)) return;
        runGlitch(hit, 'is-glitching');
      },
      true,
    );

    syncAmbient();
  }

  bindGlitchPress();
</script>
