---
import '../styles/stage-card.css';
import { formatShowLocality, getUpcomingShows, groupShowsByYear, type UiChrome } from '../lib/stage';
import HudIcon from './HudIcon.astro';

interface Props {
  chrome: UiChrome;
}

const { chrome } = Astro.props;
const shows = await getUpcomingShows();
const yearGroups = groupShowsByYear(shows);
const dateFmt = new Intl.DateTimeFormat('en-GB', {
  timeZone: 'Europe/Berlin',
  day: 'numeric',
  month: 'short',
});
---

{
  yearGroups.length === 0 ? (
    <p class="tour__empty">{chrome.emptyShows}</p>
  ) : (
    <div class="tour">
      {yearGroups.map(({ year, shows: yearShows }) => (
        <section class="tour__year" aria-labelledby={`tour-year-${year}`}>
          <h3 class="tour__year-label" id={`tour-year-${year}`}>
            {year}
          </h3>
          <ul class="tour__list">
            {yearShows.map((show) => {
              const dateLabel = dateFmt.format(show.date);
              const locality = formatShowLocality(show.city, show.country);
              const eventNode = show.eventUrl ? (
                <a
                  class="tour__event-link stage-card__title"
                  href={show.eventUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {show.title}
                </a>
              ) : (
                <span class="stage-card__title">{show.title}</span>
              );
              const venueNode = show.venueUrl ? (
                <a
                  class="tour__venue-link"
                  href={show.venueUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {show.venue}
                </a>
              ) : (
                show.venue
              );
              return (
                <li class="stage-card tour__card">
                  <div class="stage-card__head tour__head">
                    <div class="stage-card__meta tour__when">
                      <time datetime={show.date.toISOString().slice(0, 10)}>{dateLabel}</time>
                      <p class="tour__place">{locality}</p>
                    </div>
                    <div class="tour__event-block">
                      {eventNode}
                      <p class="tour__venue">{venueNode}</p>
                    </div>
                  </div>
                  {show.ticketUrl && (
                    <div class="stage-card__footer">
                      <a
                        class="stage-card__pill glitch-hit"
                        href={show.ticketUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={chrome.ticketLabel}
                        data-hud-label={chrome.ticketLabel}
                        data-hud-label-anchor="above"
                      >
                        <HudIcon token="ticket" />
                        <span>{chrome.ticketLabel}</span>
                      </a>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  )
}

<style>
  .tour {
    --discog-row-gap: calc(0.75rem * var(--hud-scale));
    display: flex;
    flex-direction: column;
    gap: calc(1.35rem * var(--hud-scale));
  }

  .tour__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--discog-row-gap);
  }

  .tour__year-label {
    margin: 0 0 calc(0.55rem * var(--hud-scale));
    font-family: var(--font-display);
    font-size: calc(0.72rem * var(--hud-scale));
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .tour__empty {
    margin: 0;
    color: var(--color-text-muted);
    font-size: calc(0.8rem * var(--hud-scale));
  }

  .tour__card {
    display: flex;
    flex-direction: column;
    /* Rule spacing lives on the footer (margin-top = padding-top). */
    gap: 0;
  }

  /* Date column + title/venue block share the same top edge. */
  .tour__head {
    display: grid;
    grid-template-columns: minmax(4.5rem, auto) minmax(0, 1fr);
    column-gap: calc(0.85rem * var(--hud-scale));
    align-items: start;
  }

  .tour__when {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
  }

  .tour__event-block {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    min-width: 0;
  }

  .tour__event-block :global(.stage-card__title),
  .tour__event-block :global(.tour__event-link) {
    font-size: calc(0.88rem * var(--hud-scale));
    line-height: 1.35;
    text-transform: none;
  }

  .tour__venue {
    margin: 0;
    font-size: calc(0.78rem * var(--hud-scale));
    line-height: 1.35;
    color: var(--color-text-muted);
  }

  .tour__place {
    margin: 0;
    font-size: 0.88em;
    color: #fff;
  }

  .tour__event-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-text-muted) 65%, transparent);
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  .tour__event-link:hover,
  .tour__event-link:focus-visible {
    color: var(--color-accent-alt);
    text-decoration-color: color-mix(in srgb, var(--color-accent-alt) 75%, transparent);
    outline: none;
  }

  .tour__venue-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-text-muted) 55%, transparent);
    text-underline-offset: 0.15em;
  }

  .tour__venue-link:hover,
  .tour__venue-link:focus-visible {
    color: var(--color-accent-alt);
    text-decoration-color: color-mix(in srgb, var(--color-accent-alt) 70%, transparent);
    outline: none;
  }
</style>
