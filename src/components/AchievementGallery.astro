---
/**
 * Achievement gallery (036): trophy toggle bottom-right + dialog with one tile per achievement.
 * Driven by `src/lib/achievement-gallery.ts`; unlock state is client-side only.
 *
 * Secret tiles ship with the placeholder only — their copy is filled from the obfuscated
 * registry payload after unlock, so it never sits in the HTML.
 */
import { ACHIEVEMENT_GLYPHS } from '../lib/achievements';
import { loadAchievementRegistry } from '../lib/achievements-registry';
import { getChrome } from '../lib/stage';
import { isPreviewBuild } from '../lib/url';
import AchievementGlyph from './AchievementGlyph.astro';
import HudIcon from './HudIcon.astro';

const chrome = await getChrome();
const achievements = loadAchievementRegistry();
const showReset = import.meta.env.DEV || isPreviewBuild();
---

<div
  class="achievement-dock"
  data-achievement-gallery
  data-gallery-state="closed"
  data-counter-template={chrome.achievementsCounter}
>
  {/* Mirrors V-Flip: the panel grows out of the trophy corner (bottom-right). */}
  <section
    id="achievement-gallery"
    class="achievement-dock__panel"
    data-achievement-panel
    role="dialog"
    aria-labelledby="achievement-gallery-title"
    inert
  >
    <header class="achievement-dock__header">
      <p class="achievement-dock__eyebrow" id="achievement-gallery-title">
        {chrome.achievementsTitle}
      </p>
      <div class="achievement-dock__actions">
        {
          showReset && (
            <button
              type="button"
              class="achievement-dock__icon-btn glitch-hit"
              data-achievement-reset
              aria-label={chrome.achievementsResetLabel}
              title={chrome.achievementsResetLabel}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3M4.5 4.5v3.6h3.6"
                />
              </svg>
            </button>
          )
        }
        <button
          type="button"
          class="achievement-dock__icon-btn glitch-hit"
          data-achievement-gallery-close
          aria-label={chrome.achievementsCloseLabel}
          title={chrome.achievementsCloseLabel}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              d="M6 6l12 12M18 6 6 18"
            />
          </svg>
        </button>
      </div>
    </header>

    <ol class="achievement-dock__tiles">
      {
        achievements.map((achievement) => (
          <li
            class="achievement-tile"
            data-achievement-tile={achievement.id}
            data-tile-kind={achievement.secret ? 'secret' : 'locked'}
          >
            {achievement.secret ? (
              <div class="achievement-tile__variant" data-variant="secret">
                <span class="achievement-tile__glyph achievement-tile__glyph--locked" aria-hidden="true">
                  ?
                </span>
                <span class="achievement-tile__copy">
                  <span class="achievement-tile__title achievement-tile__title--locked">
                    {chrome.achievementSecretTitle}
                  </span>
                </span>
              </div>
            ) : (
              <>
                <div class="achievement-tile__variant" data-variant="unlocked" hidden>
                  <span class="achievement-tile__glyph" aria-hidden="true">
                    <AchievementGlyph glyph={achievement.glyph} />
                  </span>
                  <span class="achievement-tile__copy">
                    <span class="achievement-tile__title">{achievement.title}</span>
                    <span class="achievement-tile__sub">{achievement.subtitle}</span>
                  </span>
                </div>
                <div class="achievement-tile__variant" data-variant="locked">
                  <span class="achievement-tile__glyph achievement-tile__glyph--locked" aria-hidden="true">
                    ?
                  </span>
                  <span class="achievement-tile__copy">
                    <span class="achievement-tile__title achievement-tile__title--locked">
                      {chrome.achievementLockedTitle}
                    </span>
                    <span class="achievement-tile__sub">{achievement.hint}</span>
                  </span>
                </div>
              </>
            )}
          </li>
        ))
      }
    </ol>

    {/* Bottom row: progress on the left, the trophy's home slot on the right. */}
    <div class="achievement-dock__footer">
      <p class="achievement-dock__counter" data-achievement-counter aria-live="polite"></p>
    </div>
  </section>

  <button
    type="button"
    class="achievement-dock__toggle glitch-hit"
    data-achievement-toggle
    aria-label={chrome.achievementsLabel}
    title={chrome.achievementsLabel}
    aria-haspopup="dialog"
    aria-controls="achievement-gallery"
    aria-expanded="false"
    hidden
  >
    <span class="achievement-dock__trophy">
      <HudIcon token={chrome.achievementsIcon} emoji={chrome.achievementsIconEmoji} />
    </span>
  </button>

  {/* Filled client-side for unlocked secret achievements. */}
  <template data-achievement-unlocked-template>
    <div class="achievement-tile__variant" data-variant="unlocked">
      <span class="achievement-tile__glyph" aria-hidden="true" data-slot="glyph"></span>
      <span class="achievement-tile__copy">
        <span class="achievement-tile__title" data-slot="title"></span>
        <span class="achievement-tile__sub" data-slot="subtitle"></span>
      </span>
    </div>
  </template>
  {
    ACHIEVEMENT_GLYPHS.map((glyph) => (
      <template data-achievement-glyph={glyph}>
        <AchievementGlyph glyph={glyph} />
      </template>
    ))
  }
</div>

<style>
  /* Same geometry tokens as the stage player (StagePlayer.astro), mirrored to the right. */
  .achievement-dock {
    --dock-gap: var(--stage-corner-gap, 0.3rem);
    --dock-toggle-size: var(--control-size);
    --dock-radius: calc(0.85rem * var(--hud-scale));
    --dock-pad: calc(0.65rem * var(--hud-scale));
    --dock-toggle-right: calc(var(--dock-pad) + 1px);
    --dock-toggle-bottom: calc(var(--dock-pad) + 1px);
    --dock-ease: cubic-bezier(0.4, 0, 0.2, 1);
    --dock-dur: 280ms;

    position: fixed;
    right: var(--dock-gap);
    bottom: var(--dock-gap);
    /* Below the stage player (z=3): an open V-Flip panel covers the trophy on phones. */
    z-index: 2;
    font-family: var(--font-display);
    pointer-events: none;
  }

  :global(html[data-intro-pending]) .achievement-dock,
  :global(html[data-intro-active]) .achievement-dock {
    display: none;
  }

  /* —— Trophy (resting home = bottom-right slot of the panel's footer row) —— */

  .achievement-dock__toggle {
    position: absolute;
    right: var(--dock-toggle-right);
    bottom: var(--dock-toggle-bottom);
    z-index: 1;
    appearance: none;
    display: grid;
    place-items: center;
    width: var(--dock-toggle-size);
    height: var(--dock-toggle-size);
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(10px);
    color: var(--color-text);
    cursor: pointer;
    pointer-events: auto;
    box-shadow: 0 0.4rem 1.2rem color-mix(in srgb, black 40%, transparent);
    transition:
      box-shadow var(--dock-dur) var(--dock-ease),
      border-color 160ms ease,
      color 160ms ease;
  }

  .achievement-dock__toggle[hidden] {
    display: none;
  }

  .achievement-dock__toggle:hover,
  .achievement-dock__toggle[aria-expanded='true'] {
    border-color: var(--color-accent);
    color: var(--color-accent-alt);
  }

  .achievement-dock__toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* Trophy fills the button like the vinyl disc does. */
  .achievement-dock__trophy {
    display: grid;
    place-items: center;
    width: 58%;
    height: 58%;
  }

  .achievement-dock__trophy :global(.hud-icon) {
    width: 100%;
    height: 100%;
  }

  .achievement-dock__toggle.is-pulse {
    animation: achievement-toggle-pulse 900ms ease-out;
  }

  .achievement-dock[data-gallery-state='open'] .achievement-dock__toggle {
    box-shadow: 0 0 0 transparent;
  }

  /* —— Panel (open only) —— */

  .achievement-dock__panel {
    display: flex;
    flex-direction: column;
    gap: calc(0.55rem * var(--hud-scale));
    width: min(calc(19.5rem * var(--hud-scale)), calc(100vw - 2 * var(--dock-gap)));
    max-height: min(calc(36rem * var(--hud-scale)), calc(var(--viewport-h) - 4.5rem));
    padding: var(--dock-pad);
    box-sizing: border-box;
    border: 1px solid var(--color-border);
    border-radius: var(--dock-radius);
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(10px);
    color: var(--color-text);
    box-shadow: 0 0.6rem 1.6rem color-mix(in srgb, black 45%, transparent);
    transform-origin: bottom right;
    transition:
      opacity var(--dock-dur) var(--dock-ease),
      transform var(--dock-dur) var(--dock-ease),
      visibility 0s linear var(--dock-dur);
  }

  /* Closed panel reserves no layout; it grows out of the trophy corner. */
  .achievement-dock[data-gallery-state='closed'] .achievement-dock__panel {
    position: absolute;
    right: 0;
    bottom: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.75rem) scale(0.97);
    pointer-events: none;
  }

  .achievement-dock[data-gallery-state='open'] .achievement-dock__panel {
    position: relative;
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
    transition-delay: 0s;
  }

  /* Glitch packs: no smooth slide, the shared one-shot glitch plays instead (gallery.ts). */
  :global(html[data-hud-glitch='true']) .achievement-dock__panel {
    transform: none;
    transition: visibility 0s linear var(--dock-dur);
  }

  :global(html[data-hud-glitch='true']) .achievement-dock[data-gallery-state='open'] .achievement-dock__panel {
    transition: none;
  }

  .achievement-dock__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .achievement-dock__eyebrow {
    margin: 0;
    font-size: calc(0.6rem * var(--hud-scale));
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-alt);
  }

  .achievement-dock__actions {
    display: flex;
    gap: 0.25rem;
  }

  .achievement-dock__icon-btn {
    appearance: none;
    display: grid;
    place-items: center;
    width: calc(1.9rem * var(--hud-scale));
    height: calc(1.9rem * var(--hud-scale));
    margin: 0;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .achievement-dock__icon-btn svg {
    width: 55%;
    height: 55%;
  }

  .achievement-dock__icon-btn:hover {
    border-color: var(--color-accent);
  }

  .achievement-dock__icon-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .achievement-dock__tiles {
    display: grid;
    gap: calc(0.35rem * var(--hud-scale));
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow: auto;
    list-style: none;
  }

  /* Footer row: counter left, trophy slot right (the toggle sits on top of the slot). */
  .achievement-dock__footer {
    display: flex;
    align-items: center;
    min-height: var(--dock-toggle-size);
    padding-right: calc(var(--dock-toggle-size) + 0.5rem);
    border-top: 1px solid color-mix(in srgb, var(--color-border) 45%, transparent);
    padding-top: calc(0.45rem * var(--hud-scale));
  }

  .achievement-dock__counter {
    margin: 0;
    font-size: calc(0.9rem * var(--hud-scale));
    font-weight: 600;
    line-height: 1.2;
  }

  .achievement-tile__variant {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    padding: 0.5rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    border-radius: 0.55rem;
    background: color-mix(in srgb, var(--color-bg) 40%, transparent);
  }

  .achievement-tile__variant[hidden] {
    display: none;
  }

  .achievement-tile[data-tile-kind='unlocked'] .achievement-tile__variant {
    border-left: 3px solid var(--color-accent);
  }

  .achievement-tile__glyph {
    display: grid;
    place-items: center;
    width: calc(2rem * var(--hud-scale));
    height: calc(2rem * var(--hud-scale));
    color: var(--color-accent-alt);
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, var(--color-accent));
    border-radius: 0.45rem;
    background: color-mix(in srgb, var(--color-bg) 55%, transparent);
  }

  .achievement-tile__glyph :global(.hud-icon) {
    width: 62%;
    height: 62%;
  }

  .achievement-tile__glyph--locked {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text-muted);
    border-style: dashed;
  }

  .achievement-tile__copy {
    min-width: 0;
    display: grid;
    gap: 0.15rem;
  }

  .achievement-tile__title {
    font-family: var(--font-display);
    font-size: calc(0.7rem * var(--hud-scale));
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  .achievement-tile__title--locked {
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
  }

  .achievement-tile__sub {
    font-size: calc(0.6rem * var(--hud-scale));
    line-height: 1.35;
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  @keyframes achievement-toggle-pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 70%, transparent);
    }
    100% {
      box-shadow: 0 0 0 1.1rem color-mix(in srgb, var(--color-accent) 0%, transparent);
    }
  }

  /* —— Phone: same structure as the V-Flip phone layout —— */

  @media (max-width: 1023px) {
    .achievement-dock {
      --dock-toggle-size: 4.25rem;
      left: var(--dock-gap);
      bottom: calc(var(--dock-gap) + env(safe-area-inset-bottom, 0px));
    }

    .achievement-dock__panel {
      width: 100%;
    }

    .achievement-dock[data-gallery-state='closed'] .achievement-dock__panel {
      left: 0;
    }

    .achievement-tile__title {
      font-size: 1.05rem;
    }

    .achievement-tile__sub {
      font-size: 0.9rem;
    }

    .achievement-dock__counter {
      font-size: 1.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .achievement-dock__panel {
      transition: none;
    }

    .achievement-dock__toggle.is-pulse {
      animation: none;
    }
  }
</style>
