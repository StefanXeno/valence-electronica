---
/**
 * Achievement marks (036), shared by the toast and the gallery tiles.
 * Renders only the mark; the caller provides the framed slot around it.
 */
import type { AchievementGlyph } from '../lib/achievements';
import HudIcon from './HudIcon.astro';

interface Props {
  glyph: AchievementGlyph;
}

const { glyph } = Astro.props;
---

{
  glyph === 'vinyl' ? (
    /* Same vinyl mark as the stage player. */
    <HudIcon token="jukebox" />
  ) : glyph === 'infinite' ? (
    <svg class="hud-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="1.85"
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M6.2 12c0-2.1 1.55-3.7 3.3-3.7 1.55 0 2.7.95 4.5 3.7 1.8 2.75 2.95 3.7 4.5 3.7 1.75 0 3.3-1.6 3.3-3.7s-1.55-3.7-3.3-3.7c-1.55 0-2.7.95-4.5 3.7-1.8 2.75-2.95 3.7-4.5 3.7-1.75 0-3.3-1.6-3.3-3.7z"
      />
    </svg>
  ) : glyph === 'demonic' ? (
    <span class="achievement-glyph__text">666</span>
  ) : (
    /* `</>` — angle brackets around a slash. */
    <svg class="hud-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="1.85"
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M8 7.5 3.5 12 8 16.5M16 7.5l4.5 4.5-4.5 4.5M13.6 5.5l-3.2 13"
      />
    </svg>
  )
}

<style>
  .achievement-glyph__text {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
  }
</style>
