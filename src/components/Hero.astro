---
import site from '../data/site.json';
import { withBase } from '../lib/url';
import { formatTagline, loadTaglinePool, validateTaglinePool } from '../lib/tagline-pool';

const { name, tagline } = site.artist;
validateTaglinePool(loadTaglinePool());

const wordmarkSrc = withBase('/images/brand/valence-wordmark.webp');
const wordmarkFallback = withBase('/images/brand/valence-wordmark.png');
const fallbackTagline = formatTagline(tagline.trim());
---

<section class="identity" aria-label={name}>
  <h1 class="identity__name glitch-hit">
    <picture>
      <source srcset={wordmarkSrc} type="image/webp" />
      <img
        class="identity__wordmark"
        src={wordmarkFallback}
        alt={name}
        width="960"
        height="362"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
  </h1>
  <p
    class="tagline glitch-hit"
    data-tagline-root
    data-tagline-fallback={fallbackTagline}
  >
    {fallbackTagline}
  </p>
</section>

<script>
  import { initTaglineRotator } from '../lib/tagline-rotator';

  const root = document.querySelector('[data-tagline-root]');
  if (root instanceof HTMLElement) {
    const fallback = root.dataset.taglineFallback ?? root.textContent ?? '';
    initTaglineRotator(root, fallback);
  }
</script>

<style>
  .identity {
    text-shadow: 0 1px 16px var(--bg-scrim);
  }

  .identity__name {
    margin: 0;
    line-height: 0;
  }

  .identity__wordmark {
    display: block;
    width: min(calc(14rem * var(--hud-scale)), 72vw);
    height: auto;
  }

  .tagline {
    margin: 0.35em 0 0;
    font-family: var(--font-display);
    font-size: clamp(calc(0.75rem * var(--hud-scale)), 3.6vw, calc(0.95rem * var(--hud-scale)));
    color: var(--color-accent-alt);
    white-space: nowrap;
  }
</style>
