---
import '../styles/stage-card.css';
import { formatShowLocality, getUpcomingShows, groupShowsByYear, type UiChrome } from '../lib/stage';
import HudIcon from './HudIcon.astro';

interface Props {
  chrome: UiChrome;
}

const { chrome } = Astro.props;
const shows = await getUpcomingShows();
const yearGroups = groupShowsByYear(shows);
const dateFmt = new Intl.DateTimeFormat('en-GB', {
  timeZone: 'Europe/Berlin',
  day: 'numeric',
  month: 'short',
});
---

{
  yearGroups.length === 0 ? (
    <p class="tour__empty">{chrome.emptyShows}</p>
  ) : (
    <div class="tour">
      {yearGroups.map(({ year, shows: yearShows }) => (
        <section class="tour__year" aria-labelledby={`tour-year-${year}`}>
          <h3 class="tour__year-label" id={`tour-year-${year}`}>
            {year}
          </h3>
          <ul class="tour__list">
            {yearShows.map((show) => {
              const dateLabel = dateFmt.format(show.date);
              const locality = formatShowLocality(show.city, show.country);
              const eventNode = show.eventUrl ? (
                <a
                  class="tour__event tour__event-link"
                  href={show.eventUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {show.title}
                </a>
              ) : (
                <span class="tour__event">{show.title}</span>
              );
              const venueNode = show.venueUrl ? (
                <a
                  class="tour__venue-link"
                  href={show.venueUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {show.venue}
                </a>
              ) : (
                show.venue
              );
              return (
                <li class="tour__row">
                  <div class="tour__when">
                    <time class="tour__date" datetime={show.date.toISOString().slice(0, 10)}>
                      {dateLabel}
                    </time>
                    <p class="tour__place">{locality}</p>
                  </div>
                  <div class="tour__event-block">
                    {eventNode}
                    <p class="tour__venue">{venueNode}</p>
                  </div>
                  {show.ticketUrl && (
                    <a
                      class="stage-card__pill tour__ticket glitch-hit"
                      href={show.ticketUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={chrome.ticketLabel}
                      data-hud-label={chrome.ticketLabel}
                      data-hud-label-anchor="above"
                    >
                      <HudIcon token="ticket" />
                      <span>{chrome.ticketLabel}</span>
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  )
}

<style>
  /* Same list language as the phone menu's tour portal: rows with hairlines, no cards. */
  .tour {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .tour__year-label {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .tour__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid color-mix(in srgb, #fff 12%, transparent);
  }

  /* Fixed date column, so every title starts on the same edge. */
  .tour__row {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr) auto;
    column-gap: 1.5rem;
    align-items: center;
    padding: 1.1rem 0;
    border-bottom: 1px solid color-mix(in srgb, #fff 12%, transparent);
  }

  .tour__when,
  .tour__event-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .tour__date {
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    line-height: 1.3;
    text-transform: uppercase;
    color: color-mix(in srgb, #fff 55%, transparent);
  }

  .tour__place {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.3;
    color: color-mix(in srgb, #fff 88%, transparent);
  }

  .tour__event {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.3;
    color: color-mix(in srgb, #fff 92%, transparent);
  }

  .tour__venue {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.35;
    color: color-mix(in srgb, #fff 55%, transparent);
  }

  .tour__empty {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  .tour__event-link {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, #fff 35%, transparent);
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .tour__event-link:hover,
  .tour__event-link:focus-visible {
    color: var(--color-accent-alt);
    text-decoration-color: color-mix(in srgb, var(--color-accent-alt) 75%, transparent);
    outline: none;
  }

  .tour__venue-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, #fff 25%, transparent);
    text-underline-offset: 0.15em;
  }

  .tour__venue-link:hover,
  .tour__venue-link:focus-visible {
    color: var(--color-accent-alt);
    text-decoration-color: color-mix(in srgb, var(--color-accent-alt) 70%, transparent);
    outline: none;
  }

  /* Phone sheet (deep links): date stacks above the event, ticket stays on the right. */
  @media (max-width: 1023px) {
    .tour__row {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: 0.45rem;
      column-gap: 1rem;
    }

    .tour__when {
      grid-column: 1;
    }

    .tour__event-block {
      grid-column: 1;
    }

    .tour__ticket {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
