---
import { getMergedDiscography } from '../lib/catalog-tracks';
import { getValidJukeboxEntries } from '../lib/background';
import type { UiChrome } from '../lib/stage';
import ChannelIcon from './ChannelIcon.astro';

interface Props {
  chrome: UiChrome;
  defaultId: string;
}

const { chrome, defaultId } = Astro.props;
const videos = await getValidJukeboxEntries();
const validIds = new Set(videos.map((entry) => entry.id));
const releases = await getMergedDiscography(validIds);
---

{
  releases.length === 0 ? (
    <p class="discog__empty">{chrome.emptyReleases}</p>
  ) : (
    <ul class="discog">
      {releases.map((release) => {
        const onStage = Boolean(release.jukeboxId);
        const stageId = release.jukeboxId;
        const isActive = stageId === defaultId;
        return (
          <li
            class="discog__item"
            data-discog-item={stageId}
            data-discog-active={isActive ? 'true' : undefined}
          >
            <div class="discog__head">
              <div class="discog__meta">
                <span class="discog__title">{release.title}</span>
                <span class="discog__year">
                  {release.year}
                  {release.kind ? ` · ${release.kind}` : ''}
                </span>
              </div>
              {onStage && stageId && (
                <div class="discog__stage-slot">
                  <button
                    type="button"
                    class="discog__stage"
                    data-stage-button={stageId}
                    aria-pressed={isActive ? 'true' : 'false'}
                    aria-label={`${chrome.stageButtonLabel}: ${release.title}`}
                    hidden={isActive}
                  >
                    {chrome.stageButtonLabel}
                  </button>
                  <span
                    class="discog__now-playing"
                    data-discog-playing={stageId}
                    role="status"
                    hidden={!isActive}
                  >
                    <span class="discog__eq" aria-hidden="true">
                      <span />
                      <span />
                      <span />
                    </span>
                    {chrome.currentlyPlayingLabel}
                  </span>
                </div>
              )}
            </div>
            {release.listenLinks.length > 0 && (
              <div class="discog__listen">
                <span class="discog__listen-label">{chrome.listenOnLabel}</span>
                <ul class="discog__listen-links">
                  {release.listenLinks.map((link) => (
                    <li>
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={link.label}
                        data-hud-label={link.label}
                        data-hud-label-anchor="above"
                      >
                        <ChannelIcon id={link.platform} label={link.label} />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        );
      })}
    </ul>
  )
}

<style>
  .discog {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: calc(0.75rem * var(--hud-scale));
  }

  .discog__empty {
    margin: 0;
    color: var(--color-text-muted);
    font-size: calc(0.8rem * var(--hud-scale));
  }

  .discog__item {
    display: flex;
    flex-direction: column;
    gap: calc(0.55rem * var(--hud-scale));
    padding: calc(0.7rem * var(--hud-scale)) calc(0.75rem * var(--hud-scale));
    border: 1px solid color-mix(in srgb, var(--color-border) 85%, transparent);
    border-radius: calc(0.6rem * var(--hud-scale));
    background: color-mix(in srgb, var(--color-bg) 22%, transparent);
    min-width: 0;
    transition:
      border-color 200ms ease,
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  .discog__item[data-discog-active='true'] {
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-text) 6%, transparent);
  }

  .discog__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: calc(0.5rem * var(--hud-scale)) calc(0.75rem * var(--hud-scale));
  }

  .discog__meta {
    display: flex;
    flex-direction: column;
    gap: calc(0.2rem * var(--hud-scale));
    min-width: 0;
    flex: 1 1 8rem;
  }

  .discog__title {
    font-family: var(--font-display);
    font-size: calc(0.88rem * var(--hud-scale));
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.25;
    color: var(--color-text);
  }

  .discog__item[data-discog-active='true'] .discog__title {
    color: var(--color-accent-alt);
  }

  .discog__year {
    font-size: calc(0.78rem * var(--hud-scale));
    color: var(--color-text-muted);
  }

  .discog__stage-slot {
    flex: 0 0 auto;
    align-self: center;
    min-width: 0;
  }

  .discog__stage {
    appearance: none;
    margin: 0;
    padding: calc(0.35em * var(--hud-scale)) calc(0.65em * var(--hud-scale));
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: calc(0.72rem * var(--hud-scale));
    cursor: pointer;
    white-space: nowrap;
  }

  .discog__stage:hover {
    border-color: var(--color-accent);
  }

  .discog__stage[hidden],
  .discog__now-playing[hidden] {
    display: none;
  }

  .discog__now-playing {
    display: inline-flex;
    align-items: center;
    gap: calc(0.4rem * var(--hud-scale));
    padding: calc(0.35em * var(--hud-scale)) calc(0.65em * var(--hud-scale));
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    color: var(--color-accent-alt);
    font-family: var(--font-display);
    font-size: calc(0.72rem * var(--hud-scale));
    font-weight: 600;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .discog__eq {
    display: inline-flex;
    align-items: flex-end;
    gap: calc(0.12rem * var(--hud-scale));
    height: calc(0.85rem * var(--hud-scale));
  }

  .discog__eq span {
    display: block;
    width: calc(0.14rem * var(--hud-scale));
    height: 100%;
    border-radius: 999px;
    background: currentColor;
    transform-origin: bottom center;
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: no-preference) {
    .discog__eq span {
      animation: discog-eq 0.85s ease-in-out infinite;
    }

    .discog__eq span:nth-child(2) {
      animation-delay: 0.12s;
    }

    .discog__eq span:nth-child(3) {
      animation-delay: 0.24s;
    }
  }

  @keyframes discog-eq {
    0%,
    100% {
      transform: scaleY(0.3);
    }

    50% {
      transform: scaleY(1);
    }
  }

  .discog__listen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(0.45rem * var(--hud-scale));
    padding-top: calc(0.55rem * var(--hud-scale));
    border-top: 1px solid color-mix(in srgb, var(--color-border) 40%, transparent);
    min-width: 0;
  }

  .discog__listen-label {
    font-family: var(--font-display);
    font-size: calc(0.58rem * var(--hud-scale));
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent-alt);
    opacity: 0.75;
    flex: 0 0 auto;
  }

  .discog__listen-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: inline-flex;
    flex-flow: row wrap;
    align-items: center;
    gap: calc(0.35rem * var(--hud-scale));
  }

  .discog__listen-links li {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .discog__listen-links a {
    display: inline-grid;
    place-items: center;
    width: calc(1.75rem * var(--hud-scale));
    height: calc(1.75rem * var(--hud-scale));
    border: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
    border-radius: 999px;
    color: var(--color-text-muted);
    background: color-mix(in srgb, var(--color-bg) 30%, transparent);
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .discog__listen-links a:hover {
    color: var(--color-accent-alt);
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .discog__listen-links :global(.channel-icon) {
    width: calc(1rem * var(--hud-scale));
    height: calc(1rem * var(--hud-scale));
  }
</style>
