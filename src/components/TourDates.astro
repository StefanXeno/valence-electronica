---
import '../styles/stage-card.css';
import { getUpcomingShows, groupShowsByYear, resolveShowTitle, type UiChrome } from '../lib/stage';
import HudIcon from './HudIcon.astro';

interface Props {
  chrome: UiChrome;
}

const { chrome } = Astro.props;
const shows = await getUpcomingShows();
const yearGroups = groupShowsByYear(shows);
const dateFmt = new Intl.DateTimeFormat('en-GB', {
  timeZone: 'Europe/Berlin',
  day: 'numeric',
  month: 'short',
});
---

{
  yearGroups.length === 0 ? (
    <p class="tour__empty">{chrome.emptyShows}</p>
  ) : (
    <div class="tour">
      {yearGroups.map(({ year, shows: yearShows }) => (
        <section class="tour__year" aria-labelledby={`tour-year-${year}`}>
          <h3 class="tour__year-label" id={`tour-year-${year}`}>
            {year}
          </h3>
          <ul class="tour__list">
            {yearShows.map((show) => {
              const eventTitle = resolveShowTitle(show.title, show.venue);
              const dateLabel = dateFmt.format(show.date);
              return (
                <li class="stage-card tour__card">
                  <div class="stage-card__head">
                    <span class="stage-card__title">{eventTitle}</span>
                    <p class="stage-card__meta">
                      <time datetime={show.date.toISOString().slice(0, 10)}>{dateLabel}</time>
                      {' · '}
                      {show.city}
                    </p>
                  </div>
                  {(show.ticketUrl || show.venueUrl) && (
                    <div class="stage-card__footer">
                      {show.ticketUrl && (
                        <a
                          class="stage-card__pill glitch-hit"
                          href={show.ticketUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={chrome.ticketLabel}
                          data-hud-label={chrome.ticketLabel}
                          data-hud-label-anchor="above"
                        >
                          <HudIcon token="ticket" />
                          <span>{chrome.ticketLabel}</span>
                        </a>
                      )}
                      {show.venueUrl && (
                        <a
                          class="stage-card__pill glitch-hit"
                          href={show.venueUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={chrome.venueInfoLabel}
                          data-hud-label={chrome.venueInfoLabel}
                          data-hud-label-anchor="above"
                        >
                          <HudIcon token="info" />
                          <span>{chrome.venueInfoLabel}</span>
                        </a>
                      )}
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  )
}

<style>
  .tour {
    --discog-row-gap: calc(0.75rem * var(--hud-scale));
    display: flex;
    flex-direction: column;
    gap: calc(1.35rem * var(--hud-scale));
  }

  .tour__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--discog-row-gap);
  }

  .tour__year-label {
    margin: 0 0 calc(0.55rem * var(--hud-scale));
    font-family: var(--font-display);
    font-size: calc(0.72rem * var(--hud-scale));
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .tour__empty {
    margin: 0;
    color: var(--color-text-muted);
    font-size: calc(0.8rem * var(--hud-scale));
  }

  .tour__card {
    display: flex;
    flex-direction: column;
    /* Rule spacing lives on the footer (margin-top = padding-top). */
    gap: 0;
  }
</style>
