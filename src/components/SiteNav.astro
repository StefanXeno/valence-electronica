      transform var(--portal-fade) cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear var(--portal-fade);
    will-change: opacity, filter, transform;
  }

  .site-nav.is-portal-open .site-nav__menu-portal {
    opacity: 1;
    filter: blur(0);
    transform: none;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity var(--portal-fade) cubic-bezier(0.22, 1, 0.36, 1),
      filter var(--portal-fade) cubic-bezier(0.22, 1, 0.36, 1),
      transform var(--portal-fade) cubic-bezier(0.22, 1, 0.36, 1),
