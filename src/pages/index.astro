---
import Base from '../layouts/Base.astro';
import Channels from '../components/Channels.astro';
import Jukebox from '../components/Jukebox.astro';
import StagePanels from '../components/StagePanels.astro';
import StageDock from '../components/StageDock.astro';
import SiteNav from '../components/SiteNav.astro';
import LandingIntro from '../components/LandingIntro.astro';
import { getChrome } from '../lib/stage';

const chrome = await getChrome();
---

<Base>
  <LandingIntro introLead={chrome.introLead} introName={chrome.introName} />
  <SiteNav chrome={chrome} />
  <div class="stage" id="stage">
    {/* Brand lives in SiteNav; no tagline/subtext under the logo (020 feedback). */}
    <div class="stage__socials" id="stage-socials">
      <Channels />
    </div>
    <StageDock>
      <Jukebox slot="jukebox" />
      <StagePanels slot="panels" />
    </StageDock>
  </div>
</Base>
