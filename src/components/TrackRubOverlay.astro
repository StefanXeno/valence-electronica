---
/**
 * Secret full-view for rubbable catalog entries.
 * Reuses LegalPanel chrome language (frame, exit, prose body) without History URL changes.
 */
import { getCollection, render } from 'astro:content';
import { parseCredits, pickArtistName } from '../lib/catalog-tracks';
import site from '../data/site.json';
import HudIcon from './HudIcon.astro';

type RubPanel = {
  id: string;
  title: string;
  artist?: string;
  Content: Awaited<ReturnType<typeof render>>['Content'];
};

const [jukeboxRaw, tracksRaw] = await Promise.all([
  getCollection('jukebox'),
  getCollection('tracks'),
]);

const panels: RubPanel[] = [];
const seen = new Set<string>();

for (const entry of [...jukeboxRaw, ...tracksRaw]) {
  if (entry.id.startsWith('__empty__')) continue;
  if (seen.has(entry.id)) continue;
  if (entry.data.rubbable !== true) continue;
  if (!entry.body?.trim()) continue;
  seen.add(entry.id);

  const { Content } = await render(entry);
  const credits = parseCredits(entry.data.credits, entry.id);
  panels.push({
    id: entry.id,
    title: entry.data.label,
    artist: pickArtistName(credits, site.artist.name),
    Content,
  });
}
---

{
  panels.length > 0 && (
    <>
      <div id="track-rub-overlay" data-track-rub-overlay>
        {panels.map(({ id, title, artist, Content }) => {
          const titleId = `track-rub-title-${id}`;
          return (
            <div
              class="track-rub-panel"
              id={`track-rub-panel-${id}`}
              data-track-rub-panel={id}
              role="dialog"
              aria-modal="true"
              aria-labelledby={titleId}
              hidden
            >
              <div class="track-rub-panel__frame">
                <header class="track-rub-panel__header">
                  <button
                    type="button"
                    class="track-rub-panel__exit glitch-hit"
                    data-track-rub-exit
                    aria-label="Close"
                    title="Close"
                  >
                    <svg
                      class="track-rub-panel__exit-icon"
                      viewBox="0 0 24 24"
                      width="18"
                      height="18"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        d="M6 6l12 12M18 6L6 18"
                      />
                    </svg>
                  </button>
                  <h1 id={titleId}>{title}</h1>
                  {artist && <p class="track-rub-panel__artist">{artist}</p>}
                </header>
                <div class="track-rub-panel__body">
                  <Content />
                </div>
              </div>
            </div>
          );
        })}
      </div>

      {/* One-shot game-style unlock toast — shown from track-rub.ts on first reveal. */}
      <div
        class="ve-achievement"
        data-ve-achievement
        role="status"
        aria-live="polite"
        aria-atomic="true"
        hidden
      >
        <div class="ve-achievement__card" aria-hidden="true">
          <span class="ve-achievement__glyph" data-ve-achievement-glyph>
            {/* Same vinyl mark as desktop V-Flip (HudIcon token="jukebox"). */}
            <HudIcon token="jukebox" />
          </span>
          <div class="ve-achievement__copy">
            <p class="ve-achievement__eyebrow">Achievement unlocked</p>
            <p class="ve-achievement__title" data-ve-achievement-title>
              Why are you rubbing?!
            </p>
            <p class="ve-achievement__sub" data-ve-achievement-sub>
              Rub a song in the discography for three times.
            </p>
          </div>
        </div>
        {/* Screen-reader announcement text lives here; visual copy is aria-hidden. */}
        <span class="ve-achievement__sr" data-ve-achievement-announce></span>
      </div>
    </>
  )
}

<style>
  /* Above SiteNav menu (z≈10) and LegalOverlay (z≈5) so the secret wins. */
  .track-rub-panel {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: grid;
    place-items: stretch;
    padding: clamp(0.75rem, 3vw, 1.5rem);
    background: color-mix(in srgb, var(--color-bg) 55%, transparent);
    pointer-events: auto;
  }

  .track-rub-panel[hidden] {
    display: none;
  }

  .track-rub-panel__frame {
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-height: 100%;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 35%);
    animation: track-rub-panel-in 320ms ease-out both;
  }

  .track-rub-panel__header {
    display: grid;
    gap: var(--space-s);
    padding: var(--space-m) var(--space-m) var(--space-s);
    border-bottom: 1px solid var(--color-border);
  }

  .track-rub-panel__exit {
    justify-self: end;
    appearance: none;
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin: 0;
    padding: 0;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    cursor: pointer;
    font: inherit;
  }

  .track-rub-panel__exit:hover {
    border-color: var(--color-accent);
  }

  .track-rub-panel__exit-icon {
    display: block;
  }

  .track-rub-panel__header h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 5vw, 2.25rem);
  }

  .track-rub-panel__artist {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .track-rub-panel__body {
    overflow: auto;
    padding: var(--space-m);
    color: var(--color-text);
  }

  .track-rub-panel__body :global(p) {
    max-width: 42rem;
    white-space: pre-line;
  }

  @keyframes track-rub-panel-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Above rub panel (z=40) — top-center toast, never steals pointer events. */
  .ve-achievement {
    position: fixed;
    top: max(0.85rem, env(safe-area-inset-top, 0px));
    left: 50%;
    z-index: 50;
    width: min(26rem, calc(100vw - 1.7rem));
    margin: 0;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .ve-achievement[hidden] {
    display: none;
  }

  .ve-achievement__card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1.05rem 1.2rem 1.1rem 1.05rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 80%, var(--color-accent));
    border-radius: 0.6rem;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-accent) 14%, transparent) 0%,
        transparent 42%
      ),
      color-mix(in srgb, var(--color-surface) 94%, transparent);
    backdrop-filter: blur(10px);
    box-shadow:
      0 0.65rem 1.75rem rgb(0 0 0 / 42%),
      inset 0 1px 0 color-mix(in srgb, var(--color-accent-alt) 12%, transparent);
    /* Accent rail */
    border-left: 3px solid var(--color-accent);
    transform-origin: top center;
    opacity: 0;
    transform: translateY(-1.1rem) scale(0.94);
  }

  .ve-achievement.is-in .ve-achievement__card {
    animation: ve-achievement-in 520ms cubic-bezier(0.16, 0.84, 0.28, 1) both;
  }

  .ve-achievement.is-out .ve-achievement__card {
    animation: ve-achievement-out 380ms cubic-bezier(0.4, 0, 0.7, 0.2) both;
  }

  .ve-achievement__glyph {
    display: grid;
    place-items: center;
    width: 3.15rem;
    height: 3.15rem;
    color: var(--color-accent-alt);
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, var(--color-accent));
    border-radius: 0.45rem;
    background: color-mix(in srgb, var(--color-bg) 55%, transparent);
  }

  /* Fit desktop V-Flip vinyl mark inside the rounded glyph slot. */
  .ve-achievement__glyph :global(.hud-icon) {
    width: 1.9rem;
    height: 1.9rem;
  }

  .ve-achievement.is-in .ve-achievement__glyph {
    animation: ve-achievement-glyph 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .ve-achievement__copy {
    min-width: 0;
    display: grid;
    gap: 0.2rem;
  }

  .ve-achievement__eyebrow {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-alt);
  }

  .ve-achievement__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.8vw, 1.25rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-text);
  }

  .ve-achievement__sub {
    margin: 0.15rem 0 0;
    font-size: 0.85rem;
    line-height: 1.35;
    color: var(--color-text-muted);
  }

  .ve-achievement__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes ve-achievement-in {
    0% {
      opacity: 0;
      transform: translateY(-1.1rem) scale(0.94);
    }
    58% {
      opacity: 1;
      transform: translateY(0.12rem) scale(1.02);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes ve-achievement-out {
    from {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    to {
      opacity: 0;
      transform: translateY(-0.65rem) scale(0.96);
    }
  }

  @keyframes ve-achievement-glyph {
    0% {
      transform: rotate(-28deg) scale(0.7);
      opacity: 0.35;
    }
    55% {
      transform: rotate(8deg) scale(1.08);
      opacity: 1;
    }
    100% {
      transform: rotate(0deg) scale(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track-rub-panel__frame {
      animation: none;
    }

    .ve-achievement.is-in .ve-achievement__card,
    .ve-achievement.is-out .ve-achievement__card,
    .ve-achievement.is-in .ve-achievement__glyph {
      animation: none;
    }

    .ve-achievement.is-in .ve-achievement__card {
      opacity: 1;
      transform: none;
    }
  }
</style>
