---
import { getDefaultVideo } from '../lib/background';
import {
  packAllowsMute,
  packSupportsLoopingVideo,
  resolveThemePack,
} from '../lib/theme-packs';
import { withBase } from '../lib/url';

const video = await getDefaultVideo();
const posterSrc = withBase(video.poster);
const pack = resolveThemePack(video.themeId);
const useVideo = packSupportsLoopingVideo(pack, video.sources.length > 0);
const sources = useVideo
  ? video.sources.map((source) => ({
      ...source,
      src: withBase(source.src),
    }))
  : [];
const showMute = packAllowsMute(pack, video.hasAudio, useVideo);
---

<div
  class="atmosphere"
  data-atmosphere
  data-bg-state={useVideo ? 'playing' : 'fallback'}
  data-active-id={video.id}
  data-has-audio={showMute ? 'true' : 'false'}
>
  <video
    class="atmosphere__video atmosphere__video--current"
    data-bg-video
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={posterSrc}
  >
    {sources.map((source) => <source src={source.src} type={source.type} />)}
  </video>
  <video
    class="atmosphere__video atmosphere__video--next"
    data-bg-video-next
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
  ></video>
  <img class="atmosphere__poster" data-bg-poster src={posterSrc} alt="" decoding="async" />
  <div class="atmosphere__scrim" aria-hidden="true"></div>
</div>

<script>
  function initAtmosphere() {
    const root = document.querySelector<HTMLElement>('[data-atmosphere]');
    const video = root?.querySelector<HTMLVideoElement>('[data-bg-video]');
    if (!root || !video) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const setFallback = () => {
      root.setAttribute('data-bg-state', 'fallback');
      video.pause();
      root.dispatchEvent(new CustomEvent('bg-state-change', { bubbles: true }));
    };

    const setPlaying = () => {
      if (reduceMotion.matches) {
        setFallback();
        return;
      }
      root.setAttribute('data-bg-state', 'playing');
      root.dispatchEvent(new CustomEvent('bg-state-change', { bubbles: true }));
    };

    if (reduceMotion.matches || root.getAttribute('data-bg-state') === 'fallback') {
      setFallback();
    } else {
      const playAttempt = video.play();
      if (playAttempt) {
        playAttempt.catch(() => setFallback());
      }
    }

    video.addEventListener('error', () => setFallback());
    reduceMotion.addEventListener('change', () => {
      if (reduceMotion.matches || !video.querySelector('source')) setFallback();
      else {
        setPlaying();
        video.muted = true;
        video.play()?.catch(() => setFallback());
      }
    });
  }

  initAtmosphere();
</script>

<style>
  .atmosphere {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: var(--color-bg);
  }

  .atmosphere__video,
  .atmosphere__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .atmosphere__video--next {
    opacity: 0;
    z-index: 1;
    pointer-events: none;
    transition: opacity 700ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .atmosphere__video--current {
    z-index: 1;
    transition: opacity 700ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .atmosphere__video--next.atmosphere__video--active {
    z-index: 1;
  }

  .atmosphere__poster {
    z-index: 0;
    display: none;
  }

  .atmosphere__scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--bg-scrim);
    pointer-events: none;
    transition: background-color 700ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .atmosphere[data-bg-state='fallback'] .atmosphere__video {
    display: none;
  }

  .atmosphere[data-bg-state='fallback'] .atmosphere__poster {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .atmosphere__video {
      display: none;
      transition: none;
    }

    .atmosphere__video--current,
    .atmosphere__video--next {
      transition: none;
    }

    .atmosphere__poster {
      display: block;
    }

    .atmosphere__scrim {
      transition: none;
    }
  }
</style>
