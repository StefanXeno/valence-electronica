---
/**
 * Hidden stage player (035). One structure for phone and laptop.
 * States live in `data-player-state` (hidden | hint | minimal | full) and are driven
 * by `src/lib/stage-player.ts`; this file only renders markup and state-scoped CSS.
 */
import { getCollection } from 'astro:content';
import { getBackgroundConfig } from '../lib/background';
import { getChrome } from '../lib/stage';
import { coverOrPlaceholder, withBase } from '../lib/url';
import HudIcon from './HudIcon.astro';
import MuteControl from './MuteControl.astro';

const chrome = await getChrome();
const { videos, defaultVideoId, schedule } = await getBackgroundConfig();
const jukeboxRaw = await getCollection('jukebox');
const metaById = new Map(jukeboxRaw.map((entry) => [entry.id, entry.data]));

const catalog = videos.map((entry) => ({
  id: entry.id,
  label: entry.label,
  themeId: entry.themeId,
  hasAudio: entry.hasAudio,
  poster: withBase(entry.poster),
  sources: entry.sources.map((source) => ({ ...source, src: withBase(source.src) })),
}));

// Stage songs only (entries with a stage video), newest release first, then title.
const songs = videos
  .map((entry) => {
    const meta = metaById.get(entry.id);
    return {
      id: entry.id,
      label: entry.label,
      cover: coverOrPlaceholder(meta?.cover ?? entry.poster),
      sortTime: meta?.sortDate ? meta.sortDate.getTime() : 0,
    };
  })
  .sort((a, b) => b.sortTime - a.sortTime || a.label.localeCompare(b.label));

const showMute = videos.some((entry) => entry.hasAudio);
const defaultLabel =
  videos.find((entry) => entry.id === defaultVideoId)?.label?.trim() ||
  videos[0]?.label?.trim() ||
  '';
---

{
  videos.length > 0 && (
    <div
      class="stage-player"
      data-stage-player
      data-player-state="hidden"
      data-stage-catalog={JSON.stringify(catalog)}
      data-stage-schedule={JSON.stringify(schedule)}
      data-stage-fallback={defaultVideoId}
      data-shuffle-default={chrome.shuffleDefault ? 'true' : 'false'}
      data-loop-default={chrome.loopDefault ? 'true' : 'false'}
    >
      <button
        type="button"
        class="stage-player__reveal"
        data-player-reveal
      >
        {chrome.playerShowLabel}
      </button>

      <section
        class="stage-player__panel"
        id="stage-player-panel"
        data-player-panel
        aria-label={chrome.jukeboxLabel}
        inert
      >
        <header class="stage-player__header">
          <div class="stage-player__heading">
            <p class="stage-player__eyebrow">
              <span class="stage-player__brand">{chrome.jukeboxLabel}</span>
              <span aria-hidden="true"> · </span>
              {chrome.currentlyPlayingLabel}
            </p>
            <p class="stage-player__title" data-now-playing>{defaultLabel}</p>
          </div>
          <button
            type="button"
            class="stage-player__close glitch-hit"
            data-player-close
            aria-label={chrome.playerCloseLabel}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                d="M6 6l12 12M18 6 6 18"
              ></path>
            </svg>
          </button>
        </header>

        <ul class="stage-player__songs" data-player-songs aria-label={chrome.songsTitle}>
          {songs.map((song) => (
            <li>
              <button
                type="button"
                class="stage-player__song glitch-hit"
                data-jukebox-option={song.id}
                aria-pressed={song.id === defaultVideoId ? 'true' : 'false'}
              >
                <img
                  class="stage-player__cover"
                  src={song.cover}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <span class="stage-player__song-title">{song.label}</span>
                <span class="stage-player__eq" aria-hidden="true">
                  <span></span>
                  <span></span>
                  <span></span>
                  <span></span>
                  <span></span>
                </span>
              </button>
            </li>
          ))}
        </ul>

        <div class="stage-player__controls">
          <button
            type="button"
            class="stage-player__tool glitch-hit"
            data-shuffle-toggle
            data-glitch-live
            aria-pressed={chrome.shuffleDefault ? 'true' : 'false'}
            aria-label={chrome.shuffleLabel}
            data-hud-label={chrome.shuffleLabel}
            data-hud-label-anchor="above"
          >
            <HudIcon token={chrome.shuffleIcon} emoji={chrome.shuffleIconEmoji} />
          </button>

          <button
            type="button"
            class="stage-player__tool glitch-hit"
            data-bg-play-toggle
            data-glitch-live
            data-play-label="Play"
            data-pause-label="Pause"
            data-hud-label="Pause"
            data-hud-label-anchor="above"
            aria-label="Pause"
          >
            <span class="stage-player__play-icon" data-bg-play-icon="play" hidden>
              <HudIcon token="play" />
            </span>
            <span class="stage-player__play-icon" data-bg-play-icon="pause">
              <HudIcon token="pause" />
            </span>
          </button>

          {showMute && (
            <div class="stage-player__tool stage-player__tool--mute" data-jukebox-mute-slot data-sound="off">
              <MuteControl
                unmuteTooltip={chrome.unmuteTooltip}
                muteTooltip={chrome.muteTooltip}
                volumeSliderTooltip={chrome.volumeSliderTooltip}
                inJukebox
              />
            </div>
          )}
        </div>
      </section>

      <button
        type="button"
        class="stage-player__vinyl glitch-hit"
        data-player-vinyl
        aria-label={chrome.playerOpenLabel}
        aria-expanded="false"
        aria-controls="stage-player-panel"
      >
        <span class="stage-player__disc">
          <HudIcon token="jukebox" />
        </span>
      </button>
    </div>
  )
}

<script>
  import { initStagePlayer } from '../lib/stage-player';

  initStagePlayer();
</script>

<style>
  .stage-player {
    --player-gap: var(--stage-corner-gap, 0.3rem);
    /* Vinyl matches the other player tools so it sits flush in the control row. */
    --player-vinyl-size: var(--control-size);
    --player-radius: calc(0.85rem * var(--hud-scale));
    --player-pad: calc(0.65rem * var(--hud-scale));
    --player-tool-gap: calc(0.35rem * var(--hud-scale));
    /* Vinyl home = its slot in the panel's control row. It never moves when opening/closing. */
    --player-row-h: max(var(--control-size), var(--player-vinyl-size));
    --player-vinyl-left: calc(var(--player-pad) + 1px);
    --player-vinyl-bottom: calc(
      var(--player-pad) + 1px + (var(--player-row-h) - var(--player-vinyl-size)) / 2
    );
    /* Hint peek: lower half of the vinyl below the viewport edge. */
    --player-hint-y: calc(var(--player-vinyl-bottom) + var(--player-gap) + 45%);
    --player-ease: cubic-bezier(0.4, 0, 0.2, 1);
    --player-dur: 280ms;
    --jukebox-volume-gap: calc(0.15rem * var(--hud-scale));

    position: fixed;
    z-index: 3;
    /* Same display face as the site titles for every player label. */
    font-family: var(--font-display);
    left: var(--player-gap);
    bottom: var(--player-gap);
    pointer-events: none;
    transition: opacity var(--ui-idle-fade-in) ease-out;
  }

  /* Idle (see idle-fade.ts): the resting vinyl fades out; open, hint, hover and focus stay. */
  :global(html[data-ui-idle]) .stage-player[data-player-state='minimal']:not(:has(:focus-visible)) {
    opacity: 0;
    transition: opacity var(--ui-idle-fade-out) ease-in;
  }

  @media (hover: hover) {
    /* Same selector + :hover so it outranks the idle rule. */
    :global(html[data-ui-idle]) .stage-player[data-player-state='minimal']:hover:not(:has(:focus-visible)) {
      opacity: 1;
      transition: opacity var(--ui-idle-fade-in) ease-out;
    }
  }

  /* —— Vinyl (hint / minimal / full) —— */

  /* Fixed home in every state; only hidden/hint slide it below the edge. */
  .stage-player__vinyl {
    position: absolute;
    left: var(--player-vinyl-left);
    bottom: var(--player-vinyl-bottom);
    z-index: 1;
    appearance: none;
    display: grid;
    place-items: center;
    width: var(--player-vinyl-size);
    height: var(--player-vinyl-size);
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(10px);
    color: var(--color-text);
    cursor: pointer;
    pointer-events: auto;
    box-shadow: 0 0.4rem 1.2rem color-mix(in srgb, black 40%, transparent);
    transition:
      transform var(--player-dur) var(--player-ease),
      opacity var(--player-dur) var(--player-ease),
      visibility 0s linear 0s,
      box-shadow var(--player-dur) var(--player-ease),
      border-color 160ms ease,
      color 160ms ease;
  }

  .stage-player__vinyl:hover,
  .stage-player__vinyl[aria-expanded='true'] {
    border-color: var(--color-accent);
    color: var(--color-accent-alt);
  }

  .stage-player__disc {
    display: grid;
    place-items: center;
    width: 78%;
    height: 78%;
  }

  .stage-player__disc :global(.hud-icon) {
    width: 100%;
    height: 100%;
  }

  /* Spins while the stage plays; paused / reduced motion stay still. */
  .stage-player__disc {
    animation: stage-player-spin 5.5s linear infinite;
  }

  :global(html[data-player-paused]) .stage-player__disc {
    animation-play-state: paused;
  }

  @keyframes stage-player-spin {
    to {
      transform: rotate(1turn);
    }
  }

  /* Hidden: below the floor. Visibility flips after the slide so the peek can slide away. */
  .stage-player[data-player-state='hidden'] .stage-player__vinyl {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(calc(100% + var(--player-vinyl-bottom) + var(--player-gap) + 0.5rem));
    transition:
      transform var(--player-dur) var(--player-ease),
      opacity var(--player-dur) var(--player-ease),
      visibility 0s linear var(--player-dur);
  }

  /* Hint: slide up half above the floor, then nudge so it reads as "tap me". */
  .stage-player[data-player-state='hint'] .stage-player__vinyl {
    transform: translateY(var(--player-hint-y));
    animation: stage-player-nudge 1.1s var(--player-ease) var(--player-dur) 2;
  }

  @keyframes stage-player-nudge {
    0%,
    100% {
      transform: translateY(var(--player-hint-y));
    }
    35% {
      transform: translateY(calc(var(--player-hint-y) - 25%));
    }
    60% {
      transform: translateY(calc(var(--player-hint-y) + 5%));
    }
  }

  /* —— Keyboard reveal (hidden only; skip-link pattern) —— */

  .stage-player__reveal {
    appearance: none;
    position: absolute;
    left: 0;
    bottom: 0;
    margin: 0;
    padding: 0.5em 0.9em;
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: calc(0.72rem * var(--hud-scale));
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    pointer-events: auto;
    /* Visually hidden until keyboard focus. */
    clip-path: inset(50%);
    opacity: 0;
  }

  .stage-player__reveal:focus-visible {
    clip-path: none;
    opacity: 1;
  }

  .stage-player__reveal[hidden] {
    display: none;
  }

  /* —— Panel (full only) —— */

  .stage-player__panel {
    display: flex;
    flex-direction: column;
    gap: calc(0.55rem * var(--hud-scale));
    /* Wide enough for vinyl + 3 tools + a usable volume slider in one row. */
    width: min(calc(19.5rem * var(--hud-scale)), calc(100vw - 2 * var(--player-gap)));
    /* Room for ~6 songs before the list scrolls; never taller than the viewport allows. */
    max-height: min(calc(36rem * var(--hud-scale)), calc(var(--viewport-h) - 4.5rem));
    padding: var(--player-pad);
    box-sizing: border-box;
    border: 1px solid var(--color-border);
    border-radius: var(--player-radius);
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(10px);
    color: var(--color-text);
    box-shadow: 0 0.6rem 1.6rem color-mix(in srgb, black 45%, transparent);
    transform-origin: bottom left;
    transition:
      opacity var(--player-dur) var(--player-ease),
      transform var(--player-dur) var(--player-ease),
      visibility 0s linear var(--player-dur);
  }

  .stage-player:not([data-player-state='full']) .stage-player__panel {
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.75rem) scale(0.97);
    pointer-events: none;
  }

  .stage-player[data-player-state='full'] .stage-player__panel {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
    transition-delay: 0s;
  }

  /* Glitch anchor for the scanline pseudo-elements while open. */
  .stage-player[data-player-state='full'] .stage-player__panel {
    position: relative;
  }

  /*
   * Glitch packs (Nightmare): no smooth fade/slide — the panel cuts in and out in hard,
   * stepped slices (plus the shared .is-glitching scanlines from stage-player.ts).
   */
  :global(html[data-hud-glitch='true']) .stage-player .stage-player__panel {
    transform: none;
    transition: visibility 0s linear var(--player-dur);
  }

  :global(html[data-hud-glitch='true']) .stage-player[data-player-state='full'] .stage-player__panel {
    transition: none;
  }

  /* Set by stage-player.ts only on a real open/close — never on a theme switch. */
  .stage-player__panel.is-glitch-open {
    animation: stage-player-glitch-in var(--player-dur) steps(1, end) both;
  }

  .stage-player__panel.is-glitch-close {
    animation: stage-player-glitch-out var(--player-dur) steps(1, end) both;
  }

  @keyframes stage-player-glitch-in {
    0% {
      opacity: 0;
      clip-path: inset(0 0 100% 0);
      transform: none;
    }
    14% {
      opacity: 1;
      clip-path: inset(62% 0 18% 0);
      transform: translateX(-7px);
    }
    28% {
      clip-path: inset(0 0 58% 0);
      transform: translateX(6px);
    }
    42% {
      opacity: 0.35;
      clip-path: inset(30% 0 0 0);
      transform: translateX(-4px);
    }
    57% {
      opacity: 1;
      clip-path: inset(8% 0 34% 0);
      transform: translateX(3px) skewX(-4deg);
    }
    71% {
      clip-path: inset(0 0 12% 0);
      transform: translateX(-2px);
    }
    85% {
      opacity: 0.7;
      clip-path: inset(0);
      transform: translateX(1px);
    }
    100% {
      opacity: 1;
      clip-path: inset(0);
      transform: none;
    }
  }

  @keyframes stage-player-glitch-out {
    0% {
      opacity: 1;
      clip-path: inset(0);
      transform: none;
    }
    20% {
      clip-path: inset(0 0 40% 0);
      transform: translateX(5px);
    }
    40% {
      opacity: 0.4;
      clip-path: inset(48% 0 10% 0);
      transform: translateX(-6px);
    }
    60% {
      opacity: 1;
      clip-path: inset(70% 0 0 0);
      transform: translateX(4px) skewX(5deg);
    }
    80% {
      opacity: 0.5;
      clip-path: inset(86% 0 4% 0);
      transform: translateX(-3px);
    }
    100% {
      opacity: 0;
      clip-path: inset(0 0 100% 0);
      transform: none;
    }
  }

  /* Collapsed panel must not reserve layout; it grows out of the vinyl corner. */
  .stage-player:not([data-player-state='full']) .stage-player__panel {
    position: absolute;
    left: 0;
    bottom: 0;
  }

  /* Full: the panel builds around the resting vinyl (first slot of the control row). */
  .stage-player[data-player-state='full'] .stage-player__vinyl {
    box-shadow: 0 0 0 transparent;
  }

  .stage-player__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .stage-player__heading {
    min-width: 0;
  }

  .stage-player__eyebrow {
    margin: 0;
    font-family: var(--font-display);
    font-size: calc(0.6rem * var(--hud-scale));
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* Player name (V-Flip) — accent, same eyebrow rhythm. */
  .stage-player__brand {
    color: var(--color-accent-alt);
  }

  .stage-player__title {
    margin: 0.15em 0 0;
    font-family: var(--font-display);
    font-size: calc(0.9rem * var(--hud-scale));
    font-weight: 600;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .stage-player__close {
    appearance: none;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: calc(1.9rem * var(--hud-scale));
    height: calc(1.9rem * var(--hud-scale));
    margin: 0;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .stage-player__close:hover {
    border-color: var(--color-border);
    color: var(--color-accent-alt);
  }

  .stage-player__close svg {
    width: 55%;
    height: 55%;
  }

  /* —— Song list —— */

  .stage-player__songs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: calc(0.3rem * var(--hud-scale));
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    /* Only shows when the list really overflows; thin and theme-tinted. */
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--color-border) 80%, transparent) transparent;
  }

  .stage-player__song {
    appearance: none;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: calc(0.55rem * var(--hud-scale));
    width: 100%;
    margin: 0;
    padding: calc(0.3rem * var(--hud-scale));
    border: 1px solid transparent;
    border-radius: calc(0.6rem * var(--hud-scale));
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  /*
   * glitch.css scanlines overhang .glitch-hit by 12% on each side. Inside the scrolling
   * list that overhang counts as scrollable overflow (phantom scrollbars) — keep them in-box.
   */
  .stage-player__song::before {
    left: 0;
    width: 100%;
  }

  .stage-player__song::after {
    top: 0;
    height: 100%;
  }

  .stage-player__song:hover {
    border-color: color-mix(in srgb, var(--color-border) 80%, transparent);
  }

  .stage-player__song[aria-pressed='true'] {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    color: var(--color-accent-alt);
  }

  .stage-player__cover {
    display: block;
    width: calc(2.4rem * var(--hud-scale));
    height: calc(2.4rem * var(--hud-scale));
    border-radius: calc(0.4rem * var(--hud-scale));
    object-fit: cover;
  }

  .stage-player__song-title {
    min-width: 0;
    font-size: calc(0.8rem * var(--hud-scale));
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  /* Current-song EQ (same bar rhythm as discography; flattened by eq-flatten on pause). */
  .stage-player__eq {
    --eq-bar-width: 3px;
    --eq-bar-gap: 2px;
    --eq-paused-bar-height: 3px;
    display: inline-flex;
    align-items: center;
    gap: var(--eq-bar-gap);
    height: calc(1rem * var(--hud-scale));
    visibility: hidden;
  }

  .stage-player__song[aria-pressed='true'] .stage-player__eq {
    visibility: visible;
  }

  .stage-player__eq span {
    display: block;
    width: var(--eq-bar-width);
    height: 60%;
    border-radius: 1px;
    background: currentColor;
    animation: stage-player-eq 1.4s ease-in-out infinite;
    transition: height 280ms var(--player-ease);
  }

  .stage-player__eq span:nth-child(2) {
    animation-delay: -0.5s;
    height: 90%;
  }

  .stage-player__eq span:nth-child(3) {
    animation-delay: -0.9s;
    height: 100%;
  }

  .stage-player__eq span:nth-child(4) {
    animation-delay: -0.3s;
    height: 80%;
  }

  .stage-player__eq span:nth-child(5) {
    animation-delay: -1.1s;
  }

  @keyframes stage-player-eq {
    0%,
    100% {
      transform: scaleY(0.4);
    }
    50% {
      transform: scaleY(1);
    }
  }

  :global(html[data-player-paused]) .stage-player__eq span {
    animation-play-state: paused;
  }

  :global(html[data-player-paused]) .stage-player__eq.is-eq-flat span {
    animation: none;
    transform: none;
    height: var(--eq-paused-bar-height);
  }

  /* —— Controls —— */

  /* Left pad reserves the vinyl slot in every state, so tools never shift on close. */
  .stage-player__controls {
    display: flex;
    align-items: center;
    gap: var(--player-tool-gap);
    min-height: var(--player-row-h);
    padding-left: calc(var(--player-vinyl-size) + var(--player-tool-gap));
    padding-top: calc(0.45rem * var(--hud-scale));
    border-top: 1px solid color-mix(in srgb, var(--color-border) 45%, transparent);
  }

  .stage-player__tool {
    appearance: none;
    display: inline-grid;
    place-items: center;
    flex: 0 0 var(--control-size);
    width: var(--control-size);
    height: var(--control-size);
    margin: 0;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    box-sizing: border-box;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .stage-player__tool:hover {
    color: var(--color-accent-alt);
    border-color: color-mix(in srgb, var(--color-border) 80%, transparent);
  }

  .stage-player__tool[aria-pressed='true'] {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 16%, transparent);
    color: var(--color-accent-alt);
  }

  .stage-player__play-icon[hidden] {
    display: none;
  }

  /* Mute slot: MuteControl owns the button; slot widens for the laptop slider. */
  .stage-player__tool--mute,
  .stage-player__tool--mute:hover {
    border-color: transparent;
    background: transparent;
    overflow: hidden;
  }

