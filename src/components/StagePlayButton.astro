---
/**
 * Discography "put on stage" control (035). Rendered for stage songs (releases
 * with a jukebox id). `stage-switch.ts` handles the click and keeps the play
 * button / EQ marker pair in sync with the active stage entry.
 *
 * - `badge`: floats over the bottom-right of a cover (parent must be `position: relative`).
 * - `compact`: leading slot of a tracklist row. Without a `stageId` it renders an empty
 *   spacer of the same width, so titles in a mixed tracklist stay aligned.
 */
import { getBackgroundConfig } from '../lib/background';
import type { UiChrome } from '../lib/stage';
import HudIcon from './HudIcon.astro';

interface Props {
  chrome: UiChrome;
  stageId?: string;
  size?: 'card' | 'compact' | 'badge';
}

const { chrome, stageId, size = 'card' } = Astro.props;
const { defaultVideoId } = await getBackgroundConfig();
const isActive = stageId === defaultVideoId;
---

{
  stageId ? (
    <span class:list={['stage-play', `stage-play--${size}`]}>
      <button
        type="button"
        class="discog__play stage-play__control glitch-hit"
        data-stage-button={stageId}
        aria-pressed={isActive ? 'true' : 'false'}
        aria-label={chrome.stageButtonLabel}
        data-hud-label={chrome.stageButtonLabel}
        data-hud-label-anchor="above"
        hidden={isActive}
      >
        <HudIcon token="play" />
      </button>
      <span
        class="discog__now-playing stage-play__control"
        data-discog-playing={stageId}
        role="status"
        aria-label={chrome.currentlyPlayingLabel}
        hidden={!isActive}
      >
        <span class="discog__eq" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </span>
      </span>
    </span>
  ) : (
    <span class:list={['stage-play', `stage-play--${size}`]} aria-hidden="true"></span>
  )
}

<style>
  .stage-play {
    --stage-play-size: calc(2.35rem * var(--hud-scale));
    display: inline-flex;
    /* Keeps the empty spacer variant as wide as a real control. */
    min-width: var(--stage-play-size);
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .stage-play--compact {
    --stage-play-size: calc(2rem * var(--hud-scale));
  }

  .stage-play--badge {
    --stage-play-size: calc(1.85rem * var(--hud-scale));
    position: absolute;
    right: calc(0.3rem * var(--hud-scale));
    bottom: calc(0.3rem * var(--hud-scale));
    z-index: 1;
  }

  /* Over artwork: dark glass so the control reads on any cover. */
  .stage-play--badge .stage-play__control {
    background-color: rgb(0 0 0 / 0.62);
    backdrop-filter: blur(6px);
    box-shadow: 0 0.2rem 0.6rem rgb(0 0 0 / 0.45);
  }

  .stage-play--badge .discog__play {
    color: #fff;
    border-color: rgb(255 255 255 / 0.35);
  }

  .stage-play--badge .discog__now-playing {
    background-image: linear-gradient(
      color-mix(in srgb, var(--color-accent) 22%, transparent),
      color-mix(in srgb, var(--color-accent) 22%, transparent)
    );
  }

  .stage-play__control {
    appearance: none;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    width: var(--stage-play-size);
    height: var(--stage-play-size);
    border-radius: 999px;
    display: grid;
    place-items: center;
    font: inherit;
  }

  .discog__play {
    color: var(--color-text-muted);
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    background: transparent;
    cursor: pointer;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .discog__play:hover {
    color: var(--color-accent-alt);
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  /* `display: grid` above would otherwise beat the `hidden` attribute on both controls. */
  .stage-play__control[hidden] {
    display: none;
  }

  .discog__play :global(.hud-icon) {
    width: calc(var(--stage-play-size) * 0.47);
    height: calc(var(--stage-play-size) * 0.47);
    /* Optical center for the play triangle */
    translate: 0.08em 0;
  }

  .stage-play .discog__eq {
    height: calc(var(--stage-play-size) * 0.5);
  }
</style>
