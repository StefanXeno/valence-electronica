---
import { getCollection, render } from 'astro:content';
import site from '../data/site.json';
import AboutPanel from './AboutPanel.astro';
import ContactPanel from './ContactPanel.astro';
import Discography from './Discography.astro';
import LegalPanel from './LegalPanel.astro';
import ShopComingSoon from './ShopComingSoon.astro';
import TourDates from './TourDates.astro';
import { getBackgroundConfig } from '../lib/background';
import { CONTENT_OVERLAY_SLUGS, slugFromOverlayPath } from '../lib/content-overlay';
import { getAboutEntry, getChrome, getSiteNavData } from '../lib/stage';
import { withBase } from '../lib/url';

const [entries, chrome, about, { defaultVideoId }] = await Promise.all([
  getCollection('legal'),
  getChrome(),
  getAboutEntry(),
  getBackgroundConfig(),
]);
const { shopUrl, contact } = getSiteNavData();

const rendered = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  }),
);

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const openSlug = slugFromOverlayPath(Astro.url.pathname, basePath);
---

<div id="legal-overlay">
  {
    rendered.map(({ entry, Content }) => (
      <LegalPanel title={entry.data.title} slug={entry.id} open={entry.id === openSlug}>
        <Content />
      </LegalPanel>
    ))
  }
  {
    about && (
      <LegalPanel title={chrome.aboutTitle} slug="about" open={openSlug === 'about'}>
        <AboutPanel />
      </LegalPanel>
    )
  }
  <LegalPanel
    title={chrome.discographyTitle}
    slug="discography"
    open={openSlug === 'discography'}
  >
    <Discography chrome={chrome} defaultId={defaultVideoId} />
  </LegalPanel>
  <LegalPanel title={chrome.tourTitle} slug="tour" open={openSlug === 'tour'}>
    <TourDates chrome={chrome} />
  </LegalPanel>
  <LegalPanel title={chrome.contactTitle} slug="contact" open={openSlug === 'contact'}>
    <ContactPanel chrome={chrome} contact={contact} />
  </LegalPanel>
  {
    !shopUrl && (
      <LegalPanel title={chrome.shopTitle} slug="shop" open={openSlug === 'shop'}>
        <ShopComingSoon chrome={chrome} />
      </LegalPanel>
    )
  }
</div>

<script
  is:inline
  define:vars={{
    homePath: withBase('/'),
    basePath,
    siteName: site.artist.name,
    defaultTitle: site.seo.title,
    contentSlugs: [...CONTENT_OVERLAY_SLUGS],
  }}
>
  function stripBase(pathname) {
    if (basePath && pathname.startsWith(basePath)) {
      return pathname.slice(basePath.length) || '/';
    }
    return pathname;
  }

  var contentSlugSet = {};
  contentSlugs.forEach(function (slug) {
    contentSlugSet[slug] = true;
  });

  function slugFromPath(pathname) {
    var stripped = stripBase(pathname);
    var legalMatch = stripped.match(/^\/legal\/([^/]+)\/?$/);
    if (legalMatch) return decodeURIComponent(legalMatch[1]);
    var contentMatch = stripped.match(/^\/([^/]+)\/?$/);
    if (contentMatch && contentSlugSet[contentMatch[1]]) {
      return decodeURIComponent(contentMatch[1]);
    }
    return null;
  }

  function overlayPath(slug) {
    if (contentSlugSet[slug]) return basePath + '/' + slug;
    return basePath + '/legal/' + slug;
  }

  function panels() {
    return Array.from(document.querySelectorAll('[data-legal-panel]'));
  }

  function panelFor(slug) {
    return document.querySelector('[data-legal-panel="' + slug + '"]');
  }

  var lastFocus = null;

  function setDocumentTitle(slug) {
    if (!slug) {
      document.title = defaultTitle;
      return;
    }
    var panel = panelFor(slug);
    var heading = panel && panel.querySelector('h1');
    var title = heading && heading.textContent && heading.textContent.trim();
    document.title = title ? title + ' — ' + siteName : defaultTitle;
  }

  function closeAll() {
    panels().forEach(function (panel) {
      panel.hidden = true;
    });
  }

  function openPanel(slug, options) {
    var historyMode = (options && options.historyMode) || 'push';
    var panel = panelFor(slug);
    if (!(panel instanceof HTMLElement)) return;

    if (!lastFocus) {
      lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    }

    closeAll();
    panel.hidden = false;

    var frame = panel.querySelector('.legal-panel__frame');
    if (frame instanceof HTMLElement) {
      frame.style.animation = 'none';
      void frame.offsetWidth;
      frame.style.animation = '';
    }

    var exit = panel.querySelector('[data-legal-exit]');
    if (exit instanceof HTMLElement) exit.focus();

    setDocumentTitle(slug);

    var nextUrl = overlayPath(slug);
    if (historyMode === 'push' && location.pathname !== nextUrl) {
      history.pushState({ legal: slug }, '', nextUrl);
    } else if (historyMode === 'replace') {
      history.replaceState({ legal: slug }, '', nextUrl);
    }
  }

  function closePanel(options) {
    var historyMode = (options && options.historyMode) || 'push';
    closeAll();
    setDocumentTitle(null);

    if (historyMode !== 'none') {
      if (historyMode === 'replace') {
        history.replaceState({ legal: null }, '', homePath);
      } else {
        history.pushState({ legal: null }, '', homePath);
      }
    }

    if (lastFocus && lastFocus.isConnected) lastFocus.focus();
    lastFocus = null;
  }

  function activeSlug() {
    var open = panels().find(function (panel) {
      return !panel.hidden;
    });
    return open ? open.getAttribute('data-legal-panel') : null;
  }

  document.addEventListener('click', function (event) {
    var target = event.target;
    if (!(target instanceof Element)) return;

    var exit = target.closest('[data-legal-exit]');
    if (exit) {
      event.preventDefault();
      closePanel({ historyMode: 'push' });
      return;
    }

    var link = target.closest('[data-legal-slug]');
    if (!(link instanceof HTMLElement)) return;

    var slug = link.getAttribute('data-legal-slug');
    if (!slug || !panelFor(slug)) return;

    event.preventDefault();
    lastFocus = link;
    openPanel(slug, { historyMode: 'push' });
  });

  document.addEventListener('keydown', function (event) {
    if (event.key !== 'Escape') return;
    if (!activeSlug()) return;
    event.preventDefault();
    closePanel({ historyMode: 'push' });
  });

  window.addEventListener('popstate', function () {
    var slug = slugFromPath(location.pathname);
    if (slug && panelFor(slug)) {
      openPanel(slug, { historyMode: 'none' });
      return;
    }
    closePanel({ historyMode: 'none' });
  });
</script>
