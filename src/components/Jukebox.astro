---
import { getBackgroundConfig } from '../lib/background';
import { getChrome } from '../lib/stage';
import { withBase } from '../lib/url';
import Discography from './Discography.astro';
import HudIcon from './HudIcon.astro';
import MuteControl from './MuteControl.astro';
import TrackInfoPanel from './TrackInfoPanel.astro';

const chrome = await getChrome();
const { videos, defaultVideoId, schedule } = await getBackgroundConfig();
const catalog = videos.map((entry) => ({
  id: entry.id,
  label: entry.label,
  themeId: entry.themeId,
  hasAudio: entry.hasAudio,
  poster: withBase(entry.poster),
  sources: entry.sources.map((source) => ({ ...source, src: withBase(source.src) })),
}));
const showMute = videos.some((entry) => entry.hasAudio);
const defaultLabel =
  videos.find((entry) => entry.id === defaultVideoId)?.label?.trim() ||
  videos[0]?.label?.trim() ||
  '';
---

{
  videos.length > 0 && (
    <div
      class="jukebox"
      role="region"
      aria-label={chrome.songsTitle}
      data-jukebox
      data-player-dock
      data-stage-catalog={JSON.stringify(catalog)}
      data-stage-schedule={JSON.stringify(schedule)}
      data-stage-fallback={defaultVideoId}
      data-stage-default={defaultVideoId}
      data-shuffle-default={chrome.shuffleDefault ? 'true' : 'false'}
      data-loop-default={chrome.loopDefault ? 'true' : 'false'}
    >
      <button
        type="button"
        class="player-dock__handle glitch-hit"
        data-player-handle
        data-expand-label={chrome.playerExpandLabel}
        data-collapse-label={chrome.playerCollapseLabel}
        data-hud-label={chrome.playerExpandLabel}
        data-hud-label-anchor="above"
        aria-expanded="false"
        aria-controls="jukebox-drawer"
        aria-label={chrome.playerExpandLabel}
      >
        <span class="player-dock__arrow" aria-hidden="true">
          <svg viewBox="0 0 32 14" fill="none">
            <path
              d="M5 10.25 L16 3.75 L27 10.25"
              stroke="currentColor"
              stroke-width="2.35"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </span>
      </button>

      <div class="player-dock__now-playing">
        <div class="player-dock__soundwave" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>
        <span class="player-dock__track" data-now-playing>{defaultLabel}</span>
      </div>

      <div class="jukebox__drawer" id="jukebox-drawer" data-jukebox-drawer>
        <div class="jukebox__drawer-inner">
          <div class="jukebox__panel">
            <header class="jukebox__header">
              <h2
                class="jukebox__title"
                data-playing-label={chrome.currentlyPlayingLabel}
                data-pausing-label={chrome.currentlyPausingLabel}
                data-songs-title={chrome.songsTitle}
              >
                <span class="jukebox__title-laptop">{chrome.songsTitle}</span>
                <span class="jukebox__title-phone jukebox__title-phone--now">{chrome.currentlyPlayingLabel}</span>
                <span class="jukebox__title-phone jukebox__title-phone--playlist">{chrome.songsTitle}</span>
              </h2>
              <div class="jukebox__header-wave player-dock__soundwave" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
              </div>
            </header>

            <section class="jukebox__section jukebox__section--list" aria-label={chrome.jukeboxLabel}>
              <TrackInfoPanel chrome={chrome} trackOrder={videos.map((entry) => entry.id)} />
            </section>

            <section
              class="jukebox__section jukebox__section--theme-tracks"
              id="jukebox-theme-tracks"
              data-theme-tracks-panel
              aria-label={chrome.songsTitle}
            >
              <Discography chrome={chrome} defaultId={defaultVideoId} themeTracksOnly />
            </section>
          </div>
        </div>
      </div>

      <div class="jukebox__toolbar" data-jukebox-toolbar>
        <div class="player-dock__transport" data-player-transport>
        {/* Decorative vinyl — inert, not a hit target. Compact bar: vinyl | shuffle | play | mute. */}
        <span class="jukebox__tool jukebox__tool--vinyl" aria-hidden="true" inert>
          <span class="jukebox__vinyl-disc">
            <HudIcon token="jukebox" />
          </span>
        </span>

        <button
          type="button"
          class="jukebox__tool jukebox__tool--shuffle glitch-hit"
          data-shuffle-toggle
          data-glitch-live
          aria-pressed={chrome.shuffleDefault ? 'true' : 'false'}
          aria-label={chrome.shuffleLabel}
          data-hud-label={chrome.shuffleLabel}
          data-hud-label-anchor="above"
        >
          <HudIcon token={chrome.shuffleIcon} emoji={chrome.shuffleIconEmoji} />
        </button>

        <button
          type="button"
          class="jukebox__tool jukebox__tool--video-play glitch-hit"
          data-bg-play-toggle
          data-glitch-live
          data-play-label="Play"
          data-pause-label="Pause"
          data-hud-label="Pause"
          data-hud-label-anchor="above"
          aria-label="Pause"
        >
          <span class="player-dock__video-icon" data-bg-play-icon="play" hidden>
            <HudIcon token="play" />
          </span>
          <span class="player-dock__video-icon" data-bg-play-icon="pause">
            <HudIcon token="pause" />
          </span>
        </button>

        <button
          type="button"
          class="jukebox__tool jukebox__tool--loop glitch-hit"
          data-loop-toggle
          data-glitch-live
          aria-pressed={chrome.loopDefault ? 'true' : 'false'}
          aria-label={chrome.loopLabel}
          data-hud-label={chrome.loopLabel}
          data-hud-label-anchor="above"
        >
          <HudIcon token={chrome.loopIcon} emoji={chrome.loopIconEmoji} />
        </button>
        </div>

        {showMute && (
          <div class="jukebox__tool jukebox__tool--mute" data-jukebox-mute-slot data-sound="off">
            <MuteControl
              unmuteTooltip={chrome.unmuteTooltip}
              muteTooltip={chrome.muteTooltip}
              volumeSliderTooltip={chrome.volumeSliderTooltip}
              inJukebox
            />
          </div>
        )}
      </div>

    </div>
  )
}

<script>
  import {
    createContinuousGlitch,
    isGlitchThemeActive,
  } from '../lib/glitch';
  import { initStageSwitch, STAGE_SELECT_EVENT, type StageCatalogEntry } from '../lib/stage-switch';
  import { initPlayerDock, syncDesktopNowTitle } from '../lib/player-dock';
  import type { StageSchedule } from '../lib/stage-schedule';

  function bootStageSwitch() {
    const root = document.querySelector<HTMLElement>('[data-jukebox]');
    const drawer = root?.querySelector<HTMLElement>('[data-jukebox-drawer]');
    if (!root?.dataset.stageCatalog || !drawer) return;

    let catalog: StageCatalogEntry[];
    let schedule: StageSchedule = { timezone: 'Europe/Berlin', rules: [] };

    try {
      catalog = JSON.parse(root.dataset.stageCatalog) as StageCatalogEntry[];
    } catch (error) {
      console.error('[jukebox] invalid data-stage-catalog JSON', error);
      return;
    }

    if (root.dataset.stageSchedule) {
      try {
        schedule = JSON.parse(root.dataset.stageSchedule) as StageSchedule;
      } catch (error) {
        console.error('[jukebox] invalid data-stage-schedule JSON', error);
      }
    }

    const staticFallbackId = root.dataset.stageFallback ?? root.dataset.stageDefault ?? '';
    initStageSwitch(catalog, staticFallbackId, schedule, {
      shuffleDefault: root.dataset.shuffleDefault !== 'false',
      loopDefault: root.dataset.loopDefault === 'true',
    });

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const bindHoverGlitch = (btn: HTMLElement) => {
      let over = false;
      const hoverGlitch = createContinuousGlitch(btn, () => {
        if (!over || reduceMotion.matches || !isGlitchThemeActive()) return false;
        if (root.classList.contains('is-glitching') || btn.classList.contains('is-glitching')) {
          return false;
        }
        if (
          btn.matches('[data-shuffle-toggle], [data-loop-toggle]') &&
          btn.getAttribute('aria-pressed') === 'true'
        ) {
          return false;
        }
        if (btn.matches('[data-mute-control]')) {
          const slot = btn.closest('[data-jukebox-mute-slot]');
          if (slot?.hasAttribute('hidden')) return false;
          if (btn instanceof HTMLButtonElement && btn.disabled) return false;
        }
        return true;
      });
      btn.addEventListener('pointerenter', () => {
        over = true;
        hoverGlitch.start();
      });
      btn.addEventListener('pointerleave', () => {
        over = false;
        hoverGlitch.stop();
      });
      return hoverGlitch;
    };

    root.querySelectorAll<HTMLElement>(
      '[data-shuffle-toggle], [data-loop-toggle], [data-bg-play-toggle], [data-jukebox-option]',
    ).forEach(bindHoverGlitch);

    const themePanel = root.querySelector<HTMLElement>('[data-theme-tracks-panel]');

    const setPlaylistOpen = (
      next: boolean,
      phase: 'prepare' | 'apply' | 'commit' | 'instant' = 'instant',
    ) => {
      // Phone / player-dock still morphs Songs via events. No bar playlist control.
      const phone = window.matchMedia('(max-width: 1023px)').matches;
      if (phase === 'prepare') {
        if (themePanel) themePanel.hidden = false;
        return;
      }
      root.classList.toggle('is-theme-tracks', next);
      syncDesktopNowTitle();
      if (!themePanel) return;
      if (phase !== 'apply') {
        root.querySelectorAll<HTMLElement>('.discog[data-theme-tracks] .discog__item').forEach((item) => {
          const on = item.dataset.discogActive === 'true';
          item.classList.toggle('is-playlist-collapsed', !next && !on);
          if (next || on) item.removeAttribute('aria-hidden');
          else item.setAttribute('aria-hidden', 'true');
        });
      }
      // Desktop: hide Songs panel when collapsed to the compact bar.
      if (!phone) themePanel.hidden = !next;
      else themePanel.hidden = false;
    };

    const muteToggle = root.querySelector<HTMLElement>('[data-mute-control]');
    if (muteToggle) bindHoverGlitch(muteToggle);

    // Compact bar rest on laptop; phone keeps collapsed dock until handle expands.
    setPlaylistOpen(false, 'instant');

    document.addEventListener('phone-player-playlist-apply', (event) => {
      const detail = (
        event as CustomEvent<{
          open?: boolean;
          phase?: 'prepare' | 'apply' | 'commit' | 'instant';
        }>
      ).detail;
      setPlaylistOpen(Boolean(detail?.open), detail?.phase ?? 'instant');
    });

    // Row tap (not listen links / play) switches the stage the same as discog play.
    themePanel?.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('a, [data-stage-button]')) return;
      if (target.closest('[data-playlist-placeholder]')) return;
      const item = target.closest<HTMLElement>('[data-discog-item]');
      const id = item?.dataset.discogItem;
      if (!id) return;
      document.dispatchEvent(new CustomEvent(STAGE_SELECT_EVENT, { detail: { id } }));
    });

    window.matchMedia('(max-width: 1023px)').addEventListener('change', () => {
      root.classList.remove('is-open', 'is-panel-opening', 'is-panel-closing');
      setPlaylistOpen(false, 'instant');
    });

    // Vinyl → V-Flip open path is fully retired (no phone-hud-open-vflip handler).
    // Close still clears leftover is-open from phone dock exclusivity.
    document.addEventListener('phone-hud-close-vflip', () => {
      root.classList.remove('is-open', 'is-panel-opening', 'is-panel-closing');
    });
  }

  bootStageSwitch();
  initPlayerDock();
</script>

<style>
  .jukebox {
    --jukebox-ease: cubic-bezier(0.4, 0, 0.2, 1);
    --jukebox-dur: 280ms;
    --jukebox-panel-inset: calc(0.65rem * var(--hud-scale));
    --jukebox-toolbar-gap: calc(0.35rem * var(--hud-scale));
    --jukebox-toolbar-pad: calc(0.25rem * var(--hud-scale));
    /* Track length when unmuted — mute slot grows by speaker + gap + this. */
    --jukebox-volume-slider-size: min(calc(6.5rem * var(--hud-scale)), 26vw);
    --jukebox-open-width: min(
      calc(22rem * var(--hud-scale)),
      calc(100vw - 2 * var(--stage-corner-gap, 0.3rem))
    );

    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    /* Compact bar hugs controls — never stretch to a reserved slider hole. */
    width: fit-content;
    max-width: var(--jukebox-open-width);
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    resize: none;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(10px);
    color: var(--color-text);
    text-shadow: 0 1px 12px var(--bg-scrim);
    overflow: hidden;
  }

  html:not([data-hud-glitch='true']) .jukebox {
    transition: border-radius var(--jukebox-dur) var(--jukebox-ease);
  }

  html[data-hud-glitch='true'] .jukebox {
    transition: border-radius 160ms steps(2, end);
  }

  .jukebox.is-open {
    width: var(--jukebox-open-width);
    border-radius: calc(0.85rem * var(--hud-scale));
  }

  .jukebox__drawer {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  .jukebox__drawer-inner {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0;
  }

  .jukebox.is-open:not(.is-panel-opening) .jukebox__drawer-inner {
    padding: calc(0.65rem * var(--hud-scale)) calc(0.65rem * var(--hud-scale)) 0;
  }

  .jukebox__header {
    margin: 0 0 calc(0.5rem * var(--hud-scale));
    padding-bottom: calc(0.45rem * var(--hud-scale));
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 45%, transparent);
  }

  .jukebox__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: calc(0.8rem * var(--hud-scale));
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-text);
    cursor: default;
  }

  /* Desktop header wave only. Phone header must never show this (015 floor wave stays). */
  .jukebox__header-wave.player-dock__soundwave {
    display: none;
  }

  /* Phone header: currentlyPlayingLabel at rest, jukeboxPanelTitle in playlist. */
  .jukebox__title-phone {
    display: none;
  }

  .jukebox__title-phone--playlist {
    display: none;
  }

  .jukebox__section--theme-tracks,
  .jukebox__section--theme-tracks[hidden] {
    display: none;
  }

  .jukebox__panel {
    position: relative;
    width: 100%;
    max-width: 100%;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    padding: 0;
    box-sizing: border-box;
  }

  html:not([data-hud-glitch='true']) .jukebox__panel {
    transition:
      max-height var(--jukebox-dur) var(--jukebox-ease),
      opacity 220ms var(--jukebox-ease),
      padding var(--jukebox-dur) var(--jukebox-ease);
  }

  html:not([data-hud-glitch='true']) .jukebox.is-panel-closing .jukebox__panel,
  html:not([data-hud-glitch='true']) .jukebox.is-panel-opening .jukebox__panel,
  html:not([data-hud-glitch='true']) .jukebox.is-open.is-panel-opening .jukebox__panel {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
    padding-top: 0;
    padding-bottom: 0;
  }

  .jukebox.is-open:not(.is-panel-opening) .jukebox__panel {
    max-height: min(44svh, calc(19rem * var(--hud-scale)));
    opacity: 1;
    overflow: auto;
    pointer-events: auto;
    padding-bottom: calc(0.25rem * var(--hud-scale));
  }

  html[data-hud-glitch='true'] .jukebox.is-glitching .jukebox__panel {
    transition: none;
  }

  .jukebox__section--list {
    padding: 0;
    border: 0;
  }

  .jukebox__toolbar {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-start;
    gap: var(--jukebox-toolbar-gap);
    flex: 0 0 auto;
    width: fit-content;
    max-width: 100%;
    min-height: var(--control-size);
    padding: var(--jukebox-toolbar-pad);
    box-sizing: border-box;
    border-top: 1px solid transparent;
    overflow: hidden;
  }

  .jukebox.is-open:not(.is-panel-opening) .jukebox__toolbar {
    border-top-color: color-mix(in srgb, var(--color-border) 45%, transparent);
  }

  .jukebox__tool {
    appearance: none;
    display: inline-grid;
    place-items: center;
    flex: 0 0 var(--control-size);
    width: var(--control-size);
    height: var(--control-size);
    margin: 0;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    box-sizing: border-box;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .jukebox__tool:hover {
    color: var(--color-accent-alt);
    border-color: color-mix(in srgb, var(--color-border) 80%, transparent);
  }

  .jukebox__tool[aria-pressed='true'] {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 16%, transparent);
    color: var(--color-accent-alt);
  }

  /*
   * Mute slot = one toolbar flex item. Muted: exactly --control-size (same as
   * vinyl/shuffle/play). Unmuted: speaker + gap + fixed slider — no flex-grow,
   * no margin-left:auto, no width:100% slack-eating (those pinned mute right).
   */
  .jukebox__tool--mute,
  .jukebox__tool--mute:hover {
    position: relative;
    flex: 0 0 var(--control-size);
    width: var(--control-size);
    min-width: var(--control-size);
    max-width: var(--control-size);
    height: var(--control-size);
    margin: 0;
    border: 0;
    border-color: transparent;
    padding: 0;
    overflow: hidden;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  /*
   * Expand via same-scope mute slot data-sound (set by MuteControl JS).
   * Do NOT use :has(:global(.volume-control…)) — :global inside :has survives
   * into the built CSS as an invalid pseudo-class and never matches.
   */
  .jukebox__tool--mute[data-sound='on'],
  .jukebox__tool--mute[data-sound='on']:hover {
    flex: 0 0 auto;
    width: auto;
    min-width: calc(
      var(--control-size) + var(--jukebox-toolbar-gap) + var(--jukebox-volume-slider-size)
    );
    max-width: none;
    overflow: visible;
  }

  .jukebox__tool--mute[hidden] {
    display: none;
  }

  .jukebox__tool--shuffle,
  .jukebox__tool--loop,
  .jukebox__tool--video-play,
  .jukebox__tool--vinyl {
    /* Same fixed slot as .jukebox__tool — even vinyl | shuffle | play | mute rhythm. */
    flex: 0 0 var(--control-size);
  }

  /* Default hide play/pause + vinyl; desktop 019 and phone 015 unhide them. */
  .jukebox__tool--video-play,
  .jukebox__tool--vinyl {
    display: none;
  }

  .player-dock__video-icon {
    display: grid;
    place-items: center;
  }

  .player-dock__video-icon[hidden] {
    display: none;
  }

  .jukebox__tool--video-play:disabled {
    opacity: 0.4;
    pointer-events: none;
  }

  /*
   * Vinyl in the compact bar — decorative only. Same disc look as the old
   * corner FAB, scaled to --control-size. Never a hit target.
   */
  .jukebox__tool--vinyl {
    border-color: color-mix(in srgb, var(--color-border) 55%, transparent);
    background:
      radial-gradient(
        circle at 50% 50%,
        color-mix(in srgb, var(--color-text) 18%, #2a2a2a) 0 14%,
        #111 15% 16%,
        #1a1a1a 17% 38%,
        #0c0c0c 39% 40%,
        #161616 41% 62%,
        #090909 63% 64%,
        #121212 65% 100%
      );
    color: color-mix(in srgb, var(--color-text-muted) 75%, #fff);
    cursor: default;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, #fff 8%, transparent);
    pointer-events: none;
    user-select: none;
    touch-action: none;
  }

  .jukebox__tool--vinyl:hover {
    color: color-mix(in srgb, var(--color-text-muted) 75%, #fff);
    border-color: color-mix(in srgb, var(--color-border) 55%, transparent);
    background:
      radial-gradient(
        circle at 50% 50%,
        color-mix(in srgb, var(--color-text) 18%, #2a2a2a) 0 14%,
        #111 15% 16%,
        #1a1a1a 17% 38%,
        #0c0c0c 39% 40%,
        #161616 41% 62%,
        #090909 63% 64%,
        #121212 65% 100%
      );
  }

  .jukebox__vinyl-disc {
    display: grid;
    place-items: center;
    width: 72%;
    height: 72%;
    pointer-events: none;
  }

  .jukebox__vinyl-disc :global(.hud-icon) {
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .jukebox.is-glitching[data-glitch='in'] .jukebox__panel {
    animation: jukebox-panel-in var(--g-dur, 560ms) both;
  }

  .jukebox.is-glitching[data-glitch='out'] .jukebox__panel {
    animation: jukebox-panel-out 520ms both;
  }

  @keyframes jukebox-panel-in {
    0% {
      max-height: 0;
      opacity: 0;
      animation-timing-function: steps(1, end);
    }
    35% {
      max-height: min(44svh, calc(19rem * var(--hud-scale)));
      opacity: 1;
      animation-timing-function: steps(1, end);
    }
    100% {
      max-height: min(44svh, calc(19rem * var(--hud-scale)));
      opacity: 1;
    }
  }

  @keyframes jukebox-panel-out {
    0% {
      max-height: min(44svh, calc(19rem * var(--hud-scale)));
      opacity: 1;
      animation-timing-function: steps(1, end);
    }
    55% {
      max-height: var(--control-size);
      opacity: 0.4;
      animation-timing-function: steps(1, end);
    }
    100% {
      max-height: 0;
      opacity: 0;
    }
  }

  .player-dock__transport {
    display: contents;
  }

  .player-dock__handle,
  .player-dock__now-playing {
    display: none;
  }

  /* Grabber chevron: ~1.6×0.62rem, rounded caps — not a wide needle V. */
  .player-dock__arrow {
    display: block;
    width: 1.6rem;
    height: 0.62rem;
    filter: drop-shadow(0 0.2rem 0.4rem color-mix(in srgb, black 50%, transparent));
  }

  .player-dock__arrow svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  :global(html[data-player-dock-expanded]) .player-dock__arrow {
    transform: rotate(180deg);
  }

  .player-dock__soundwave {
    /* Integer px so paused ticks don't subpixel-round into uneven widths. */
    --eq-bar-width: 4px;
    --eq-bar-gap: 3px;
    --eq-paused-bar-height: 4px;
    --eq-flatten-duration: 280ms;
    --eq-flatten-easing: cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--eq-bar-gap);
    width: var(--control-size);
    height: 1.15rem;
    pointer-events: none;
  }

  /* Idle rest = taller-in-the-middle diamond. Playing = per-bar EQ, not a shared sine. */
  .player-dock__soundwave span {
    display: block;
    box-sizing: border-box;
    flex: 0 0 var(--eq-bar-width);
    width: var(--eq-bar-width);
    min-width: var(--eq-bar-width);
    max-width: var(--eq-bar-width);
    height: calc(100% / 3);
    border-radius: 1px;
    background: currentColor;
    transform-origin: center center;
    animation: player-eq-1 2.16s cubic-bezier(0.3, 0, 0.2, 1) infinite;
    transition:
      height var(--eq-flatten-duration) var(--eq-flatten-easing),
      min-height var(--eq-flatten-duration) var(--eq-flatten-easing),
      max-height var(--eq-flatten-duration) var(--eq-flatten-easing);
  }

  .player-dock__soundwave span:nth-child(2) {
    height: calc(200% / 3);
    animation-name: player-eq-2;
    animation-duration: 1.64s;
    animation-delay: -0.72s;
  }

  .player-dock__soundwave span:nth-child(3) {
    height: 100%;
    animation-name: player-eq-3;
    animation-duration: 1.32s;
    animation-delay: -0.28s;
  }

  .player-dock__soundwave span:nth-child(4) {
    height: calc(200% / 3);
    animation-name: player-eq-4;
    animation-duration: 2.48s;
    animation-delay: -1.16s;
  }

  .player-dock__soundwave span:nth-child(5) {
    height: calc(100% / 3);
    animation-name: player-eq-5;
    animation-duration: 1.88s;
    animation-delay: -0.48s;
  }

  /* Pause: freeze the dance only. Height → 4px comes from .is-eq-flat (JS bake). */
  :global(html[data-player-paused]) .player-dock__soundwave span:nth-child(n) {
    animation-play-state: paused;
    flex: 0 0 var(--eq-bar-width);
    width: var(--eq-bar-width);
    min-width: var(--eq-bar-width);
    max-width: var(--eq-bar-width);
  }

  /* After JS locks visual height, drop keyframes and ease to the flat line. */
  :global(html[data-player-paused]) .player-dock__soundwave.is-eq-flat span:nth-child(n) {
    animation: none;
    transform: none;
    height: var(--eq-paused-bar-height);
    min-height: var(--eq-paused-bar-height);
    max-height: var(--eq-paused-bar-height);
  }

  /* No-JS: still flatten (instant). JS path must not use this — it snaps. */
  :global(html:not([data-player-dock-js])[data-player-paused]) .player-dock__soundwave span:nth-child(n) {
    animation: none;
    transform: none;
    height: var(--eq-paused-bar-height);
    min-height: var(--eq-paused-bar-height);
    max-height: var(--eq-paused-bar-height);
  }

  .player-dock__track {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: calc(0.72rem * var(--hud-scale));
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .player-dock__handle.is-hinting .player-dock__arrow {
    animation: player-handle-nod 0.45s ease-in-out 3;
  }

  /* Irregular peaks; scale ranges fit rest height so bars flatten + spike independently. */
  @keyframes player-eq-1 {
    0%,
    100% {
      transform: scaleY(0.35);
    }
    14% {
      transform: scaleY(2.55);
    }
    28% {
      transform: scaleY(0.4);
    }
    43% {
      transform: scaleY(1.7);
    }
    58% {
      transform: scaleY(0.55);
    }
    74% {
      transform: scaleY(2.9);
    }
    88% {
      transform: scaleY(0.22);
    }
  }

  @keyframes player-eq-2 {
    0%,
    100% {
      transform: scaleY(0.2);
    }
    16% {
      transform: scaleY(1.32);
    }
    27% {
      transform: scaleY(0.48);
    }
    42% {
      transform: scaleY(0.82);
    }
    57% {
      transform: scaleY(1.45);
    }
    71% {
      transform: scaleY(0.28);
    }
    86% {
      transform: scaleY(1.12);
    }
  }

  @keyframes player-eq-3 {
    0%,
    100% {
      transform: scaleY(0.16);
    }
    11% {
      transform: scaleY(0.92);
    }
    23% {
      transform: scaleY(0.28);
    }
    36% {
      transform: scaleY(1.06);
    }
    49% {
      transform: scaleY(0.18);
    }
    62% {
      transform: scaleY(0.68);
    }
    76% {
      transform: scaleY(1.02);
    }
    89% {
      transform: scaleY(0.34);
    }
  }

  @keyframes player-eq-4 {
    0%,
    100% {
      transform: scaleY(0.88);
    }
    13% {
      transform: scaleY(0.22);
    }
    30% {
      transform: scaleY(1.42);
    }
    44% {
      transform: scaleY(0.52);
    }
    59% {
      transform: scaleY(1.18);
    }
    73% {
      transform: scaleY(0.16);
    }
    87% {
      transform: scaleY(1.36);
    }
  }

  @keyframes player-eq-5 {
    0%,
    100% {
      transform: scaleY(1.55);
    }
    15% {
      transform: scaleY(0.28);
    }
    32% {
      transform: scaleY(2.35);
    }
    48% {
      transform: scaleY(0.65);
    }
    64% {
      transform: scaleY(0.2);
    }
    79% {
      transform: scaleY(2.85);
    }
    91% {
      transform: scaleY(1.05);
    }
  }

  @keyframes player-handle-nod {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -0.28rem;
    }
  }

  @keyframes player-transport-in {
    from {
      opacity: 0;
      transform: translateY(0.45rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes player-transport-out {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(0.45rem);
    }
  }

  /*
   * Desktop V-Flip = compact control bar at rest.
   * TrackInfoPanel / vinyl flip is retired (vinyl in-bar is decorative only).
   * Songs open only via phone/player-dock morph events — no bar playlist toggle.
   */
  @media (min-width: 1024px) {
    .jukebox {
      --jukebox-rest-base: min(calc(18rem * var(--hud-scale)), var(--jukebox-open-width));
      /* Same air under the header rule and above the toolbar (both faces). */
      --jukebox-well-y: calc(0.5rem * var(--hud-scale));
      --desktop-playlist-viewport-h: calc(
        3 * (4.8rem * var(--hud-scale)) + 2 * (0.55rem * var(--hud-scale))
      );
      --player-playlist-morph-dur: 380ms;
      /* Compact pill hugs vinyl | shuffle | play | mute — no empty tail. */
      width: fit-content;
      max-width: min(
        var(--jukebox-open-width),
        calc(100vw - 2 * var(--stage-corner-gap, 0.3rem))
      );
      border-radius: 999px;
      align-items: flex-start;
    }

    .jukebox.is-theme-tracks {
      width: var(--jukebox-rest-base);
      max-width: min(
        var(--jukebox-open-width),
        calc(100vw - 2 * var(--stage-corner-gap, 0.3rem))
      );
      border-radius: calc(0.85rem * var(--hud-scale));
      align-items: stretch;
    }

    /* Compact desktop must not inherit phone/panel .is-open width lock. */
    .jukebox.is-open:not(.is-theme-tracks) {
      width: fit-content;
      border-radius: 999px;
    }

    /* Unmuted: bar still fit-content; mute slot min-width already includes the slider. */
    .jukebox:has(.jukebox__tool--mute[data-sound='on']) {
      width: fit-content;
    }

    .jukebox__tool--mute,
    .jukebox__tool--mute[hidden] {
      display: flex !important;
      align-items: center;
      justify-content: flex-start;
      visibility: visible;
      pointer-events: auto;
    }

    /*
     * Compact pill: pull the collapsed drawer out of flow so its min-content
     * (playlist cards) cannot widen the bar past the toolbar.
     */
    .jukebox:not(.is-theme-tracks) .jukebox__drawer {
      position: absolute;
      width: 0;
      height: 0;
      min-width: 0;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    /*
     * Desktop transport is a real flex row (not display:contents). Mute stays a
     * toolbar sibling so vinyl|shuffle|play|mute share one equal gap rhythm —
     * contents + a growing mute slot was reading as space-between.
     */
    .player-dock__transport {
      display: flex;
      flex: 0 0 auto;
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: center;
      justify-content: flex-start;
      gap: var(--jukebox-toolbar-gap);
      width: max-content;
      margin: 0;
      padding: 0;
    }

    .jukebox__toolbar {
      width: fit-content;
      max-width: 100%;
      justify-content: flex-start;
    }

    .jukebox.is-theme-tracks .jukebox__toolbar {
      width: 100%;
    }

    /* Playlist expand/collapse. Unmute takes space instantly — no width ease. */
    html:not([data-hud-glitch='true']) .jukebox,
    html[data-hud-glitch='true'] .jukebox {
      transition: none;
    }

    html:not([data-hud-glitch='true']) .jukebox__tool--mute {
      transition: none;
    }

    .player-dock__now-playing {
      display: none;
    }

    .jukebox__title-laptop {
      display: none;
    }

    .jukebox__title-phone--now,
    .jukebox__title-phone--playlist {
      display: block;
      transition: opacity var(--player-playlist-morph-dur, 380ms)
        cubic-bezier(0.22, 1, 0.36, 1);
    }

    .jukebox__title-phone--playlist {
      position: absolute;
      inset: 0;
      opacity: 0;
    }

    /* Songs open: playlist title. Compact bar has no header (drawer collapsed). */
    .jukebox.is-theme-tracks .jukebox__title-phone--now {
      opacity: 0;
      visibility: hidden;
    }

    .jukebox.is-theme-tracks .jukebox__title-phone--playlist {
      opacity: 1;
      visibility: visible;
    }

    /* TrackInfoPanel retired — never show the vinyl easter-egg list face. */
    .jukebox__section--list {
      display: none !important;
    }

    .jukebox__section--theme-tracks,
    .jukebox__section--theme-tracks[hidden] {
      display: none;
    }

    .jukebox.is-theme-tracks .jukebox__section--theme-tracks,
    .jukebox.is-theme-tracks .jukebox__section--theme-tracks[hidden] {
      display: block !important;
      position: relative;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      z-index: 2;
    }

    @media (prefers-reduced-motion: reduce) {
      .jukebox__section--theme-tracks,
      .jukebox__section--theme-tracks[hidden] {
        transition: none;
      }
    }

    .jukebox__tool--loop {
      display: none;
    }

    .jukebox__tool--vinyl,
    .jukebox__tool--video-play {
      display: inline-grid;
    }

    /* Compact bar: no drawer chrome. Songs open: pad the panel. */
    .jukebox__drawer {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .jukebox.is-theme-tracks .jukebox__drawer {
      position: relative;
      width: auto;
      height: auto;
      min-width: 0;
      max-height: none;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      overflow: hidden;
    }

    .jukebox__drawer-inner,
    .jukebox.is-theme-tracks .jukebox__drawer-inner {
      position: relative;
      padding: 0;
    }

    .jukebox.is-theme-tracks .jukebox__drawer-inner {
      padding: var(--jukebox-well-y) calc(0.55rem * var(--hud-scale)) 0;
    }

    .jukebox__header {
      display: none;
    }

    .jukebox.is-theme-tracks .jukebox__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex: 0 0 auto;
      gap: calc(0.4rem * var(--hud-scale));
      margin: 0 0 var(--jukebox-well-y);
      padding-bottom: calc(0.28rem * var(--hud-scale));
      overflow: hidden;
      position: relative;
      z-index: 2;
    }

    .jukebox__header .jukebox__title {
      position: relative;
      flex: 1 1 auto;
      min-width: 0;
      overflow: hidden;
      pointer-events: auto;
      cursor: default;
    }

    /* Songs header: no solo-card wave (compact bar owns transport). */
    .jukebox__header-wave.player-dock__soundwave {
      display: none;
    }

    /* Compact bar: panel collapsed. Songs open: show the list well. */
    .jukebox__panel {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      pointer-events: none;
      padding-bottom: 0;
    }

    .jukebox.is-theme-tracks .jukebox__panel {
      max-height: none;
      opacity: 1;
      overflow: hidden;
      pointer-events: auto;
      padding-bottom: var(--jukebox-well-y);
    }

    .jukebox__toolbar {
      border-top-color: transparent;
    }

    .jukebox.is-theme-tracks .jukebox__toolbar {
      border-top-color: color-mix(in srgb, var(--color-border) 45%, transparent);
    }

    /* Collapsed extras must not leave flex gaps (the empty air above/below the card). */
    .jukebox:not(.is-theme-tracks) :global(.discog[data-theme-tracks]) {
      gap: 0;
    }

    .jukebox.is-theme-tracks :global(.discog[data-theme-tracks]),
    .jukebox.is-playlist-morphing :global(.discog[data-theme-tracks]) {
      gap: var(--discog-row-gap, calc(0.55rem * var(--hud-scale)));
    }

    .jukebox.is-playlist-morphing {
      overflow: hidden;
    }

    /* Same scrollport rest → morph → settled. Gutter reserved before the bar paints. */
    .jukebox.is-theme-tracks .jukebox__section--theme-tracks,
    .jukebox.is-theme-tracks .jukebox__section--theme-tracks[hidden],
    .jukebox.is-playlist-morphing .jukebox__section--theme-tracks,
    .jukebox.is-playlist-morphing .jukebox__section--theme-tracks[hidden] {
      max-height: none;
      overflow-x: hidden;
      overflow-y: auto;
      scrollbar-gutter: stable;
    }

    .jukebox.is-theme-tracks:not(.is-playlist-morphing) .jukebox__section--theme-tracks,
    .jukebox.is-theme-tracks:not(.is-playlist-morphing) .jukebox__section--theme-tracks[hidden] {
      max-height: var(--player-playlist-viewport-h, var(--desktop-playlist-viewport-h));
      overflow-x: hidden;
      overflow-y: auto;
      scrollbar-gutter: stable;
    }
  }

  @media (max-width: 1023px) {
    .jukebox,
    .jukebox *,
    .jukebox textarea,
    .jukebox input {
      resize: none;
    }

    .jukebox::-webkit-resizer,
    .jukebox *::-webkit-resizer {
      display: none;
    }

    .jukebox {
      --phone-now-pad: var(--phone-chrome-pad, 0.65rem);
      --phone-floor-radius: var(--phone-player-radius, 1.25rem);
      /* Tight title / card air — leftover 1fr was the solo dead zone. */
      --phone-sheet-head-gap: 0.28rem;
      /* In-flow transport row — never an absolute overlay. Keep it tight under the card. */
      --player-transport-h: calc(var(--control-size) + 0.08rem);
      --player-playlist-morph-dur: 380ms;
      overscroll-behavior: none;
      /* Whole sheet cap — card + now-playing row, never the viewport top. */
      --player-sheet-max: min(68svh, calc(100svh - 5.5rem));

      /* Collapsed + expanded: floor-pinned. Height grows up; chrome does not lift. */
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      margin: 0;
      display: grid;
      width: 100%;
      max-width: 100%;
      min-width: 0;
      /* Lock the paint box to the floor row. 0fr min-content + transport height
         used to grow this behind the icon pill (one shared red “blob”). */
      height: var(--phone-player-h);
      min-height: var(--phone-player-h);
      max-height: var(--phone-player-h);
      isolation: isolate;
      overflow: hidden;
      /* No floor stroke — a bottom border + radius reads as a floating capsule. */
      border-bottom: 0;
      /* Moderate top corners. Bottom square so the bar clips into the viewport. */
      border-radius: var(--phone-dock-radius, 14px) var(--phone-dock-radius, 14px) 0 0;
      background: color-mix(in srgb, var(--color-bg) 88%, var(--color-surface));
      /* Glass blur on this box eats box-shadow (Chromium). Collapsed lift
         is .stage-dock__left::after; expanded re-applies --phone-player-shadow. */
      backdrop-filter: none;
      /* Compact collapsed chrome — floor row only. Handle hitbox overflows this box. */
      padding: var(--phone-bar-pad, 0.28rem) var(--phone-now-pad)
        calc(var(--phone-bar-pad, 0.28rem) + var(--phone-safe-bottom, env(safe-area-inset-bottom, 0px)));
      align-items: stretch;
      justify-items: stretch;
      grid-template-columns: var(--control-size) minmax(0, 1fr) var(--control-size);
      /* minmax(0, 0fr) — bare 0fr still sizes to min-content (drawer + transport). */
      grid-template-rows: minmax(0, 0fr) minmax(0, 0fr) minmax(var(--control-size), auto);
      grid-template-areas:
        'drawer drawer drawer'
        'transport transport transport'
        'wave   title  mute';
    }

    html:not([data-hud-glitch='true']) .jukebox {
      transition: none;
    }

    .jukebox__title-laptop {
      display: none;
    }

    .jukebox__title-phone {
      display: inline;
    }

    /* CURRENTLY PLAYING only when the sheet is fully open — not collapsed / mid-drag. */
    .jukebox__header {
      opacity: 0;
      visibility: hidden;
      max-height: 0;
      margin: 0;
      padding: 0;
      border: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .jukebox.is-player-expanded:not(.is-sheet-dragging):not(.is-panel-opening):not(.is-panel-closing) .jukebox__header,
    .jukebox.is-open:not(.is-sheet-dragging):not(.is-panel-opening):not(.is-panel-closing) .jukebox__header {
      opacity: 1;
      visibility: visible;
      max-height: none;
      margin: 0 0 var(--phone-sheet-head-gap, 0.28rem);
      padding-bottom: var(--phone-sheet-head-gap, 0.28rem);
      border-bottom: 1px solid color-mix(in srgb, var(--color-border) 45%, transparent);
      overflow: visible;
      pointer-events: none;
    }

    .jukebox__title,
    .jukebox__title-phone,
    .player-dock__track {
      cursor: default;
      pointer-events: none;
    }

    .jukebox__title {
      position: relative;
    }

    /* Phone header is text only — floor row keeps the pill soundwave. */
    .jukebox__header-wave,
    .jukebox__header-wave.player-dock__soundwave {
      display: none !important;
    }

    /* Crossfade with the playlist morph — an 80ms swap read as a title pop. */
    .jukebox__title-phone--now,
    .jukebox__title-phone--playlist {
      display: block;
      transition: opacity var(--player-playlist-morph-dur, 380ms)
        cubic-bezier(0.22, 1, 0.36, 1);
    }

    .jukebox__title-phone--playlist {
      position: absolute;
      inset: 0;
      opacity: 0;
    }

    .jukebox.is-theme-tracks .jukebox__title-phone--now {
      opacity: 0;
    }

    .jukebox.is-theme-tracks .jukebox__title-phone--playlist {
      opacity: 1;
    }

    /* Transport is a real row whenever the sheet is open or morphing.
       Never display:none — that popped the buttons after the sheet grew. */
    .jukebox.is-player-expanded,
    .jukebox.is-open,
    .jukebox.is-sheet-dragging,
    .jukebox.is-sheet-morphing {
      bottom: 0;
      border-bottom: 0;
      border-radius: var(--phone-floor-radius) var(--phone-floor-radius) 0 0;
      /* Same token as collapsed ::after — backdrop-filter is already none. */
      box-shadow: var(--phone-player-shadow, 0 -0.45rem 1.2rem color-mix(in srgb, black 45%, transparent));
      /* Solo settled: hug content. Any leftover 1fr / minmax(auto) parks a void. */
      height: auto;
      max-height: none;
      min-height: 0;
      align-content: start;
      grid-template-rows: auto var(--player-transport-h) var(--control-size);
      /* Open pad matches the handle clearance — don't add a second head gap. */
      padding: 0 var(--phone-now-pad)
        calc(var(--phone-bar-pad, 0.28rem) + var(--phone-safe-bottom, env(safe-area-inset-bottom, 0px)));
    }

    /* Playlist settled: drawer fills leftover so the list is a real scrollport. */
    .jukebox.is-theme-tracks:not(.is-playlist-morphing) {
      min-height: var(--phone-player-h);
      grid-template-rows: minmax(0, 1fr) var(--player-transport-h) var(--control-size);
    }

    /* Let the collapsed grab strip receive taps above the compact pill.
       Drawer/transport stay clipped so they cannot paint the shared blob. */
    .jukebox:not(.is-player-expanded):not(.is-open):not(.is-sheet-dragging):not(.is-sheet-morphing) {
      overflow: visible;
    }

    .jukebox:not(.is-player-expanded):not(.is-open):not(.is-sheet-dragging):not(.is-sheet-morphing)
      .jukebox__drawer,
    .jukebox:not(.is-player-expanded):not(.is-open):not(.is-sheet-dragging):not(.is-sheet-morphing)
      .player-dock__transport {
      height: 0;
      min-height: 0;
      max-height: 0;
      margin: 0;
      padding: 0;
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    /*
     * Solo open/close + drag: height interpolates from --phone-player-h to the
     * shrink-wrapped stack. All rows auto — no 1fr (that was the bottom void).
     * align-content:end only while the box is SHORTER than content so the floor
     * stays painted and the drawer clips from the top. Once height === content
     * there is no leftover. Do not end-align a taller box (that was the top void).
     */
    .jukebox.is-sheet-dragging:not(.is-theme-tracks),
    .jukebox.is-sheet-morphing:not(.is-playlist-morphing):not(.is-theme-tracks) {
      align-content: end;
      grid-template-rows: auto var(--player-transport-h) var(--control-size);
    }

    /* Wide grab strip. Visible chevron stays small; extra hit is transparent. */
    .player-dock__handle {
