---
/**
 * Secret full-view for rubbable catalog entries.
 * Reuses LegalPanel chrome language (frame, exit, prose body) without History URL changes.
 */
import { getCollection, render } from 'astro:content';
import { parseCredits, pickArtistName } from '../lib/catalog-tracks';
import site from '../data/site.json';

type RubPanel = {
  id: string;
  title: string;
  artist?: string;
  Content: Awaited<ReturnType<typeof render>>['Content'];
};

const [jukeboxRaw, tracksRaw] = await Promise.all([
  getCollection('jukebox'),
  getCollection('tracks'),
]);

const panels: RubPanel[] = [];
const seen = new Set<string>();

for (const entry of [...jukeboxRaw, ...tracksRaw]) {
  if (entry.id.startsWith('__empty__')) continue;
  if (seen.has(entry.id)) continue;
  if (entry.data.rubbable !== true) continue;
  if (!entry.body?.trim()) continue;
  seen.add(entry.id);

  const { Content } = await render(entry);
  const credits = parseCredits(entry.data.credits, entry.id);
  panels.push({
    id: entry.id,
    title: entry.data.label,
    artist: pickArtistName(credits, site.artist.name),
    Content,
  });
}
---

{
  panels.length > 0 && (
    <div id="track-rub-overlay" data-track-rub-overlay>
      {panels.map(({ id, title, artist, Content }) => {
        const titleId = `track-rub-title-${id}`;
        return (
          <div
            class="track-rub-panel"
            id={`track-rub-panel-${id}`}
            data-track-rub-panel={id}
            role="dialog"
            aria-modal="true"
            aria-labelledby={titleId}
            hidden
          >
            <div class="track-rub-panel__frame">
              <header class="track-rub-panel__header">
                <button
                  type="button"
                  class="track-rub-panel__exit glitch-hit"
                  data-track-rub-exit
                  aria-label="Close"
                  title="Close"
                >
                  <svg
                    class="track-rub-panel__exit-icon"
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      d="M6 6l12 12M18 6L6 18"
                    />
                  </svg>
                </button>
                <h1 id={titleId}>{title}</h1>
                {artist && <p class="track-rub-panel__artist">{artist}</p>}
              </header>
              <div class="track-rub-panel__body">
                <Content />
              </div>
            </div>
          </div>
        );
      })}
    </div>
  )
}

<style>
  /* Above SiteNav menu (z≈10) and LegalOverlay (z≈5) so the secret wins. */
  .track-rub-panel {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: grid;
    place-items: stretch;
    padding: clamp(0.75rem, 3vw, 1.5rem);
    background: color-mix(in srgb, var(--color-bg) 55%, transparent);
    pointer-events: auto;
  }

  .track-rub-panel[hidden] {
    display: none;
  }

  .track-rub-panel__frame {
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-height: 100%;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 35%);
    animation: track-rub-panel-in 320ms ease-out both;
  }

  .track-rub-panel__header {
    display: grid;
    gap: var(--space-s);
    padding: var(--space-m) var(--space-m) var(--space-s);
    border-bottom: 1px solid var(--color-border);
  }

  .track-rub-panel__exit {
    justify-self: end;
    appearance: none;
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin: 0;
    padding: 0;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    cursor: pointer;
    font: inherit;
  }

  .track-rub-panel__exit:hover {
    border-color: var(--color-accent);
  }

  .track-rub-panel__exit-icon {
    display: block;
  }

  .track-rub-panel__header h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 5vw, 2.25rem);
  }

  .track-rub-panel__artist {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .track-rub-panel__body {
    overflow: auto;
    padding: var(--space-m);
    color: var(--color-text);
  }

  .track-rub-panel__body :global(p) {
    max-width: 42rem;
    white-space: pre-line;
  }

  @keyframes track-rub-panel-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track-rub-panel__frame {
      animation: none;
    }
  }
</style>
