---
import { getValidCatalogTracks } from '../lib/catalog-tracks';
import type { UiChrome } from '../lib/stage';

interface Props {
  chrome: UiChrome;
}

const { chrome } = Astro.props;
const tracks = await getValidCatalogTracks();
const yearFmt = new Intl.DateTimeFormat('en-GB', { year: 'numeric' });
---

{
  tracks.length === 0 ? (
    <p>{chrome.emptyCatalog}</p>
  ) : (
    <ul class="track-catalog">
      {tracks.map((track) => (
        <li>
          <div class="track-catalog__meta">
            <span class="track-catalog__title">{track.title}</span>
            <span class="track-catalog__year">{yearFmt.format(track.sortDate)}</span>
          </div>
          {track.blurb && <p class="track-catalog__blurb">{track.blurb}</p>}
        </li>
      ))}
    </ul>
  )
}

<style>
  .track-catalog {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .track-catalog__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.5rem;
  }

  .track-catalog__title {
    font-family: var(--font-display);
    font-size: calc(0.85rem * var(--hud-scale));
    color: var(--color-text);
  }

  .track-catalog__year {
    font-size: calc(0.75rem * var(--hud-scale));
    color: var(--color-text-muted);
  }

  .track-catalog__blurb {
    margin: 0;
    font-size: calc(0.8rem * var(--hud-scale));
    color: var(--color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
