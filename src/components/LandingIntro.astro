---
import '../styles/intro.css';

interface Props {
  introLead: string;
  introName: string;
}

const { introLead, introName } = Astro.props;
const nameTrimmed = introName.trim();
const leadTrimmed = introLead.trim();
const isDev = import.meta.env.DEV;
const portalMaskId = `intro-portal-${nameTrimmed.replace(/\s+/g, '-').toLowerCase()}`;
---

{
  nameTrimmed && (
    <>
      <div
        class="landing-intro"
        hidden
        data-landing-intro
        data-intro-name={nameTrimmed}
        role="presentation"
      >
        <div class="landing-intro__cutout" aria-hidden="true">
          <svg
            class="landing-intro__portal-svg"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <defs>
              <mask
                id={portalMaskId}
                maskUnits="userSpaceOnUse"
                x="0"
                y="0"
                width="100%"
                height="100%"
              >
                <rect width="100%" height="100%" fill="white" />
                <text
                  class="landing-intro__portal-text"
                  x="50%"
                  y="50%"
                  dominant-baseline="central"
                  text-anchor="middle"
                  fill="black"
                >
                  {nameTrimmed}
                </text>
              </mask>
            </defs>
            <rect width="100%" height="100%" fill="#fff" mask={`url(#${portalMaskId})`} />
          </svg>
        </div>
        {leadTrimmed && <p class="landing-intro__lead">{leadTrimmed}</p>}
        <span class="visually-hidden">{nameTrimmed}</span>
      </div>

      <script is:inline define:vars={{ introName: nameTrimmed, isDev }}>
        (function () {
          try {
            if (!introName) return;
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            var params = new URLSearchParams(location.search);
            var replay = isDev && params.has('replay-intro');
            if (!replay && localStorage.getItem('valence-intro-seen') === '1') {
              return;
            }
            document.documentElement.dataset.introPending = 'true';
          } catch (e) {
            /* ignore */
          }
        })();
      </script>

      <script>
        import { applyIntroConfig, pickIntroConfig } from '../lib/intro-config';
        import { markIntroSeen, shouldPlayIntro } from '../lib/intro';

        const root = document.documentElement;
        const overlay = document.querySelector<HTMLElement>('[data-landing-intro]');
        const introName = overlay?.dataset.introName ?? '';

        function clearIntroState() {
          delete root.dataset.introActive;
          delete root.dataset.introPending;
        }

        function finishIntro() {
          markIntroSeen();
          clearIntroState();
          overlay?.remove();
        }

        if (!overlay || !shouldPlayIntro(introName)) {
          clearIntroState();
        } else {
          const config = pickIntroConfig();
          applyIntroConfig(overlay, config);

          let finished = false;

          const finishOnce = () => {
            if (finished) return;
            finished = true;
            document.removeEventListener('keydown', onKeyDown);
            overlay.removeEventListener('click', finishOnce);
            finishIntro();
          };

          const onKeyDown = (event: KeyboardEvent) => {
            if (event.key === 'Escape') finishOnce();
          };

          overlay.hidden = false;
          root.dataset.introActive = 'true';
          // Pending is FOUC-only; overlay now captures hits.
          delete root.dataset.introPending;

          if (config.skipOnPointer) overlay.addEventListener('click', finishOnce);
          if (config.skipOnEscape) document.addEventListener('keydown', onKeyDown);

          const nameEl = overlay.querySelector('.landing-intro__portal-text');
          const fallbackTimer = window.setTimeout(finishOnce, config.fallbackMs);

          nameEl?.addEventListener(
            'animationend',
            () => {
              window.clearTimeout(fallbackTimer);
              window.setTimeout(finishOnce, config.endSettleMs);
            },
            { once: true },
          );
        }
      </script>
    </>
  )
}
