---
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import { withBase } from '../lib/url';

const legalPages = await getCollection('legal');
const year = new Date().getFullYear();
---

<footer>
  <p>© {year} {site.artist.name}</p>
  <nav aria-label="Legal">
    {legalPages.map((page) => (
      <a
        class="glitch-hit"
        href={withBase(`/legal/${page.id}`)}
        data-legal-slug={page.id}
      >
        {page.data.title}
      </a>
    ))}
  </nav>
</footer>

<style>
  footer {
    position: fixed;
    left: var(--hud-inset);
    bottom: 0;
    z-index: 3;
    width: max-content;
    max-width: calc(100vw - var(--control-size) - 2 * var(--hud-inset));
    margin: 0;
    padding: 0.45rem 0 0.55rem;
    border: 0;
    background: transparent;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0.45rem 1rem;
    font-size: calc(0.75rem * var(--hud-scale));
    color: var(--color-text-muted);
    text-shadow: 0 1px 10px var(--bg-scrim);
    pointer-events: auto;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  nav a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  nav a:hover {
    color: var(--color-accent-alt);
  }

  p {
    margin: 0;
  }
</style>
