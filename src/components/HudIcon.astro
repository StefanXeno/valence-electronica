---
import type { HudIconToken } from '../lib/hud-icons';

interface Props {
  token: HudIconToken;
  emoji?: string;
}

const { token, emoji } = Astro.props;
---

{
  emoji ? (
    <span class="hud-icon hud-icon--emoji" aria-hidden="true">
      {emoji}
    </span>
  ) : token === 'jukebox' ? (
    <svg class="hud-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        fill-rule="evenodd"
        d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 8.15a1.85 1.85 0 1 0 0 3.7 1.85 1.85 0 0 0 0-3.7z"
      />
      <circle cx="12" cy="12" r="7.45" fill="none" stroke="var(--color-bg)" stroke-width="0.55" opacity="0.5" />
      <circle cx="12" cy="12" r="5.55" fill="none" stroke="var(--color-bg)" stroke-width="0.55" opacity="0.5" />
      <circle cx="12" cy="12" r="3.7" fill="none" stroke="var(--color-bg)" stroke-width="0.55" opacity="0.5" />
    </svg>
  ) : token === 'about' ? (
    <svg class="hud-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
      />
    </svg>
  ) : token === 'lyrics' ? (
    <svg class="hud-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
      />
    </svg>
  ) : token === 'discography' ? (
    <svg class="hud-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"
      />
    </svg>
  ) : (
    <svg class="hud-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zM9 14H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2zm-8 4H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2z"
      />
    </svg>
  )
}

<style>
  .hud-icon {
    display: block;
    width: calc(22px * var(--hud-scale));
    height: calc(22px * var(--hud-scale));
  }

  .hud-icon--emoji {
    font-size: calc(1.15rem * var(--hud-scale));
    line-height: 1;
    text-align: center;
  }
</style>
