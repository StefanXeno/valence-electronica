---
import site from '../data/site.json';
import ChannelIcon from './ChannelIcon.astro';
import { getChrome } from '../lib/stage';

const chrome = await getChrome();
const channels = site.channels.map((channel) => {
  const id =
    'id' in channel && typeof channel.id === 'string'
      ? channel.id
      : channel.label.toLowerCase().replace(/\s+/g, '');
  return {
    id,
    label: channel.label,
    url: 'url' in channel ? channel.url : undefined,
    active: channel.status === 'active' && 'url' in channel,
  };
});
---

{
  channels.length > 0 && (
    <nav class="channels" aria-label={chrome.socialsLabel}>
      <ul>
        {channels.map((channel) =>
          channel.active ? (
            <li>
              <a
                class="glitch-hit"
                href={channel.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={channel.label}
                data-hud-label={channel.label}
                title={channel.label}
              >
                <ChannelIcon id={channel.id} label={channel.label} />
              </a>
            </li>
          ) : (
            <li class="placeholder">
              <span aria-label={`${channel.label} — ${chrome.comingSoon}`}>
                <ChannelIcon id={channel.id} label={channel.label} />
              </span>
            </li>
          ),
        )}
      </ul>
    </nav>
  )
}

<style>
  .channels {
    text-shadow: 0 1px 12px var(--bg-scrim);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: calc(0.3rem * var(--hud-scale));
  }

  li a,
  li.placeholder span {
    display: inline-grid;
    place-items: center;
    width: calc(2.5rem * var(--hud-scale));
    height: calc(2.5rem * var(--hud-scale));
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    backdrop-filter: blur(6px);
    box-sizing: border-box;
  }

  li a {
    color: var(--color-text);
    text-decoration: none;
  }

  li a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-alt);
  }

  li a :global(.channel-icon),
  li.placeholder :global(.channel-icon) {
    flex-shrink: 0;
    display: block;
    width: calc(22px * var(--hud-scale));
    height: calc(22px * var(--hud-scale));
  }

  li.placeholder {
    color: var(--color-text-muted);
  }

  li.placeholder span {
    cursor: default;
  }
</style>
