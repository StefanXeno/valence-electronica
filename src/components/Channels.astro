---
import site from '../data/site.json';

const channels = site.channels.map((channel) => ({
  label: channel.label,
  url: 'url' in channel ? channel.url : undefined,
  active: channel.status === 'active' && 'url' in channel,
}));
---

{
  channels.length > 0 && (
    <section class="channels" aria-labelledby="channels-heading">
      <h2 id="channels-heading">Listen &amp; Follow</h2>
      <ul>
        {channels.map((channel) =>
          channel.active ? (
            <li>
              <a href={channel.url} target="_blank" rel="noopener noreferrer">
                {channel.label}
              </a>
            </li>
          ) : (
            <li class="placeholder">
              <span>{channel.label}</span>
              <span class="soon">coming soon</span>
            </li>
          ),
        )}
      </ul>
    </section>
  )
}

<style>
  .channels {
    padding: var(--space-l) 0 var(--space-xl);
  }

  h2 {
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  ul {
    list-style: none;
    margin: var(--space-m) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  li a,
  li.placeholder {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.6em 1.1em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    backdrop-filter: blur(6px);
    font-family: var(--font-display);
    font-size: 0.9rem;
  }

  li a {
    color: var(--color-text);
    text-decoration: none;
  }

  li a:hover {
    border-color: var(--color-accent);
  }

  li.placeholder {
    color: var(--color-text-muted);
  }

  .soon {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
</style>
