---
import { Image } from 'astro:assets';
import site from '../data/site.json';
import wordmark from '../assets/images/brand/valence-wordmark.png';
import type { UiChrome } from '../lib/stage';
import { getAboutEntry, getSiteNavData, getUpcomingShows, resolveShowTitle } from '../lib/stage';
import { withBase } from '../lib/url';
import ChannelIcon from './ChannelIcon.astro';

interface Props {
  chrome: UiChrome;
}

const { chrome } = Astro.props;
const { shopUrl } = getSiteNavData();
const about = await getAboutEntry();
const upcomingShows = await getUpcomingShows();
const artistName = site.artist.name;
const tourDateFmt = new Intl.DateTimeFormat('en-GB', {
  timeZone: 'Europe/Berlin',
  day: 'numeric',
  month: 'short',
});

const menuChannels = site.channels
  .map((channel) => {
    const id =
      'id' in channel && typeof channel.id === 'string'
        ? channel.id
        : channel.label.toLowerCase().replace(/\s+/g, '');
    return {
      id,
      label: channel.label,
      url: 'url' in channel ? channel.url : undefined,
      active: channel.status === 'active' && 'url' in channel,
    };
  })
  .filter((channel) => channel.active && channel.url);
---

<header class="site-nav" data-site-nav>
  <div class="site-nav__bar">
    <a class="site-nav__brand" href="#stage" data-site-nav-home aria-label={artistName}>
      <Image
        class="site-nav__wordmark"
        src={wordmark}
        alt={artistName}
        widths={[320, 640]}
        sizes="(max-width: 1023px) 42vw, 11rem"
        decoding="async"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <nav class="site-nav__primary" aria-label="Primary">
      {
        shopUrl ? (
          <a
            class="site-nav__item"
            href={shopUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-site-nav-shop="external"
          >
            {chrome.shopTitle}
          </a>
        ) : (
          <a
            class="site-nav__item"
            href={withBase('/shop')}
            data-legal-slug="shop"
          >
            {chrome.shopTitle}
          </a>
        )
      }
      <a class="site-nav__item" href={withBase('/tour')} data-legal-slug="tour">
        {chrome.tourTitle}
      </a>
      {
        about && (
          <a class="site-nav__item" href={withBase('/about')} data-legal-slug="about">
            {chrome.aboutTitle}
          </a>
        )
      }
      <a
        class="site-nav__item"
        href={withBase('/discography')}
        data-legal-slug="discography"
      >
        {chrome.discographyTitle}
      </a>
      <a
        class="site-nav__item"
        href={withBase('/legal/imprint')}
        data-legal-slug="imprint"
      >
        {chrome.imprintButton}
      </a>
      <a
        class="site-nav__item"
        href={withBase('/legal/privacy')}
        data-legal-slug="privacy"
      >
        {chrome.privacyButton}
      </a>
    </nav>

    <button
      type="button"
      class="site-nav__menu-btn"
      data-site-nav-menu-toggle
      aria-expanded="false"
      aria-controls="site-nav-menu"
      aria-label="Open menu"
    >
      <span class="site-nav__menu-btn-bars" aria-hidden="true"></span>
    </button>
  </div>

  <div
    class="site-nav__menu"
    id="site-nav-menu"
    data-site-nav-menu
    hidden
  >
    <nav class="site-nav__menu-primary" aria-label="Primary">
      {
        shopUrl ? (
          <a
            class="site-nav__menu-item"
            href={shopUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-site-nav-shop="external"
            data-site-nav-menu-close
            style="--nav-stagger: 0"
          >
            {chrome.shopTitle}
          </a>
        ) : (
          <a
            class="site-nav__menu-item"
            href={withBase('/shop')}
            data-legal-slug="shop"
            data-site-nav-menu-close
            style="--nav-stagger: 0"
          >
            {chrome.shopTitle}
          </a>
        )
      }
      {/* Mobile-only Tour expand: destinations strip, not a nested dropdown. */}
      <div class="site-nav__menu-tour" data-site-nav-tour style="--nav-stagger: 1">
        <button
          type="button"
          class="site-nav__menu-item site-nav__menu-tour-toggle"
          data-site-nav-tour-toggle
          aria-expanded="false"
          aria-controls="site-nav-tour-panel"
        >
          <span>{chrome.tourTitle}</span>
          <span class="site-nav__menu-tour-chevron" aria-hidden="true"></span>
        </button>
        <div
          class="site-nav__menu-tour-panel"
          id="site-nav-tour-panel"
          data-site-nav-tour-panel
          hidden
        >
          <div class="site-nav__menu-tour-panel-inner">
            {
              upcomingShows.length === 0 ? (
                <p class="site-nav__menu-tour-empty">{chrome.emptyShows}</p>
              ) : (
                <ul class="site-nav__menu-tour-destinations" aria-label={chrome.tourTitle}>
                  {upcomingShows.map((show, index) => {
                    const eventTitle = resolveShowTitle(show.title, show.venue);
                    const dateLabel = tourDateFmt.format(show.date);
                    const href = show.ticketUrl || show.venueUrl || withBase('/tour');
                    const external = Boolean(show.ticketUrl || show.venueUrl);
                    return (
                      <li style={`--dest-stagger: ${index}`}>
                        <a
                          class="site-nav__menu-tour-dest"
                          href={href}
                          target={external ? '_blank' : undefined}
                          rel={external ? 'noopener noreferrer' : undefined}
                          data-legal-slug={external ? undefined : 'tour'}
                          data-site-nav-menu-close
                        >
                          <span class="site-nav__menu-tour-dest-city">{show.city}</span>
                          <span class="site-nav__menu-tour-dest-meta">
                            <time datetime={show.date.toISOString().slice(0, 10)}>
                              {dateLabel}
                            </time>
                            {' · '}
                            {eventTitle}
                          </span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              )
            }
            <a
              class="site-nav__menu-tour-all"
              href={withBase('/tour')}
              data-legal-slug="tour"
              data-site-nav-menu-close
            >
              All dates
            </a>
          </div>
        </div>
      </div>
      {
        about && (
          <a
            class="site-nav__menu-item"
            href={withBase('/about')}
            data-legal-slug="about"
            data-site-nav-menu-close
            style="--nav-stagger: 2"
          >
            {chrome.aboutTitle}
          </a>
        )
      }
      <a
        class="site-nav__menu-item"
        href={withBase('/discography')}
        data-legal-slug="discography"
        data-site-nav-menu-close
        style="--nav-stagger: 3"
      >
        {chrome.discographyTitle}
      </a>
      <a
        class="site-nav__menu-item"
        href={withBase('/legal/imprint')}
        data-legal-slug="imprint"
        data-site-nav-menu-close
        style="--nav-stagger: 4"
      >
        {chrome.imprintButton}
      </a>
      <a
        class="site-nav__menu-item"
        href={withBase('/legal/privacy')}
        data-legal-slug="privacy"
        data-site-nav-menu-close
        style="--nav-stagger: 5"
      >
        {chrome.privacyButton}
      </a>
    </nav>
    {
      menuChannels.length > 0 && (
        <div class="site-nav__menu-socials" style="--nav-stagger: 6">
          <ul class="site-nav__menu-channels" aria-label={chrome.socialsLabel}>
            {menuChannels.map((channel) => (
              <li>
                <a
                  class="site-nav__menu-channel glitch-hit"
                  href={channel.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={channel.label}
                  data-site-nav-menu-close
                >
                  <ChannelIcon id={channel.id} label={channel.label} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</header>

<script>
  function goHome() {
    // Same exit path as LegalOverlay (Imprint / About / Tour / …).
    const legalExit = document.querySelector<HTMLElement>(
      '[data-legal-panel]:not([hidden]) [data-legal-exit]',
    );
    legalExit?.click();
    const stage = document.querySelector('#stage') ?? document.querySelector('.stage');
    stage?.scrollIntoView({ block: 'start' });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function initSiteNav() {
    const root = document.querySelector<HTMLElement>('[data-site-nav]');
    if (!root) return;

    const menu = root.querySelector<HTMLElement>('[data-site-nav-menu]');
    const menuBtn = root.querySelector<HTMLButtonElement>('[data-site-nav-menu-toggle]');
    const tourBlock = root.querySelector<HTMLElement>('[data-site-nav-tour]');
    const tourToggle = root.querySelector<HTMLButtonElement>('[data-site-nav-tour-toggle]');
    const tourPanel = root.querySelector<HTMLElement>('[data-site-nav-tour-panel]');
    let closeTimer: number | undefined;
    let onCloseTransitionEnd: ((event: TransitionEvent) => void) | undefined;

    const prefersReducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const clearCloseWait = () => {
      if (closeTimer !== undefined) {
        window.clearTimeout(closeTimer);
        closeTimer = undefined;
      }
      if (onCloseTransitionEnd && menu) {
        menu.removeEventListener('transitionend', onCloseTransitionEnd);
        onCloseTransitionEnd = undefined;
      }
    };

    const setTourOpen = (open: boolean) => {
      if (!tourBlock || !tourToggle || !tourPanel) return;
      tourToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) {
        tourPanel.hidden = false;
        // Force layout so grid-rows / opacity transitions run from collapsed.
        void tourPanel.offsetHeight;
        tourBlock.classList.add('is-tour-open');
      } else {
        tourBlock.classList.remove('is-tour-open');
        if (prefersReducedMotion()) {
          tourPanel.hidden = true;
        } else {
          // Hide after collapse transition; keep in DOM while animating.
          window.setTimeout(() => {
            if (!tourBlock.classList.contains('is-tour-open')) {
              tourPanel.hidden = true;
            }
          }, 420);
        }
      }
    };

    const finishClose = () => {
      clearCloseWait();
      if (!menu || !menuBtn) return;
      setTourOpen(false);
      if (tourPanel) tourPanel.hidden = true;
      menu.hidden = true;
      menuBtn.focus();
    };

    const setMenuOpen = (open: boolean) => {
      if (!menu || !menuBtn) return;

      if (open) {
        clearCloseWait();
        menu.hidden = false;
        // Paint collapsed morph (clip-path circle) before expanding.
        void menu.offsetWidth;
        root.classList.add('is-menu-open');
        document.documentElement.classList.add('site-nav-menu-open');
        menuBtn.setAttribute('aria-expanded', 'true');
        menuBtn.setAttribute('aria-label', 'Close menu');
        const first = menu.querySelector<HTMLElement>('a, button');
        first?.focus();
        return;
      }

      if (!root.classList.contains('is-menu-open') && menu.hidden) return;

      // Collapse Tour first so reverse stagger reads cleanly.
      setTourOpen(false);
      root.classList.remove('is-menu-open');
      document.documentElement.classList.remove('site-nav-menu-open');
      menuBtn.setAttribute('aria-expanded', 'false');
      menuBtn.setAttribute('aria-label', 'Open menu');

      if (prefersReducedMotion() || menu.hidden) {
        finishClose();
        return;
      }

      clearCloseWait();
      onCloseTransitionEnd = (event: TransitionEvent) => {
        if (event.target !== menu) return;
        if (event.propertyName !== 'clip-path' && event.propertyName !== 'opacity') return;
        finishClose();
      };
      menu.addEventListener('transitionend', onCloseTransitionEnd);
      // Fallback if transitionend never fires (tab backgrounded, etc.).
      closeTimer = window.setTimeout(finishClose, 560);
    };

    root.querySelectorAll<HTMLElement>('[data-site-nav-home]').forEach((el) => {
      el.addEventListener('click', (event) => {
        event.preventDefault();
        setMenuOpen(false);
        goHome();
      });
    });

    menuBtn?.addEventListener('click', () => {
      setMenuOpen(!root.classList.contains('is-menu-open'));
    });

    tourToggle?.addEventListener('click', () => {
      const next = !tourBlock?.classList.contains('is-tour-open');
      setTourOpen(Boolean(next));
    });

    root.querySelectorAll<HTMLElement>('[data-site-nav-menu-close]').forEach((el) => {
      el.addEventListener('click', () => {
        // Close menu after LegalOverlay open handler runs (bubble after capture).
        window.requestAnimationFrame(() => setMenuOpen(false));
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !root.classList.contains('is-menu-open')) return;
      if (tourBlock?.classList.contains('is-tour-open')) {
        setTourOpen(false);
        tourToggle?.focus();
        return;
      }
      setMenuOpen(false);
    });

    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches) setMenuOpen(false);
    });
  }

  initSiteNav();
</script>

<style>
  .site-nav {
    pointer-events: auto;
    position: fixed;
    z-index: 8;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    padding: 0.55rem clamp(0.65rem, 2vw, 1.1rem) 0.35rem;
    /* Transparent over stage — no solid black band. */
    background: transparent;
  }

  .site-nav__bar {
    /* Stay above the fullscreen menu so brand + open/close toggle stay usable. */
    position: relative;
    z-index: 10;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding: 0.2rem 0;
    background: transparent;
    border: 0;
  }

  .site-nav__brand {
    display: block;
    line-height: 0;
    flex: 0 1 auto;
    filter: drop-shadow(0 1px 10px color-mix(in srgb, #000 55%, transparent));
  }

  .site-nav__wordmark {
    display: block;
    width: min(11rem, 42vw);
    height: auto;
  }

  .site-nav__primary {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.2rem 0.95rem;
    font-family: var(--font-display);
    font-size: clamp(0.72rem, 1.5vw, 0.88rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .site-nav__item {
    color: color-mix(in srgb, #fff 88%, transparent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    text-shadow: 0 1px 12px color-mix(in srgb, #000 70%, transparent);
  }

  .site-nav__item:hover,
  .site-nav__item:focus-visible {
    color: #fff;
    border-bottom-color: color-mix(in srgb, var(--color-accent-alt, #c8ff4a) 70%, transparent);
    outline: none;
  }

  .site-nav__menu-btn {
    appearance: none;
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    cursor: pointer;
    flex: 0 0 auto;
    filter: drop-shadow(0 1px 8px color-mix(in srgb, #000 60%, transparent));
  }

  .site-nav__menu-btn-bars,
  .site-nav__menu-btn-bars::before,
  .site-nav__menu-btn-bars::after {
    display: block;
    width: 1.35rem;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition:
      transform 200ms ease,
      opacity 200ms ease;
  }

  .site-nav__menu-btn-bars {
    position: relative;
  }

  .site-nav__menu-btn-bars::before,
  .site-nav__menu-btn-bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .site-nav__menu-btn-bars::before {
    top: -0.4rem;
  }

  .site-nav__menu-btn-bars::after {
    top: 0.4rem;
  }

  .site-nav.is-menu-open .site-nav__menu-btn-bars {
    background: transparent;
  }

  .site-nav.is-menu-open .site-nav__menu-btn-bars::before {
    top: 0;
    transform: rotate(45deg);
  }

  .site-nav.is-menu-open .site-nav__menu-btn-bars::after {
    top: 0;
    transform: rotate(-45deg);
  }

  /* Full-viewport morph from the hamburger corner (mobile only; hidden ≥1024). */
  .site-nav__menu {
    --menu-morph-origin: calc(100% - 1.35rem) 1.35rem;
    --menu-morph-dur: 480ms;
    --menu-stagger-step: 55ms;
    --menu-stagger-base: 90ms;
    position: fixed;
    inset: 0;
    z-index: 9;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2.5rem;
    padding: max(5.5rem, calc(env(safe-area-inset-top, 0px) + 4.5rem))
      clamp(1.25rem, 6vw, 2.5rem)
      max(2rem, env(safe-area-inset-bottom, 0px));
    background: color-mix(in srgb, #050505 92%, transparent);
    backdrop-filter: blur(16px);
    overflow-y: auto;
    overscroll-behavior: contain;
    clip-path: circle(0% at var(--menu-morph-origin));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      clip-path var(--menu-morph-dur) cubic-bezier(0.22, 1, 0.36, 1),
      opacity calc(var(--menu-morph-dur) * 0.7) ease,
      visibility 0s linear var(--menu-morph-dur);
    will-change: clip-path, opacity;
  }

  .site-nav.is-menu-open .site-nav__menu {
    clip-path: circle(160% at var(--menu-morph-origin));
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      clip-path var(--menu-morph-dur) cubic-bezier(0.22, 1, 0.36, 1),
      opacity calc(var(--menu-morph-dur) * 0.55) ease,
      visibility 0s linear 0s;
  }

  .site-nav__menu[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav__menu,
    .site-nav.is-menu-open .site-nav__menu {
      transition: none;
      clip-path: none;
      opacity: 1;
    }

    .site-nav__menu-primary > .site-nav__menu-item,
    .site-nav__menu-primary > .site-nav__menu-tour,
    .site-nav__menu-socials,
    .site-nav.is-menu-open .site-nav__menu-primary > .site-nav__menu-item,
    .site-nav.is-menu-open .site-nav__menu-primary > .site-nav__menu-tour,
    .site-nav.is-menu-open .site-nav__menu-socials,
    .site-nav__menu-tour-dest,
    .site-nav__menu-tour.is-tour-open .site-nav__menu-tour-dest {
      transition: none;
      opacity: 1;
      transform: none;
    }

    .site-nav__menu-tour-panel,
    .site-nav__menu-tour.is-tour-open .site-nav__menu-tour-panel {
      transition: none;
    }
  }

  .site-nav__menu-primary {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 8vw, 2.4rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.15;
  }

  /* Staggered slide/fade for top-level entries (direct children only). */
  .site-nav__menu-primary > .site-nav__menu-item,
  .site-nav__menu-primary > .site-nav__menu-tour,
  .site-nav__menu-socials {
    --nav-stagger: 0;
    opacity: 0;
    transform: translate3d(0, 0.85rem, 0);
    transition:
      opacity 360ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0ms;
  }

  .site-nav.is-menu-open .site-nav__menu-primary > .site-nav__menu-item,
  .site-nav.is-menu-open .site-nav__menu-primary > .site-nav__menu-tour,
  .site-nav.is-menu-open .site-nav__menu-socials {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition-delay: calc(
      var(--menu-stagger-base) + (var(--nav-stagger) * var(--menu-stagger-step))
    );
  }

  .site-nav:not(.is-menu-open) .site-nav__menu-primary > .site-nav__menu-item,
  .site-nav:not(.is-menu-open) .site-nav__menu-primary > .site-nav__menu-tour,
  .site-nav:not(.is-menu-open) .site-nav__menu-socials {
    /* Reverse: items drop out slightly ahead of the morph close. */
    transition-delay: calc((5 - var(--nav-stagger)) * 28ms);
  }

  .site-nav__menu-item {
    color: color-mix(in srgb, #fff 90%, transparent);
    text-decoration: none;
    padding: 0.2em 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-align: left;
    cursor: pointer;
    width: 100%;
  }

  .site-nav__menu-item:hover,
  .site-nav__menu-item:focus-visible {
    color: #fff;
    border-bottom-color: color-mix(in srgb, var(--color-accent-alt, #c8ff4a) 55%, transparent);
    outline: none;
  }

  /* Tour: full-width expand + large destination typography (not a dropdown). */
  .site-nav__menu-tour {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .site-nav__menu-tour-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .site-nav__menu-tour-chevron {
    display: block;
    width: 0.55em;
    height: 0.55em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    opacity: 0.7;
    transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
    flex: 0 0 auto;
  }

  .site-nav__menu-tour.is-tour-open .site-nav__menu-tour-chevron {
    transform: rotate(225deg);
  }

  .site-nav__menu-tour-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 380ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 280ms ease;
  }

  .site-nav__menu-tour.is-tour-open .site-nav__menu-tour-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .site-nav__menu-tour-panel[hidden] {
    display: none;
  }

  .site-nav__menu-tour.is-tour-open .site-nav__menu-tour-panel[hidden] {
    display: grid;
  }

  .site-nav__menu-tour-panel-inner {
    overflow: hidden;
    min-height: 0;
    padding: 0.35rem 0 0.85rem;
  }

  .site-nav__menu-tour-destinations {
    list-style: none;
    margin: 0;
    padding: 0.35rem 0 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    border-top: 1px solid color-mix(in srgb, #fff 14%, transparent);
  }

  .site-nav__menu-tour-dest {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.35rem 0;
    text-decoration: none;
    color: color-mix(in srgb, #fff 88%, transparent);
    opacity: 0;
    transform: translate3d(0, 0.5rem, 0);
    transition:
      opacity 320ms cubic-bezier(0.22, 1, 0.36, 1),
