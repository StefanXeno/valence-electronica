---
import site from '../data/site.json';

const { name, tagline } = site.artist;
---

<section class="identity" aria-label={name}>
  <h1>{name}</h1>
  <p class="tagline">{tagline}</p>
</section>

<style>
  .identity {
    text-shadow: 0 1px 16px var(--bg-scrim);
  }

  h1 {
    margin: 0;
    font-size: clamp(calc(1.35rem * var(--hud-scale)), 6.75vw, calc(2rem * var(--hud-scale)));
    font-weight: 700;
    color: var(--color-text);
  }

  .tagline {
    margin: 0.2em 0 0;
    font-family: var(--font-display);
    font-size: clamp(calc(0.75rem * var(--hud-scale)), 3.6vw, calc(0.95rem * var(--hud-scale)));
    color: var(--color-accent-alt);
  }
</style>
