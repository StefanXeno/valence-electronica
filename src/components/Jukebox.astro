      flex: 0 0 auto;
      min-height: 0;
      overflow: visible;
      touch-action: none;
    }

    /* Playlist + morph: section is the bound. */
    .jukebox.is-theme-tracks .jukebox__section--theme-tracks,
    .jukebox.is-theme-tracks .jukebox__section--theme-tracks[hidden],
    .jukebox.is-playlist-morphing .jukebox__section--theme-tracks,
    .jukebox.is-playlist-morphing .jukebox__section--theme-tracks[hidden] {
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-y;
    }

    /* Rest collapse lives in Discography (scoped items). Keep gap + playing card stacked. */
    .jukebox.is-player-expanded:not(.is-theme-tracks) :global(.discog[data-theme-tracks]),
    .jukebox.is-open:not(.is-theme-tracks) :global(.discog[data-theme-tracks]) {
      gap: 0;
    }

    /* Solo card must not flex-shrink inside a short overflow sheet (click-open clip). */
    .jukebox:not(.is-theme-tracks)
      :global(.discog[data-theme-tracks] .discog__item[data-discog-active='true']) {
      flex-shrink: 0;
    }

    .jukebox.is-playlist-morphing
      :global(.discog[data-theme-tracks] .discog__item[data-discog-active='true']) {
      position: relative;
      z-index: 2;
    }

    /* Clip siblings only while they add in / while the handle is dragging.
       Do not key this off is-sheet-morphing — that class lingering killed scroll. */
    .jukebox.is-playlist-morphing .jukebox__section--theme-tracks,
    .jukebox.is-theme-tracks.is-sheet-dragging .jukebox__section--theme-tracks {
      overflow: hidden;
      touch-action: none;
    }

    /* Settled playlist: section is the scrollport (panel is the bound). */
