---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import site from '../data/site.json';
import wordmark from '../assets/images/brand/valence-wordmark.png';
import { getMergedDiscography } from '../lib/catalog-tracks';
import { getValidJukeboxEntries } from '../lib/background';
import type { UiChrome } from '../lib/stage';
import {
  formatShowLocality,
  getAboutEntry,
  getSiteNavData,
  getUpcomingShows,
  groupShowsByYear,
} from '../lib/stage';
import { withBase } from '../lib/url';
import ChannelIcon from './ChannelIcon.astro';
import HudIcon from './HudIcon.astro';

interface Props {
  chrome: UiChrome;
}

const { chrome } = Astro.props;
const { shopUrl } = getSiteNavData();
const about = await getAboutEntry();
const AboutContent = about ? (await render(about)).Content : undefined;
const upcomingShows = await getUpcomingShows();
const tourYearGroups = groupShowsByYear(upcomingShows);
const [legalEntries, stageVideos] = await Promise.all([
  getCollection('legal'),
  getValidJukeboxEntries(),
]);
const legalPanels = await Promise.all(
  legalEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return { id: entry.id, title: entry.data.title, Content };
  }),
);
const releases = await getMergedDiscography(new Set(stageVideos.map((v) => v.id)));
const artistName = site.artist.name;
const tourPortalDateFmt = new Intl.DateTimeFormat('en-GB', {
  timeZone: 'Europe/Berlin',
  day: 'numeric',
  month: 'short',
});

const menuChannels = site.channels
  .map((channel) => {
    const id =
      'id' in channel && typeof channel.id === 'string'
        ? channel.id
        : channel.label.toLowerCase().replace(/\s+/g, '');
    return {
      id,
      label: channel.label,
      url: 'url' in channel ? channel.url : undefined,
      active: channel.status === 'active' && 'url' in channel,
    };
  })
  .filter((channel) => channel.active && channel.url);
---

<header class="site-nav" data-site-nav>
  <div class="site-nav__bar">
    <a class="site-nav__brand" href="#stage" data-site-nav-home aria-label={artistName}>
      <Image
        class="site-nav__wordmark"
        src={wordmark}
        alt={artistName}
        widths={[320, 640]}
        sizes="(max-width: 1023px) 42vw, 11rem"
        decoding="async"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <nav class="site-nav__primary" aria-label="Primary">
      {
        shopUrl ? (
          <a
            class="site-nav__item"
            href={shopUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-site-nav-shop="external"
          >
            {chrome.shopTitle}
          </a>
        ) : (
          <a
            class="site-nav__item"
            href={withBase('/shop')}
            data-legal-slug="shop"
          >
            {chrome.shopTitle}
          </a>
        )
      }
      <a class="site-nav__item" href={withBase('/tour')} data-legal-slug="tour">
        {chrome.tourTitle}
      </a>
      {
        about && (
          <a class="site-nav__item" href={withBase('/about')} data-legal-slug="about">
            {chrome.aboutTitle}
          </a>
        )
      }
      <a
        class="site-nav__item"
        href={withBase('/discography')}
        data-legal-slug="discography"
      >
        {chrome.discographyTitle}
      </a>
      <a
        class="site-nav__item"
        href={withBase('/legal/imprint')}
        data-legal-slug="imprint"
      >
        {chrome.imprintButton}
      </a>
      <a
        class="site-nav__item"
        href={withBase('/legal/privacy')}
        data-legal-slug="privacy"
      >
        {chrome.privacyButton}
      </a>
    </nav>

    <button
      type="button"
      class="site-nav__menu-btn"
      data-site-nav-menu-toggle
      aria-expanded="false"
      aria-controls="site-nav-menu"
      aria-label="Open menu"
    >
      <span class="site-nav__menu-btn-bars" aria-hidden="true"></span>
    </button>
  </div>

  <div
    class="site-nav__menu"
    id="site-nav-menu"
    data-site-nav-menu
    hidden
  >
    {/*
      One navigation system: primary destinations use the same row (label + chevron).
      Mobile: primary + legal open a fade-portal content layer (shell stays).
      Legal is a quiet horizontal pair below; socials are a labeled footer.
    */}
    <div class="site-nav__menu-body" data-site-nav-menu-body>
      <nav class="site-nav__menu-list" aria-label="Primary">
        {
          shopUrl ? (
            <a
              class="site-nav__menu-item"
              href={shopUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-site-nav-shop="external"
              data-site-nav-menu-close
              style="--nav-stagger: 0"
            >
              <span class="site-nav__menu-item-label">{chrome.shopTitle}</span>
              <span class="site-nav__menu-item-chevron" aria-hidden="true"></span>
            </a>
          ) : (
            <a
              class="site-nav__menu-item"
              href={withBase('/shop')}
              data-site-nav-portal="shop"
              style="--nav-stagger: 0"
            >
              <span class="site-nav__menu-item-label">{chrome.shopTitle}</span>
              <span class="site-nav__menu-item-chevron" aria-hidden="true"></span>
            </a>
          )
        }

        <a
          class="site-nav__menu-item"
          href={withBase('/tour')}
          data-site-nav-portal="tour"
          style="--nav-stagger: 1"
        >
          <span class="site-nav__menu-item-label">{chrome.tourTitle}</span>
          <span class="site-nav__menu-item-chevron" aria-hidden="true"></span>
        </a>

        {
          about && (
            <a
              class="site-nav__menu-item"
              href={withBase('/about')}
              data-site-nav-portal="about"
              style="--nav-stagger: 2"
            >
              <span class="site-nav__menu-item-label">{chrome.aboutTitle}</span>
              <span class="site-nav__menu-item-chevron" aria-hidden="true"></span>
            </a>
          )
        }
        <a
          class="site-nav__menu-item"
          href={withBase('/discography')}
          data-site-nav-portal="discography"
          style="--nav-stagger: 3"
        >
          <span class="site-nav__menu-item-label">{chrome.discographyTitle}</span>
          <span class="site-nav__menu-item-chevron" aria-hidden="true"></span>
        </a>
      </nav>

      {/* Quiet horizontal legal pair — not competing with primary row weight. */}
      <nav class="site-nav__menu-legal" aria-label="Legal" style="--nav-stagger: 4">
        <a
          class="site-nav__menu-legal-item"
          href={withBase('/legal/imprint')}
          data-site-nav-portal="imprint"
        >
          {chrome.imprintButton}
        </a>
        <a
          class="site-nav__menu-legal-item"
          href={withBase('/legal/privacy')}
          data-site-nav-portal="privacy"
        >
          {chrome.privacyButton}
        </a>
      </nav>

      {
        menuChannels.length > 0 && (
          <div class="site-nav__menu-footer" style="--nav-stagger: 5">
            <p class="site-nav__menu-footer-label">{chrome.socialsLabel}</p>
            <ul class="site-nav__menu-channels" aria-label={chrome.socialsLabel}>
              {menuChannels.map((channel) => (
                <li>
                  <a
                    class="site-nav__menu-channel glitch-hit"
                    href={channel.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={channel.label}
                    data-site-nav-menu-close
                  >
                    <ChannelIcon id={channel.id} label={channel.label} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    {/* Fade portal: soft-dissolve content layer over the menu list (mobile only). */}
    <div
      class="site-nav__menu-portal"
      data-site-nav-portal-layer
      hidden
      aria-hidden="true"
    >
      <button
        type="button"
        class="site-nav__menu-portal-back"
        data-site-nav-portal-back
      >
        <span class="site-nav__menu-portal-back-chevron" aria-hidden="true"></span>
        Back
      </button>

      <div class="site-nav__menu-portal-scroll">
        <div
          class="site-nav__menu-portal-panel"
          data-site-nav-portal-panel="tour"
          hidden
        >
          <h2 class="site-nav__menu-portal-title">{chrome.tourTitle}</h2>
          {
            tourYearGroups.length === 0 ? (
              <p class="site-nav__menu-portal-empty">{chrome.emptyShows}</p>
            ) : (
              <div class="site-nav__menu-portal-tour" aria-label={chrome.tourTitle}>
                {tourYearGroups.map(({ year, shows: yearShows }) => (
                  <section
                    class="site-nav__menu-portal-year"
                    aria-labelledby={`site-nav-tour-year-${year}`}
                  >
                    <h3
                      class="site-nav__menu-portal-year-label"
                      id={`site-nav-tour-year-${year}`}
                    >
                      {year}
                    </h3>
                    <ul class="site-nav__menu-portal-dates">
                      {yearShows.map((show) => {
                        const dateLabel = tourPortalDateFmt.format(show.date);
                        const locality = formatShowLocality(show.city, show.country);
                        const dateAttrs = {
                          class: 'site-nav__menu-portal-date',
                          datetime: show.date.toISOString().slice(0, 10),
                        };
                        const eventNode = show.eventUrl ? (
                          <a
                            class="site-nav__menu-portal-date-event site-nav__menu-portal-date-event--link"
                            href={show.eventUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {show.title}
                          </a>
                        ) : (
                          <span class="site-nav__menu-portal-date-event">{show.title}</span>
                        );
                        const venueNode = show.venueUrl ? (
                          <a
                            class="site-nav__menu-portal-date-venue"
                            href={show.venueUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {show.venue}
                          </a>
                        ) : (
                          <span>{show.venue}</span>
                        );
                        const ticketNode = show.ticketUrl ? (
                          <a
                            class="site-nav__menu-portal-date-ticket"
                            href={show.ticketUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`${show.title} — ${chrome.ticketLabel}`}
                          >
                            <HudIcon token="ticket" />
                          </a>
                        ) : null;
                        return (
                          <li>
                            <div class="site-nav__menu-portal-date-row">
                              <div class="site-nav__menu-portal-date-when">
                                <time {...dateAttrs}>{dateLabel}</time>
                                <p class="site-nav__menu-portal-date-locality">{locality}</p>
                              </div>
                              <div class="site-nav__menu-portal-date-event-block">
                                {eventNode}
                                <p class="site-nav__menu-portal-date-place">{venueNode}</p>
                              </div>
                              {ticketNode}
                            </div>
                          </li>
                        );
                      })}
                    </ul>
                  </section>
                ))}
              </div>
            )
          }
        </div>

        {
          AboutContent && (
            <div
              class="site-nav__menu-portal-panel site-nav__menu-portal-panel--prose"
              data-site-nav-portal-panel="about"
              hidden
            >
              <h2 class="site-nav__menu-portal-title">{chrome.aboutTitle}</h2>
              <div class="site-nav__menu-portal-prose">
                <AboutContent />
              </div>
            </div>
          )
        }

        <div
          class="site-nav__menu-portal-panel"
          data-site-nav-portal-panel="discography"
          hidden
        >
          <h2 class="site-nav__menu-portal-title">{chrome.discographyTitle}</h2>
          {
            releases.length === 0 ? (
              <p class="site-nav__menu-portal-empty">{chrome.emptyReleases}</p>
            ) : (
              <ul class="site-nav__menu-portal-releases" aria-label={chrome.discographyTitle}>
                {releases.map((release) => (
                  <li class="site-nav__menu-portal-release">
                    <span class="site-nav__menu-portal-release-title">{release.title}</span>
                    <span class="site-nav__menu-portal-release-meta">
                      {release.year}
                      {release.kind ? ` · ${release.kind}` : ''}
                    </span>
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        {
          !shopUrl && (
            <div
              class="site-nav__menu-portal-panel site-nav__menu-portal-panel--prose"
              data-site-nav-portal-panel="shop"
              hidden
            >
              <h2 class="site-nav__menu-portal-title">{chrome.shopTitle}</h2>
              <p class="site-nav__menu-portal-lead">{chrome.shopComingSoonTitle}</p>
              <p class="site-nav__menu-portal-copy">{chrome.shopComingSoonBody}</p>
            </div>
          )
        }

        {
          legalPanels.map(({ id, title, Content }) => (
            <div
              class="site-nav__menu-portal-panel site-nav__menu-portal-panel--prose"
              data-site-nav-portal-panel={id}
              hidden
            >
              <h2 class="site-nav__menu-portal-title">{title}</h2>
              <div class="site-nav__menu-portal-prose site-nav__menu-portal-prose--legal">
                <Content />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</header>

<script>
  function goHome() {
    // Same exit path as LegalOverlay (Imprint / About / Tour / …).
    const legalExit = document.querySelector<HTMLElement>(
      '[data-legal-panel]:not([hidden]) [data-legal-exit]',
    );
    legalExit?.click();
    const stage = document.querySelector('#stage') ?? document.querySelector('.stage');
    stage?.scrollIntoView({ block: 'start' });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function initSiteNav() {
    const root = document.querySelector<HTMLElement>('[data-site-nav]');
    if (!root) return;

    const menu = root.querySelector<HTMLElement>('[data-site-nav-menu]');
    const menuBtn = root.querySelector<HTMLButtonElement>('[data-site-nav-menu-toggle]');
    const menuBody = root.querySelector<HTMLElement>('[data-site-nav-menu-body]');
    const portalLayer = root.querySelector<HTMLElement>('[data-site-nav-portal-layer]');
    const portalBack = root.querySelector<HTMLButtonElement>('[data-site-nav-portal-back]');
    const portalPanels = Array.from(
      root.querySelectorAll<HTMLElement>('[data-site-nav-portal-panel]'),
    );
    let closeTimer: number | undefined;
    let portalTimer: number | undefined;
    let onCloseTransitionEnd: ((event: TransitionEvent) => void) | undefined;
    let portalTrigger: HTMLElement | null = null;
    let activePortal: string | null = null;

    const prefersReducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const isMobileMenu = () => window.matchMedia('(max-width: 1023px)').matches;

    const clearCloseWait = () => {
      if (closeTimer !== undefined) {
        window.clearTimeout(closeTimer);
        closeTimer = undefined;
      }
      if (onCloseTransitionEnd && menu) {
        menu.removeEventListener('transitionend', onCloseTransitionEnd);
        onCloseTransitionEnd = undefined;
      }
    };

    const clearPortalWait = () => {
      if (portalTimer !== undefined) {
        window.clearTimeout(portalTimer);
        portalTimer = undefined;
      }
    };

    const hideAllPortalPanels = () => {
      portalPanels.forEach((panel) => {
        panel.hidden = true;
      });
    };

    const resetPortalInstant = () => {
      clearPortalWait();
      activePortal = null;
      portalTrigger = null;
      root.classList.remove('is-portal-open', 'is-portal-closing');
      hideAllPortalPanels();
      if (portalLayer) {
        portalLayer.hidden = true;
        portalLayer.setAttribute('aria-hidden', 'true');
      }
      menuBody?.removeAttribute('aria-hidden');
    };

    const setPortalOpen = (slug: string | null, trigger?: HTMLElement | null) => {
      if (!portalLayer || !menuBody) return;

      if (!slug) {
        if (!activePortal && portalLayer.hidden) return;

        root.classList.remove('is-portal-open');
        root.classList.add('is-portal-closing');
        menuBody.removeAttribute('aria-hidden');

        const finishPortalClose = () => {
          clearPortalWait();
          hideAllPortalPanels();
          portalLayer.hidden = true;
          portalLayer.setAttribute('aria-hidden', 'true');
          root.classList.remove('is-portal-closing');
          activePortal = null;
          const restore = portalTrigger;
          portalTrigger = null;
          restore?.focus();
        };

        if (prefersReducedMotion()) {
          finishPortalClose();
          return;
        }

        clearPortalWait();
        portalTimer = window.setTimeout(finishPortalClose, 420);
        return;
      }

      const panel = root.querySelector<HTMLElement>(
        `[data-site-nav-portal-panel="${slug}"]`,
      );
      if (!panel) return;

      clearPortalWait();
      root.classList.remove('is-portal-closing');
      portalTrigger = trigger ?? portalTrigger;
      activePortal = slug;
      hideAllPortalPanels();
      panel.hidden = false;
      portalLayer.hidden = false;
      portalLayer.setAttribute('aria-hidden', 'false');
      menuBody.setAttribute('aria-hidden', 'true');
      // Paint closed portal before dissolving in.
      void portalLayer.offsetWidth;
      root.classList.add('is-portal-open');
      portalBack?.focus();
    };

    const finishClose = () => {
      clearCloseWait();
      if (!menu || !menuBtn) return;
      resetPortalInstant();
      menu.hidden = true;
      menuBtn.focus();
    };

    const setMenuOpen = (open: boolean) => {
      if (!menu || !menuBtn) return;

      if (open) {
        clearCloseWait();
        resetPortalInstant();
        menu.hidden = false;
        // Paint collapsed morph (clip-path circle) before expanding.
        void menu.offsetWidth;
        root.classList.add('is-menu-open');
        document.documentElement.classList.add('site-nav-menu-open');
        menuBtn.setAttribute('aria-expanded', 'true');
        menuBtn.setAttribute('aria-label', 'Close menu');
        const first = menuBody?.querySelector<HTMLElement>('a, button') ??
          menu.querySelector<HTMLElement>('a, button');
        first?.focus();
        return;
      }

      if (!root.classList.contains('is-menu-open') && menu.hidden) return;

      // Drop portal before morph-collapse so reverse stagger reads cleanly.
      resetPortalInstant();
      root.classList.remove('is-menu-open');
      document.documentElement.classList.remove('site-nav-menu-open');
      menuBtn.setAttribute('aria-expanded', 'false');
      menuBtn.setAttribute('aria-label', 'Open menu');

      if (prefersReducedMotion() || menu.hidden) {
        finishClose();
        return;
      }

      clearCloseWait();
      onCloseTransitionEnd = (event: TransitionEvent) => {
        if (event.target !== menu) return;
        if (event.propertyName !== 'clip-path' && event.propertyName !== 'opacity') return;
        finishClose();
      };
      menu.addEventListener('transitionend', onCloseTransitionEnd);
      // Fallback if transitionend never fires (tab backgrounded, etc.).
      closeTimer = window.setTimeout(finishClose, 560);
    };

    root.querySelectorAll<HTMLElement>('[data-site-nav-home]').forEach((el) => {
      el.addEventListener('click', (event) => {
        event.preventDefault();
        setMenuOpen(false);
        goHome();
      });
    });

    menuBtn?.addEventListener('click', () => {
      setMenuOpen(!root.classList.contains('is-menu-open'));
    });

    root.querySelectorAll<HTMLElement>('[data-site-nav-portal]').forEach((el) => {
      el.addEventListener('click', (event) => {
        if (!isMobileMenu() || !root.classList.contains('is-menu-open')) return;
        const slug = el.getAttribute('data-site-nav-portal');
        if (!slug) return;
        event.preventDefault();
        event.stopPropagation();
        setPortalOpen(slug, el);
      });
    });

    portalBack?.addEventListener('click', () => {
      setPortalOpen(null);
    });

    root.querySelectorAll<HTMLElement>('[data-site-nav-menu-close]').forEach((el) => {
      el.addEventListener('click', () => {
        // Close menu after LegalOverlay open handler runs (bubble after capture).
        window.requestAnimationFrame(() => setMenuOpen(false));
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !root.classList.contains('is-menu-open')) return;
      if (activePortal || root.classList.contains('is-portal-open')) {
        event.preventDefault();
        setPortalOpen(null);
        return;
      }
      setMenuOpen(false);
    });

    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches) setMenuOpen(false);
    });
  }

  initSiteNav();
</script>

<style>
  .site-nav {
    pointer-events: auto;
    position: fixed;
    z-index: 8;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    padding: 0.55rem clamp(0.65rem, 2vw, 1.1rem) 0.35rem;
    /* Transparent over stage — no solid black band. */
    background: transparent;
  }

  .site-nav__bar {
    /* Stay above the fullscreen menu so brand + open/close toggle stay usable. */
    position: relative;
    z-index: 10;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding: 0.2rem 0;
    background: transparent;
    border: 0;
  }

  .site-nav__brand {
    display: block;
    line-height: 0;
    flex: 0 1 auto;
    filter: drop-shadow(0 1px 10px color-mix(in srgb, #000 55%, transparent));
  }

  .site-nav__wordmark {
    display: block;
    width: min(11rem, 42vw);
    height: auto;
  }

  .site-nav__primary {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.2rem 0.95rem;
    font-family: var(--font-display);
    font-size: clamp(0.72rem, 1.5vw, 0.88rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .site-nav__item {
    color: color-mix(in srgb, #fff 88%, transparent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    text-shadow: 0 1px 12px color-mix(in srgb, #000 70%, transparent);
  }

  .site-nav__item:hover,
  .site-nav__item:focus-visible {
    color: #fff;
    border-bottom-color: color-mix(in srgb, var(--color-accent-alt, #c8ff4a) 70%, transparent);
    outline: none;
  }

  .site-nav__menu-btn {
    appearance: none;
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    cursor: pointer;
    flex: 0 0 auto;
    filter: drop-shadow(0 1px 8px color-mix(in srgb, #000 60%, transparent));
  }

  .site-nav__menu-btn-bars,
  .site-nav__menu-btn-bars::before,
  .site-nav__menu-btn-bars::after {
    display: block;
    width: 1.35rem;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition:
      transform 200ms ease,
      opacity 200ms ease;
  }

  .site-nav__menu-btn-bars {
    position: relative;
  }

  .site-nav__menu-btn-bars::before,
  .site-nav__menu-btn-bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .site-nav__menu-btn-bars::before {
    top: -0.4rem;
  }

  .site-nav__menu-btn-bars::after {
    top: 0.4rem;
  }

  .site-nav.is-menu-open .site-nav__menu-btn-bars {
    background: transparent;
